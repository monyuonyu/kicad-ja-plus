From 94c5f9654c4bce52f22e35a4791d4fb9477a5f25 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Wed, 30 Sep 2026 15:10:08 +0900
Subject: [PATCH] AI chat: optional auto-approve (off by default, not saved;
 the code that ran stays in the chat)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pcbnew/widgets/panel_ai_chat.cpp | 64 +++++++++++++++++++++++++++++++-
 pcbnew/widgets/panel_ai_chat.h   |  4 ++
 2 files changed, 66 insertions(+), 2 deletions(-)

diff --git a/pcbnew/widgets/panel_ai_chat.cpp b/pcbnew/widgets/panel_ai_chat.cpp
index aa07a286..7f4c3417 100644
--- a/pcbnew/widgets/panel_ai_chat.cpp
+++ b/pcbnew/widgets/panel_ai_chat.cpp
@@ -32,6 +32,7 @@
 #include <nlohmann/json.hpp>
 
 #include <wx/button.h>
+#include <wx/checkbox.h>
 #include <wx/dialog.h>
 #include <wx/filename.h>
 #include <wx/stdpaths.h>
@@ -131,9 +132,12 @@ public:
         wxBoxSizer* buttons = new wxBoxSizer( wxHORIZONTAL );
         buttons->AddStretchSpacer();
         wxButton* no = new wxButton( this, wxID_CANCEL, J( "やめる" ) );
+        wxButton* always = new wxButton( this, wxID_APPLY, J( "実行して、以後はたずねない" ) );
         wxButton* yes = new wxButton( this, wxID_OK, J( "実行する" ) );
         buttons->Add( no, 0, wxRIGHT, 8 );
+        buttons->Add( always, 0, wxRIGHT, 8 );
         buttons->Add( yes, 0 );
+        always->Bind( wxEVT_BUTTON, [this]( wxCommandEvent& ) { EndModal( wxID_APPLY ); } );
         sizer->Add( buttons, 0, wxALL | wxEXPAND, 8 );
 
         // 既定のボタンは「やめる」（Enter の押し間違いで実行しない）
@@ -180,11 +184,16 @@ PANEL_AI_CHAT::PANEL_AI_CHAT( wxWindow* aParent, PCB_EDIT_FRAME* aFrame ) :
     buttons->Add( m_sendButton, 0 );
     sizer->Add( buttons, 0, wxEXPAND | wxALL, 2 );
 
+    // 自動で実行（承認を省く）。保存しない: KiCad を開き直すと、毎回たずねる形に戻る
+    m_autoApprove = new wxCheckBox( this, wxID_ANY, J( "AI のコードをたずねずに実行する（KiCad を閉じるまで）" ) );
+    sizer->Add( m_autoApprove, 0, wxEXPAND | wxALL, 4 );
+
     SetSizer( sizer );
 
     m_sendButton->Bind( wxEVT_BUTTON, &PANEL_AI_CHAT::onSend, this );
     m_stopButton->Bind( wxEVT_BUTTON, &PANEL_AI_CHAT::onStop, this );
     m_resetButton->Bind( wxEVT_BUTTON, &PANEL_AI_CHAT::onReset, this );
+    m_autoApprove->Bind( wxEVT_CHECKBOX, &PANEL_AI_CHAT::onAutoApprove, this );
     m_input->Bind( wxEVT_KEY_DOWN, &PANEL_AI_CHAT::onInputKey, this );
     Bind( wxEVT_TIMER, &PANEL_AI_CHAT::onTimer, this );
 
@@ -194,6 +203,35 @@ PANEL_AI_CHAT::PANEL_AI_CHAT( wxWindow* aParent, PCB_EDIT_FRAME* aFrame ) :
 }
 
 
+bool PANEL_AI_CHAT::confirmAutoApprove()
+{
+    int answer = wxMessageBox( J( "AI のコードを、あなたに見せずに実行します。基板の変更は「元に戻す」で戻せますが、"
+                                  "コードは KiCad の外のこと（ファイルを消すなど）もできます。"
+                                  "実行したコードは、このチャットに残します。\n\n"
+                                  "KiCad を閉じるまで続きます。有効にしますか？" ),
+                               J( "たずねずに実行" ), wxYES_NO | wxNO_DEFAULT | wxICON_WARNING, m_frame );
+    return answer == wxYES;
+}
+
+
+void PANEL_AI_CHAT::onAutoApprove( wxCommandEvent& aEvent )
+{
+    if( !m_autoApprove->GetValue() )
+    {
+        append( ROLE::INFO, J( "AI のコードは、また実行の前に見せてたずねます。" ) );
+        return;
+    }
+
+    if( !confirmAutoApprove() )
+    {
+        m_autoApprove->SetValue( false );
+        return;
+    }
+
+    append( ROLE::INFO, J( "AI のコードを、たずねずに実行します。またたずねるようにするには、チェックを外してください。" ) );
+}
+
+
 PANEL_AI_CHAT::~PANEL_AI_CHAT()
 {
     // 準備が走っていたら、通知だけ外す（準備そのものは最後まで走らせ、wx が後片付けする）
@@ -747,8 +785,30 @@ void PANEL_AI_CHAT::askApproval( int aId, const wxString& aDescription, const wx
     // たずねている間は読むのを止める（ダイアログの中で次の行を処理して入れ子にならないように）
     m_timer.Stop();
 
-    DIALOG_AI_APPROVE dlg( m_frame, aDescription, aCode );
-    bool              ok = dlg.ShowModal() == wxID_OK;
+    bool ok = false;
+
+    if( m_autoApprove->GetValue() )
+    {
+        // たずねずに実行する。何を実行したかは、チャットに残す
+        ok = true;
+        append( ROLE::TOOL, wxString::Format( J( "たずねずに実行: %s\n%s" ), aDescription, aCode ) );
+    }
+    else
+    {
+        DIALOG_AI_APPROVE dlg( m_frame, aDescription, aCode );
+        int               ret = dlg.ShowModal();
+
+        ok = ret == wxID_OK || ret == wxID_APPLY;
+
+        if( ret == wxID_APPLY )
+        {
+            if( confirmAutoApprove() )
+            {
+                m_autoApprove->SetValue( true );
+                append( ROLE::INFO, J( "AI のコードを、たずねずに実行します。またたずねるようにするには、チェックを外してください。" ) );
+            }
+        }
+    }
 
     if( m_process )
         m_timer.Start( 100 );
diff --git a/pcbnew/widgets/panel_ai_chat.h b/pcbnew/widgets/panel_ai_chat.h
index 33b51eeb..edebdcf2 100644
--- a/pcbnew/widgets/panel_ai_chat.h
+++ b/pcbnew/widgets/panel_ai_chat.h
@@ -29,6 +29,7 @@ class wxProcess;
 class wxProcessEvent;
 class wxTextCtrl;
 class wxButton;
+class wxCheckBox;
 class wxStaticText;
 
 /**
@@ -62,6 +63,8 @@ private:
     void handleLine( const std::string& aLine );
     void askApproval( int aId, const wxString& aDescription, const wxString& aCode );
     void askApiKey();
+    bool confirmAutoApprove();
+    void onAutoApprove( wxCommandEvent& aEvent );
     void runSetup();
     void onSetupEnd( wxProcessEvent& aEvent );
     wxString venvDir() const;
@@ -83,6 +86,7 @@ private:
     wxButton*       m_stopButton;
     wxButton*       m_resetButton;
     wxStaticText*   m_status;
+    wxCheckBox*     m_autoApprove = nullptr;   ///< たずねずに実行する（保存しない）
 
     wxProcess*      m_process;
     long            m_pid;
-- 
2.43.0

