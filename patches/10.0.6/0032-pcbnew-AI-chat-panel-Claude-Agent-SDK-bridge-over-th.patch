+void PANEL_AI_CHAT::setBusy( bool aBusy )
+{
+    m_busy = aBusy;
+    m_sendButton->Enable( !aBusy );
+    m_stopButton->Enable( aBusy );
+    m_status->SetLabel( aBusy ? J( "AI が考えています…" ) : wxString() );
+}
