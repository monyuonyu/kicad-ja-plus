+
+bool PANEL_AI_CHAT::checkPrerequisites()
+{
+#ifndef KICAD_IPC_API
+    append( ROLE::ERROR, J( "この KiCad は IPC API なしでビルドされているので、AI チャットは使えません。" ) );
+    return false;
+#else
+    if( !Pgm().GetApiServer().Running() )
+    {
+        int answer = wxMessageBox( J( "AI が基板を読んだり直したりするには、KiCad の API サーバー"
+                                      "（設定 → プラグイン → KiCad API を有効にする）が要ります。\n\n"
+                                      "有効にしますか？" ),
+                                   J( "AI チャット" ), wxYES_NO | wxICON_QUESTION, m_frame );
+
+        if( answer != wxYES )
+        {
+            append( ROLE::ERROR, J( "API サーバーが止まっているので、AI は基板に触れません。" ) );
+            return false;
+        }
+
+        COMMON_SETTINGS* settings = Pgm().GetCommonSettings();
+        settings->m_Api.enable_server = true;
+        settings->SaveToFile( Pgm().GetSettingsManager().GetPathForSettingsFile( settings ) );
+        Pgm().GetApiServer().Start();
+
+        if( !Pgm().GetApiServer().Running() )
+        {
+            append( ROLE::ERROR, J( "API サーバーを起動できませんでした。" ) );
+            return false;
+        }
+    }
+
+    if( !wxFileName::FileExists( bridgePath() ) )
+    {
+        append( ROLE::ERROR, wxString::Format( J( "AI の仲介役が見つかりません: %s" ), bridgePath() ) );
+        return false;
+    }
+
+    if( !wxFileName::FileExists( pythonPath() ) )
+    {
+        int answer = wxMessageBox( wxString::Format(
+                                           J( "AI チャットの準備ができていません。\n\n"
+                                              "専用の Python の環境を作り、要るもの（Claude Agent SDK と "
+                                              "kicad-python）をインターネットから入れます。数分かかります。\n\n"
+                                              "場所: %s\n\n準備しますか？" ),
+                                           wxFileName( pythonPath() ).GetPath() ),
+                                   J( "AI チャット" ), wxYES_NO | wxICON_QUESTION, m_frame );
+
+        if( answer == wxYES )
+            runSetup();
+        else
+            append( ROLE::ERROR, wxString::Format( J( "準備するには、次を実行してください:\n"
+                                                      "python3 \"%s\"" ),
+                                                   wxFileName( bridgePath() ).GetPathWithSep()
+                                                           + wxS( "setup_ai.py" ) ) );
+        return false;
+    }
+
+    return true;
+#endif
+}
