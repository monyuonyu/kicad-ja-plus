+    m_stopButton = new wxButton( this, wxID_ANY, J( "止める" ) );
+    m_sendButton = new wxButton( this, wxID_ANY, J( "送信" ) );
+    buttons->Add( m_resetButton, 0, wxRIGHT, 4 );
