+"""KiCad の AI チャットの仲介役（KiCad の外の Python で動く。claude-agent-sdk と kicad-python が要る）
+
+KiCad（PANEL_AI_CHAT）とは標準入出力の JSON 行でやり取りする。
+  KiCad → ここ: {"type": "user", "text"} / {"type": "approval", "id", "ok"} /
+                {"type": "interrupt"} / {"type": "reset"}
+  ここ → KiCad: {"type": "ready"} / {"type": "text", "text"} / {"type": "tool", "text"} /
+                {"type": "approve", "id", "code", "description"} / {"type": "done", "error"} /
+                {"type": "need_key"} / {"type": "fatal", "text"}
+AI の道具は、ここから KiCad の IPC API（kipy）で開いている基板を見て、直す。
+基板を変えるコードだけは、実行する前に KiCad の画面で利用者の承認を取る（毎回）。
+"""
+
+import argparse
+import asyncio
+import base64
+import collections
+import itertools
+import json
+import os
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+# API キーの置き場所: OS の鍵保管庫（Windows の資格情報マネージャー・macOS のキーチェーン・Linux の Secret Service）。
+# 使えない環境（鍵保管庫の無い Linux など）では、本人だけが読めるファイル
+KEY_SERVICE = "kicad-ja-local"
+KEY_USER = "anthropic-api-key"
+
+
+def _key_file(datadir):
+    return os.path.join(datadir, "ai-api-key")
+
+
+def store_key(key, datadir):
+    try:
+        import keyring
+        keyring.set_password(KEY_SERVICE, KEY_USER, key)
+        return "keyring"
+    except Exception:
+        path = _key_file(datadir)
+        os.makedirs(datadir, exist_ok=True)
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+        with os.fdopen(fd, "w") as f:
+            f.write(key)
+        return "file"
+
+
+def load_key(datadir):
+    try:
+        import keyring
+        k = keyring.get_password(KEY_SERVICE, KEY_USER)
+        if k:
+            return k
+    except Exception:
+        pass
+    try:
+        with open(_key_file(datadir)) as f:
+            return f.read().strip() or None
+    except OSError:
+        return None
+
+
+def delete_key(datadir):
+    try:
+        import keyring
+        keyring.delete_password(KEY_SERVICE, KEY_USER)
+    except Exception:
+        pass
+    try:
+        os.remove(_key_file(datadir))
+    except OSError:
+        pass
+
+
+SYSTEM = """あなたは KiCad の基板エディタに組み込まれた設計の助手です。利用者と同じ基板を見ながら、
+調べ、直します。答えは日本語で、短く具体的に。
+答えを出す枠は狭い文字の窓なので、表は使わず、見出し・箇条書き・**太字** だけで書く。
+
+道具（mcp__kicad__*）:
+- get_board: 開いている基板の概要（部品・ネット・配線・ベタ・層）と、今の選択
+- run_python: 開いている基板に Python（kicad-python の kipy）を実行する。実行の前に利用者が承認する。
+  使える名前: kicad（KiCad）、board（開いている基板）、from_mm / to_mm、Vector2、kipy。
+  変更は board.update_items / create_items / remove_items で行う。1 回の実行が「元に戻す」の 1 段になり、
+  エラーが起きたらその回の変更は取り消される。print の出力と、最後の式の値が返る。
+  変更は実行が終わった後にまとめて基板へ反映される。実行の中で board から読み直しても、変更の前の値が返る
+  （確かめるのは次の get_board か run_python で）
+- check: 基板の写しを保存して DRC をかけ、違反と未配線の一覧を返す（開いている基板は変えない）
+- render: 基板の写しを画像にして見る（上・下・斜め）
+
+進め方:
+- 変える前に get_board で今の状態を見る。部品はリファレンス（R1 など）で指す
+- 長さは mm で考え、kipy には from_mm で渡す（内部の単位は nm）
+- 変えたら check と render で確かめてから「できた」と言う。確かめていないことは、確かめていないと言う
+- 利用者のファイルを保存・上書き・削除するのは、頼まれたときだけ
+- 何をしたかは、利用者が「元に戻す」で戻せることも含めて一言で伝える"""
+
+TOOLS = [
+    ("get_board", "開いている基板の概要（部品・ネット・配線・ベタ・層）と、今の選択を返す", {}, []),
+    ("run_python", "開いている基板に Python（kipy）を実行する。利用者の承認の後に実行され、1 回が元に戻すの 1 段になる"
+                   "（エラーなら取り消す）。print の出力と、最後の式の値を返す",
+     {"code": {"type": "string", "description": "実行する Python"},
+      "description": {"type": "string", "description": "何をするか（承認の画面と元に戻すの一覧に出る。日本語で短く）"}},
+     ["code", "description"]),
+    ("check", "基板の写しに DRC をかけ、違反と未配線の一覧を返す",
+     {"refill_zones": {"type": "boolean", "description": "ベタを塗り直してから調べる（既定は true）"}}, []),
+    ("render", "基板の写しを画像にして返す",
+     {"side": {"type": "string", "enum": ["top", "bottom", "iso"], "description": "向き（既定は top）"}}, []),
+]
+
+
+def cli_env():
+    """kicad-cli を呼ぶときの環境。KiCad をビルドした場所から動かしているときの印は外す
+    （引き継ぐと、入れてある kicad-cli が自分の部品をビルドの場所で探して失敗する）"""
+    env = dict(os.environ)
+    env.pop("KICAD_RUN_FROM_BUILD_DIR", None)
+    return env
+
+
+def text(s, error=False):
+    return {"content": [{"type": "text", "text": s}], "is_error": error}
+
+
+class Board:
+    """kipy で開いている基板を読む（読むだけの道具はここで、承認なしに）"""
+
+    def __init__(self):
+        from kipy import KiCad
+        self.kicad = KiCad(client_name="kicad-ai", timeout_ms=20000)
+
+    def board(self):
+        return self.kicad.get_board()
+
+    def summary(self):
+        from kipy.util import to_mm
+        b = self.board()
+        fps = b.get_footprints()
+        out = {"file": b.name, "copper_layers": b.get_copper_layer_count(),
+               "footprints": len(fps), "nets": len(b.get_nets()), "tracks": len(b.get_tracks()),
+               "vias": len(b.get_vias()), "zones": [], "parts": [], "selection": []}
+        for z in b.get_zones():
+            out["zones"].append({"name": getattr(z, "name", ""), "net": getattr(getattr(z, "net", None), "name", ""),
+                                 "layers": [b.get_layer_name(l) for l in getattr(z, "layers", [])]})
+        for fp in fps[:300]:
+            ref = fp.reference_field.text.value
+            val = fp.value_field.text.value
+            out["parts"].append({"ref": ref, "value": val, "footprint": str(fp.definition.id),
+                                 "x_mm": round(to_mm(fp.position.x), 3), "y_mm": round(to_mm(fp.position.y), 3),
+                                 "angle": round(fp.orientation.degrees, 1), "layer": b.get_layer_name(fp.layer)})
+        if len(fps) > 300:
+            out["parts_truncated"] = len(fps) - 300
+        kinds = collections.Counter()
+        for it in b.get_selection():
+            name = type(it).__name__
+            ref = getattr(getattr(getattr(it, "reference_field", None), "text", None), "value", None)
+            if ref and len(out["selection"]) < 50:
+                out["selection"].append({"type": name, "ref": ref})
+            else:
+                kinds[name] += 1
+        if kinds:
+            out["selection_counts"] = dict(kinds)
+        return out
+
+    def save_copy(self, workdir):
+        """開いている基板の写しを作業場所に保存する（元の基板とファイルは変えない）"""
+        b = self.board()
+        os.makedirs(workdir, exist_ok=True)
+        d = tempfile.mkdtemp(prefix="copy_", dir=workdir)
+        name = os.path.basename(b.name) or "board.kicad_pcb"
+        path = os.path.join(d, name)
+        b.save_as(path, overwrite=True, include_project=True)
+        return path
+
+    def cli(self):
+        if os.environ.get("KICAD_AI_CLI"):  # ビルドした場所から動かすときなど
+            return os.environ["KICAD_AI_CLI"]
+        try:
+            return self.kicad.get_kicad_binary_path("kicad-cli")
+        except Exception:
+            return "kicad-cli"
+
+
+class Bridge:
+    def __init__(self, args):
+        self.args = args
+        self.ids = itertools.count(1)
+        self.pending = {}
+        self.inbox = asyncio.Queue()
+        self.client = None
+        self.busy = False
+        self._board = None
+
+    def send(self, **msg):
+        sys.stdout.write(json.dumps(msg, ensure_ascii=False) + "\n")
+        sys.stdout.flush()
+
+    def board(self):
+        if self._board is None:
+            self._board = Board()
+        return self._board
+
+    # --- 道具 ---
+
+    async def t_get_board(self, args):
+        self.send(type="tool", text="基板を見ています")
+        s = await asyncio.to_thread(self.board().summary)
+        return text(json.dumps(s, ensure_ascii=False))
+
+    async def t_run_python(self, args):
+        code, desc = args.get("code", ""), args.get("description", "") or "AI の変更"
+        n = next(self.ids)
+        fut = asyncio.get_running_loop().create_future()
+        self.pending[n] = fut
+        self.send(type="approve", id=n, code=code, description=desc)
+        res = await fut
+        if not res.get("ok"):
+            return text("利用者が実行を承認しなかった" + (f"（{res['why']}）" if res.get("why") else ""), True)
+        self.send(type="tool", text=f"実行しています: {desc}")
+        env = dict(os.environ, KICAD_AI_DESCRIPTION=desc)
+        try:
+            p = await asyncio.to_thread(
+                subprocess.run, [sys.executable, os.path.join(HERE, "run_code.py")], input=code,
+                capture_output=True, text=True, encoding="utf-8", timeout=self.args.code_timeout, env=env)
+        except subprocess.TimeoutExpired:
+            return text(f"{self.args.code_timeout} 秒で終わらなかったので止めた（変更は取り消した）", True)
+        out = (p.stdout or "") + (("\n[stderr]\n" + p.stderr) if p.stderr.strip() else "")
+        return text(out.strip()[-20000:] or "(出力なし)", p.returncode != 0)
+
+    async def t_check(self, args):
+        self.send(type="tool", text="DRC をかけています")
+        b = self.board()
+        try:
+            path = await asyncio.to_thread(b.save_copy, self.args.workdir)
+        except Exception as e:
+            return text(f"基板の写しを保存できない: {e}", True)
+        rpt = path + ".drc.json"
+        cmd = [b.cli(), "pcb", "drc", "--format", "json", "--severity-error", "--severity-warning", "-o", rpt]
+        if args.get("refill_zones", True):
+            cmd.append("--refill-zones")
+        cmd.append(path)
+        p = await asyncio.to_thread(subprocess.run, cmd, capture_output=True, text=True, env=cli_env())
+        if not os.path.exists(rpt):
+            return text(f"DRC を実行できない: {p.stderr or p.stdout}", True)
+        with open(rpt, encoding="utf-8") as f:
+            d = json.load(f)
+        vs = d.get("violations", [])
+        un = d.get("unconnected_items", [])
+        lines = [f"違反 {len(vs)} 件、未配線 {len(un)} 件、回路図との食い違い {len(d.get('schematic_parity', []))} 件"]
+        for v in (vs + un)[:60]:
+            items = " / ".join(i.get("description", "") for i in v.get("items", [])[:2])
+            pos = v.get("pos") or (v.get("items") or [{}])[0].get("pos")
+            where = f" @({pos['x']:.2f}, {pos['y']:.2f})" if pos else ""
+            lines.append(f"- [{v.get('severity', '')}] {v.get('type', '')}: {v.get('description', '')}{where} — {items}")
+        if len(vs) + len(un) > 60:
+            lines.append(f"…ほか {len(vs) + len(un) - 60} 件")
+        return text("\n".join(lines))
+
+    async def t_render(self, args):
+        side = args.get("side") or "top"
+        self.send(type="tool", text="基板を画像にしています")
+        b = self.board()
+        try:
+            path = await asyncio.to_thread(b.save_copy, self.args.workdir)
+        except Exception as e:
+            return text(f"基板の写しを保存できない: {e}", True)
+        png = path + f".{side}.png"
+        cmd = [b.cli(), "pcb", "render", "-o", png, "-w", "1200", "-h", "900", "--quality", "basic"]
+        if side == "iso":
+            cmd += ["--side", "top", "--rotate", "-45,0,45", "--perspective"]
+        else:
+            cmd += ["--side", side]
+        p = await asyncio.to_thread(subprocess.run, cmd + [path], capture_output=True, text=True, env=cli_env())
+        if not os.path.exists(png):
+            return text(f"画像にできない: {p.stderr or p.stdout}", True)
+        with open(png, "rb") as f:
+            data = base64.b64encode(f.read()).decode()
+        return {"content": [{"type": "image", "data": data, "mimeType": "image/png"}], "is_error": False}
+
+    def make_server(self):
+        def handler(name):
+            fn = getattr(self, "t_" + name)
+
+            async def run(args):
+                try:
+                    return await fn(args)
+                except Exception as e:  # KiCad が応えない・基板が開いていない など
+                    return text(f"{type(e).__name__}: {e}", True)
+            return run
+        tools = [tool(n, d, {"type": "object", "properties": p, "required": r, "additionalProperties": False})(handler(n))
+                 for n, d, p, r in TOOLS]
+        return create_sdk_mcp_server("kicad", tools=tools)
+
+    def options(self):
+        env = {"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1", "ENABLE_CLAUDEAI_MCP_SERVERS": "false"}
+        if self.api_key:
+            env["ANTHROPIC_API_KEY"] = self.api_key
+        os.makedirs(self.args.workdir, exist_ok=True)
+        return ClaudeAgentOptions(
+            model=self.args.model, system_prompt=SYSTEM,
+            cli_path=self.args.claude or None,
+            tools=[], allowed_tools=["mcp__kicad__*"], mcp_servers={"kicad": self.make_server()},
+            strict_mcp_config=True, setting_sources=[], cwd=self.args.workdir, max_turns=40, env=env)
+
+    # --- KiCad とのやり取り ---
+
+    def _stdin_thread(self, loop):
+        # Windows でも動くように、標準入力はスレッドで読む（asyncio のパイプは Windows で使えない）
+        for line in sys.stdin:
+            try:
+                msg = json.loads(line)
+            except ValueError:
+                continue
+            asyncio.run_coroutine_threadsafe(self.dispatch(msg), loop)
+        # KiCad が閉じた（落ちた）: 承認待ちも終わらせて、走っている回を止める
+        asyncio.run_coroutine_threadsafe(self.shutdown_pending("KiCad が終わった"), loop)
+        asyncio.run_coroutine_threadsafe(self.inbox.put(None), loop)
+
+    async def shutdown_pending(self, why):
+        for fut in list(self.pending.values()):
+            if not fut.done():
+                fut.set_result({"ok": False, "why": why})
+        self.pending.clear()
+        if self.client is not None and self.busy:
+            try:
+                await self.client.interrupt()
+            except Exception:
+                pass
+
+    async def dispatch(self, msg):
+        if msg.get("type") == "approval":
+            fut = self.pending.pop(msg.get("id"), None)
+            if fut and not fut.done():
+                fut.set_result(msg)
+        elif msg.get("type") == "interrupt":
+            await self.shutdown_pending("止めた")
+        elif msg.get("type") == "reset":
+            await self.shutdown_pending("会話を始め直した")
+            await self.inbox.put(msg)
+        else:
+            await self.inbox.put(msg)
+
+    async def turn(self, s):
+        self.busy = True
+        error = None
+        try:
+            await self.client.query(s)
+            async for m in self.client.receive_response():
+                if isinstance(m, AssistantMessage):
+                    for b in m.content:
+                        if isinstance(b, TextBlock) and b.text.strip():
+                            self.send(type="text", text=b.text)
+                elif isinstance(m, ResultMessage) and m.is_error:
+                    error = m.subtype or "error"
+        except Exception as e:
+            error = "%s: %s" % (type(e).__name__, e)
+        finally:
+            self.busy = False
+        self.send(type="done", error=error)
+
+    async def main(self):
+        # 認証: 利用者自身の API キー。--local-login のときだけ、この PC の claude のログインを使う（本人の利用に限る）
+        self.api_key = None if self.args.local_login else load_key(self.args.datadir)
+        if not self.args.local_login and not self.api_key:
+            self.send(type="need_key")
+            return
+        import threading
+        threading.Thread(target=self._stdin_thread, args=(asyncio.get_running_loop(),), daemon=True).start()
+        while True:
+            self.client = ClaudeSDKClient(options=self.options())
+            try:
+                await self.client.connect()
+            except Exception as e:
+                self.send(type="fatal", text="Claude に接続できない: %s" % e)
+                return
+            self.send(type="ready")
+            reset = False
+            while not reset:
+                msg = await self.inbox.get()
+                if msg is None:
+                    await self.client.disconnect()
+                    return
+                if msg.get("type") == "reset":
+                    reset = True
+                elif msg.get("type") == "user":
+                    await self.turn(msg["text"])
+            await self.client.disconnect()
+
+
+def default_datadir():
+    if sys.platform == "win32":
+        return os.path.join(os.environ.get("LOCALAPPDATA", os.path.expanduser("~")), "kicad-ja-local")
+    return os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "kicad-ja-local")
+
+
+def main():
+    # KiCad とのやり取りは UTF-8 の JSON 行（Windows のパイプは既定でロケールの符号 cp932 などになる）
+    for stream in (sys.stdin, sys.stdout, sys.stderr):
+        try:
+            stream.reconfigure(encoding="utf-8")
+        except Exception:
+            pass
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--datadir", default=default_datadir())
+    ap.add_argument("--local-login", action="store_true", help="API キーではなく、この PC の claude のログインを使う")
+    ap.add_argument("--store-key", action="store_true", help="標準入力の API キーを保管して終わる")
