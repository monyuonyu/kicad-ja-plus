+"""AI が書いたコードを、開いている基板に 1 回の変更として当てる（bridge.py が別プロセスで呼ぶ）
+
+標準入力: 実行する Python。環境変数 KICAD_AI_DESCRIPTION: 元に戻すの一覧に出す名前。
+使える名前: kicad, board, from_mm, to_mm, Vector2, kipy
+エラーが起きたら、その回の変更は取り消す（drop_commit）。終了コード 0 = 成功、1 = エラー
+"""
+
+import ast
+import os
+import sys
+import traceback
+
+
+def main():
+    for stream in (sys.stdin, sys.stdout, sys.stderr):
+        try:
+            stream.reconfigure(encoding="utf-8")
+        except Exception:
+            pass
+    code = sys.stdin.read()
+    desc = os.environ.get("KICAD_AI_DESCRIPTION") or "AI の変更"
+
+    import kipy
+    from kipy import KiCad
+    from kipy.geometry import Vector2
+    from kipy.util import from_mm, to_mm
+
+    kicad = KiCad(client_name="kicad-ai-code", timeout_ms=60000)
+    board = kicad.get_board()
+    env = {"__name__": "__kicad_ai__", "kicad": kicad, "board": board, "kipy": kipy,
+           "Vector2": Vector2, "from_mm": from_mm, "to_mm": to_mm}
+
+    try:
+        tree = ast.parse(code, "<AI>", "exec")
+    except SyntaxError:
+        traceback.print_exc(limit=0)
+        return 1
+    # 最後が式なら、その値も返す（対話の画面と同じ）
+    last = None
+    if tree.body and isinstance(tree.body[-1], ast.Expr):
+        last = ast.Expression(tree.body.pop().value)
+
+    # 基板を変える呼び出しを数える（変えなかった回は、空の「元に戻す」の段を作らない）
+    changes = []
+    for name in ("update_items", "create_items", "remove_items", "remove_items_by_id", "flip_items", "flip_items_by_id"):
+        orig = getattr(board, name)
+
+        def counted(*a, _orig=orig, _name=name, **k):
+            changes.append(_name)
+            return _orig(*a, **k)
+        setattr(board, name, counted)
+
+    commit = board.begin_commit()
+    try:
+        exec(compile(tree, "<AI>", "exec"), env)
+        value = eval(compile(last, "<AI>", "eval"), env) if last is not None else None
+    except BaseException:
+        board.drop_commit(commit)
+        traceback.print_exc()
+        print("（エラーのため、この回の変更は取り消した）")
+        return 1
+    if value is not None:
+        print(repr(value))
+    if not changes:
+        board.drop_commit(commit)
+        print("（基板は変えていない）")
+        return 0
+    board.push_commit(commit, desc)
+    print(f"（変更 {len(changes)} 回を、実行の後に基板へ反映した。「元に戻す」1 回で戻せる: {desc}。"
+          "実行の中で読み直した値は、反映の前のもの）")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
