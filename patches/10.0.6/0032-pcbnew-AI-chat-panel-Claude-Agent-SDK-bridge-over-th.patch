+
+void PANEL_AI_CHAT::runSetup()
+{
+    // 準備は、システムの Python（3.10 以降）で setup_ai.py を動かす（出力はこの枠に流す）
+    wxString      setup = wxFileName( bridgePath() ).GetPathWithSep() + wxS( "setup_ai.py" );
+    wxArrayString candidates;
+
+    if( !envOr( wxS( "KICAD_AI_SETUP_PYTHON" ) ).IsEmpty() )
+        candidates.Add( wxString::Format( wxS( "\"%s\"" ), envOr( wxS( "KICAD_AI_SETUP_PYTHON" ) ) ) );
+
+    if( !Pgm().GetCommonSettings()->m_Api.python_interpreter.IsEmpty() )
+    {
+        candidates.Add( wxString::Format( wxS( "\"%s\"" ),
+                                          Pgm().GetCommonSettings()->m_Api.python_interpreter ) );
+    }
+
+#ifdef __WINDOWS__
+    candidates.Add( wxS( "py -3" ) );
+    candidates.Add( wxS( "python" ) );
+#else
+    candidates.Add( wxS( "python3" ) );
+#endif
+
+    wxString py;
+
+    for( const wxString& c : candidates )
+    {
+        wxArrayString out, err;
+        wxString      check = c + wxS( " -c \"import sys, venv; sys.exit(0 if sys.version_info >= (3, 10) else 1)\"" );
+
+        if( wxExecute( check, out, err, wxEXEC_SYNC | wxEXEC_HIDE_CONSOLE ) == 0 )
+        {
+            py = c;
+            break;
+        }
+    }
+
+    if( py.IsEmpty() )
+    {
+        append( ROLE::ERROR, J( "Python 3.10 以降が見つかりません。python.org から入れてから、"
+                                "もう一度この枠を開いてください。" ) );
+        return;
+    }
+
+    wxString cmd = wxString::Format( wxS( "%s \"%s\"" ), py, setup );
+
+    append( ROLE::INFO, J( "準備しています（数分かかります）…" ) );
+    m_status->SetLabel( J( "準備しています…" ) );
+    wxBusyCursor busy;
+
+    wxArrayString out, err;
+    long          code = wxExecute( cmd, out, err, wxEXEC_SYNC | wxEXEC_HIDE_CONSOLE );
+
+    for( size_t i = out.size() > 5 ? out.size() - 5 : 0; i < out.size(); i++ )
+        append( ROLE::TOOL, out[i] );
+
+    m_status->SetLabel( wxEmptyString );
+
+    if( code != 0 || !wxFileName::FileExists( pythonPath() ) )
+    {
+        wxString tail;
+
+        for( size_t i = err.size() > 10 ? err.size() - 10 : 0; i < err.size(); i++ )
+            tail << err[i] << wxS( "\n" );
+
+        append( ROLE::ERROR, wxString::Format( J( "準備に失敗しました（%s）。\n%s" ), cmd, tail ) );
+        return;
+    }
+
+    append( ROLE::INFO, J( "準備ができました。" ) );
+    startBridge();
+}
+
+
+void PANEL_AI_CHAT::startBridge()
+{
+#ifdef KICAD_IPC_API
+    if( m_process )
+        return;
+
+    wxExecuteEnv env;
+    wxGetEnvMap( &env.env );
+    env.env[wxS( "KICAD_API_SOCKET" )] = Pgm().GetApiServer().SocketPath();
+    env.env[wxS( "KICAD_API_TOKEN" )] = Pgm().GetApiServer().Token();
+    env.env[wxS( "PYTHONIOENCODING" )] = wxS( "utf-8" );
+    env.env[wxS( "PYTHONUNBUFFERED" )] = wxS( "1" );
+
+    wxString cmd = wxString::Format( wxS( "\"%s\" \"%s\" --model %s" ), pythonPath(), bridgePath(),
+                                     envOr( wxS( "KICAD_AI_MODEL" ), wxS( "opus" ) ) );
+
+    // この PC の claude のログインを使う（本人が自分の PC で使うときだけ。配る版の既定は API キー）
+    if( envOr( wxS( "KICAD_AI_LOCAL_LOGIN" ) ) == wxS( "1" ) )
+        cmd << wxS( " --local-login" );
+
+    if( !envOr( wxS( "KICAD_AI_CLAUDE" ) ).IsEmpty() )
+        cmd << wxString::Format( wxS( " --claude \"%s\"" ), envOr( wxS( "KICAD_AI_CLAUDE" ) ) );
+
+    // 親は持たせない: 終わったときの通知はここで受け、後片付け（delete）は wx に任せる
+    m_process = new wxProcess();
+    m_process->Redirect();
+    m_process->Bind( wxEVT_END_PROCESS, &PANEL_AI_CHAT::onProcessEnd, this );
+
+    int flags = wxEXEC_ASYNC | wxEXEC_HIDE_CONSOLE;
+#ifndef __WINDOWS__
+    flags |= wxEXEC_MAKE_GROUP_LEADER;  // 止めるときに、仲介役が起動した claude も一緒に止める
+#endif
+    m_pid = wxExecute( cmd, flags, m_process, &env );
+
+    if( m_pid <= 0 )
+    {
+        append( ROLE::ERROR, wxString::Format( J( "AI の仲介役を起動できませんでした: %s" ), cmd ) );
+        delete m_process;
+        m_process = nullptr;
+        return;
+    }
+
+    m_ready = false;
+    m_outBuf.clear();
+    m_errBuf.clear();
+    m_status->SetLabel( J( "AI に接続しています…" ) );
+    m_timer.Start( 100 );
+#endif
+}
+
+
+void PANEL_AI_CHAT::stopBridge()
+{
+    m_timer.Stop();
+
+    if( !m_process )
+        return;
+
+    // 標準入力を閉じると、仲介役は自分で終わる。残ったら止める
+    m_process->Unbind( wxEVT_END_PROCESS, &PANEL_AI_CHAT::onProcessEnd, this );
+    m_process->CloseOutput();
+
+    if( wxProcess::Exists( m_pid ) )
+        wxProcess::Kill( m_pid, wxSIGTERM, wxKILL_CHILDREN );
+
+    // 終わったら wx が消す（この枠はもう通知を受けない）
+    m_process = nullptr;
+    m_pid = 0;
+    m_ready = false;
+}
+
+
+void PANEL_AI_CHAT::sendJson( const std::string& aLine )
+{
+    if( !m_process || !m_process->GetOutputStream() )
+        return;
+
+    std::string line = aLine + "\n";
+    m_process->GetOutputStream()->Write( line.data(), line.size() );
+}
+
+
+void PANEL_AI_CHAT::onTimer( wxTimerEvent& aEvent )
+{
+    readOutput();
+}
+
+
+void PANEL_AI_CHAT::readOutput()
+{
+    if( !m_process )
+        return;
+
+    auto drain = []( wxInputStream* aStream, std::string& aBuf )
+    {
+        char buf[4096];
+
+        while( aStream && aStream->CanRead() )
+        {
+            aStream->Read( buf, sizeof( buf ) );
+            size_t n = aStream->LastRead();
+
+            if( n == 0 )
+                break;
+
+            aBuf.append( buf, n );
+        }
+    };
+
+    drain( m_process->GetInputStream(), m_outBuf );
+    drain( m_process->GetErrorStream(), m_errBuf );
+
+    // 仲介役の stderr は最後の方だけ残す（落ちたときの説明に使う）
+    if( m_errBuf.size() > 8000 )
+        m_errBuf.erase( 0, m_errBuf.size() - 8000 );
+
+    size_t pos;
+
+    while( m_process && ( pos = m_outBuf.find( '\n' ) ) != std::string::npos )
+    {
+        std::string line = m_outBuf.substr( 0, pos );
+        m_outBuf.erase( 0, pos + 1 );
+
+        if( !line.empty() )
+            handleLine( line );
+    }
+}
+
+
+void PANEL_AI_CHAT::handleLine( const std::string& aLine )
+{
+    nlohmann::json msg = nlohmann::json::parse( aLine, nullptr, false );
+
+    if( msg.is_discarded() || !msg.is_object() )
+        return;
+
+    std::string type = msg.value( "type", "" );
+    auto str = [&]( const char* aKey )
+    {
+        return wxString::FromUTF8( msg.value( aKey, std::string() ) );
+    };
+
+    if( type == "ready" )
+    {
+        m_ready = true;
+        m_status->SetLabel( wxEmptyString );
+
+        if( !m_pending.IsEmpty() )
+        {
+            wxString text = m_pending;
+            m_pending.Clear();
+            sendJson( nlohmann::json( { { "type", "user" }, { "text", text.ToStdString( wxConvUTF8 ) } } ).dump() );
+            setBusy( true );
+        }
+    }
+    else if( type == "text" )
+    {
+        append( ROLE::AI, str( "text" ) );
+    }
+    else if( type == "tool" )
+    {
+        append( ROLE::TOOL, str( "text" ) );
+    }
+    else if( type == "approve" )
+    {
+        askApproval( msg.value( "id", 0 ), str( "description" ), str( "code" ) );
+    }
+    else if( type == "done" )
+    {
+        setBusy( false );
+
+        if( msg.contains( "error" ) && msg["error"].is_string() )
+            append( ROLE::ERROR, wxString::Format( J( "エラー: %s" ), str( "error" ) ) );
+    }
+    else if( type == "need_key" )
+    {
+        stopBridge();
+        askApiKey();
+    }
+    else if( type == "fatal" )
+    {
+        append( ROLE::ERROR, str( "text" ) );
+        setBusy( false );
+    }
+}
+
+
+void PANEL_AI_CHAT::askApproval( int aId, const wxString& aDescription, const wxString& aCode )
+{
+    // たずねている間は読むのを止める（ダイアログの中で次の行を処理して入れ子にならないように）
+    m_timer.Stop();
+
+    DIALOG_AI_APPROVE dlg( m_frame, aDescription, aCode );
+    bool              ok = dlg.ShowModal() == wxID_OK;
+
+    if( m_process )
+        m_timer.Start( 100 );
+
+    if( !ok )
+        append( ROLE::TOOL, wxString::Format( J( "実行しませんでした: %s" ), aDescription ) );
+
+    sendJson( nlohmann::json( { { "type", "approval" }, { "id", aId }, { "ok", ok } } ).dump() );
+}
+
+
+void PANEL_AI_CHAT::askApiKey()
+{
+    wxPasswordEntryDialog dlg( m_frame,
+                               J( "AI には、あなたの Anthropic の API キーを使います。\n"
+                                  "キーは OS の鍵保管庫に保存され、この PC から外へは Anthropic にだけ送られます。\n"
+                                  "（キーは https://console.anthropic.com で作れます）" ),
+                               J( "AI チャット: API キー" ) );
+
+    if( dlg.ShowModal() != wxID_OK || dlg.GetValue().Trim().Trim( false ).IsEmpty() )
+    {
+        append( ROLE::ERROR, J( "API キーが無いので、AI を使えません。" ) );
+        return;
+    }
+
+    // キーはコマンドラインに載せず、標準入力で渡す
+    wxProcess* proc = new wxProcess();  // 終わったら wx が消す
+    proc->Redirect();
+    wxString cmd = wxString::Format( wxS( "\"%s\" \"%s\" --store-key" ), pythonPath(), bridgePath() );
+    long     pid = wxExecute( cmd, wxEXEC_ASYNC | wxEXEC_HIDE_CONSOLE, proc );
+
+    if( pid <= 0 )
+    {
+        delete proc;
+        append( ROLE::ERROR, J( "API キーを保存できませんでした。" ) );
+        return;
+    }
+
+    std::string key = dlg.GetValue().Trim().Trim( false ).ToStdString( wxConvUTF8 );
+    proc->GetOutputStream()->Write( key.data(), key.size() );
+    proc->CloseOutput();
+
+    // 保存が終わるのを待ってから、つなぎ直す
+    wxBusyCursor busy;
+
+    for( int i = 0; i < 100 && wxProcess::Exists( pid ); i++ )
+        wxMilliSleep( 100 );
+
+    append( ROLE::INFO, J( "API キーを保存しました。" ) );
+    startBridge();
+}
+
+
+void PANEL_AI_CHAT::onSend( wxCommandEvent& aEvent )
+{
+    wxString text = m_input->GetValue().Trim().Trim( false );
+
+    if( text.IsEmpty() || m_busy )
+        return;
+
+    m_input->Clear();
+    append( ROLE::USER, text );
+
+    if( !m_process )
+    {
+        if( !checkPrerequisites() )
+            return;
+
+        startBridge();
+    }
+
+    if( !m_ready )
+    {
+        m_pending = text;
+        setBusy( true );
+        return;
+    }
+
+    sendJson( nlohmann::json( { { "type", "user" }, { "text", text.ToStdString( wxConvUTF8 ) } } ).dump() );
+    setBusy( true );
+}
+
+
+void PANEL_AI_CHAT::onStop( wxCommandEvent& aEvent )
+{
+    sendJson( R"({"type": "interrupt"})" );
+    m_status->SetLabel( J( "止めています…" ) );
+}
+
+
+void PANEL_AI_CHAT::onReset( wxCommandEvent& aEvent )
+{
+    m_log->Clear();
+    m_pending.Clear();
+
+    if( m_process )
+    {
+        sendJson( R"({"type": "reset"})" );
+        m_ready = false;
+        m_status->SetLabel( J( "新しい会話を始めています…" ) );
+    }
+
+    setBusy( false );
+}
+
+
+void PANEL_AI_CHAT::onInputKey( wxKeyEvent& aEvent )
+{
+    if( ( aEvent.GetKeyCode() == WXK_RETURN || aEvent.GetKeyCode() == WXK_NUMPAD_ENTER )
+        && !aEvent.ShiftDown() )
+    {
+        wxCommandEvent dummy;
+        onSend( dummy );
+        return;
+    }
+
+    aEvent.Skip();
+}
+
+
+void PANEL_AI_CHAT::onProcessEnd( wxProcessEvent& aEvent )
+{
+    // 残った出力を読んでから片付ける
+    readOutput();
+
+    m_timer.Stop();
+    int code = aEvent.GetExitCode();
+
+    // wxProcess は、この通知を Skip すると wx が消す
+    m_process = nullptr;
+    aEvent.Skip();
+
+    m_pid = 0;
+    m_ready = false;
+    setBusy( false );
+
+    if( code != 0 )
+    {
+        wxString err = wxString::FromUTF8( m_errBuf );
+
+        if( err.length() > 1500 )
+            err = wxS( "…" ) + err.Right( 1500 );
+
+        append( ROLE::ERROR, wxString::Format( J( "AI の仲介役が終了しました（%d）。\n%s" ), code, err ) );
+    }
+}
