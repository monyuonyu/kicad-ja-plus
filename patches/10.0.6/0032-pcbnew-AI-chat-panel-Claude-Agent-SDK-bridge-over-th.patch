+void PANEL_AI_CHAT::append( ROLE aRole, const wxString& aText )
+{
+    wxTextAttr attr;
+    wxString   prefix;
+
+    switch( aRole )
+    {
+    case ROLE::USER:
+        attr.SetTextColour( wxColour( 0x1f, 0x5f, 0xbf ) );
+        attr.SetFontWeight( wxFONTWEIGHT_BOLD );
+        prefix = J( "あなた: " );
+        break;
+    case ROLE::AI:
+        appendMarkdown( aText );
+        return;
+    case ROLE::TOOL:
+        attr.SetTextColour( wxColour( 0x80, 0x80, 0x80 ) );
+        prefix = wxS( "… " );
+        break;
+    case ROLE::INFO:
+        attr.SetTextColour( wxColour( 0x40, 0x80, 0x40 ) );
+        break;
+    case ROLE::ERROR:
+        attr.SetTextColour( wxColour( 0xc0, 0x30, 0x30 ) );
+        break;
+    }
+
+    m_log->SetDefaultStyle( attr );
+    m_log->AppendText( prefix + aText + wxS( "\n\n" ) );
+    m_log->ShowPosition( m_log->GetLastPosition() );
+}
