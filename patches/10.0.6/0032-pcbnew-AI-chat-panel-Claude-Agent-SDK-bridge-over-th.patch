+/**
+ * AI のコードを実行してよいかを、毎回たずねる。
+ * 確認を省く設定は作らない（AI が基板を変えるのは、利用者が中身を見て許したときだけ）。
+ */
+class DIALOG_AI_APPROVE : public wxDialog
+{
+public:
+    DIALOG_AI_APPROVE( wxWindow* aParent, const wxString& aDescription, const wxString& aCode ) :
+            wxDialog( aParent, wxID_ANY, J( "AI のコードを実行しますか" ), wxDefaultPosition,
+                      wxDefaultSize, wxDEFAULT_DIALOG_STYLE | wxRESIZE_BORDER )
+    {
+        wxBoxSizer* sizer = new wxBoxSizer( wxVERTICAL );
+
+        wxStaticText* desc = new wxStaticText( this, wxID_ANY, aDescription );
+        desc->SetFont( desc->GetFont().Bold() );
+        sizer->Add( desc, 0, wxALL | wxEXPAND, 8 );
+
+        sizer->Add( new wxStaticText( this, wxID_ANY,
+                                      J( "開いている基板に、次の Python を実行します。"
+                                         "実行した変更は「元に戻す」1 回で戻せます。" ) ),
+                    0, wxLEFT | wxRIGHT | wxEXPAND, 8 );
+
+        wxTextCtrl* code = new wxTextCtrl( this, wxID_ANY, aCode, wxDefaultPosition,
+                                           FromDIP( wxSize( 640, 360 ) ),
+                                           wxTE_MULTILINE | wxTE_READONLY | wxTE_DONTWRAP );
+        code->SetFont( wxFont( wxFontInfo( code->GetFont().GetPointSize() ).Family( wxFONTFAMILY_TELETYPE ) ) );
+        sizer->Add( code, 1, wxALL | wxEXPAND, 8 );
+
+        wxBoxSizer* buttons = new wxBoxSizer( wxHORIZONTAL );
+        buttons->AddStretchSpacer();
+        wxButton* no = new wxButton( this, wxID_CANCEL, J( "やめる" ) );
+        wxButton* yes = new wxButton( this, wxID_OK, J( "実行する" ) );
+        buttons->Add( no, 0, wxRIGHT, 8 );
+        buttons->Add( yes, 0 );
+        sizer->Add( buttons, 0, wxALL | wxEXPAND, 8 );
+
+        // 既定のボタンは「やめる」（Enter の押し間違いで実行しない）
+        no->SetDefault();
+        no->SetFocus();
+
+        SetSizerAndFit( sizer );
+        CentreOnParent();
+    }
+};
