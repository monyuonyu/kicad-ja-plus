+wxString PANEL_AI_CHAT::bridgePath() const
+{
+    return envOr( wxS( "KICAD_AI_BRIDGE" ),
+                  PATHS::GetStockScriptingPath() + wxS( "kicad_ai" ) + wxFileName::GetPathSeparator()
+                          + wxS( "bridge.py" ) );
