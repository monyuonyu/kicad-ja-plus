diff --git a/include/board_item.h b/include/board_item.h
index dfce4e63..a175efce 100644
--- a/include/board_item.h
+++ b/include/board_item.h
@@ -407,6 +407,13 @@ public:
      */
     virtual void Flip( const VECTOR2I& aCentre, FLIP_DIRECTION aFlipDirection );
 
+    /**
+     * The layer on the other side of the board.  Uses the parent board's layer pairs when there
+     * is one; library items (no board, e.g. while saving a footprint library) use the standard
+     * front/back pairs.
+     */
+    PCB_LAYER_ID GetFlippedLayer( PCB_LAYER_ID aLayer ) const;
+
     /**
      * Mirror this object relative to a given horizontal axis the layer is not changed.
      *
diff --git a/pcbnew/board_item.cpp b/pcbnew/board_item.cpp
index 76830a09..b5ea138f 100644
--- a/pcbnew/board_item.cpp
+++ b/pcbnew/board_item.cpp
@@ -89,6 +89,15 @@ const BOARD* BOARD_ITEM::GetBoard() const
 }
 
 
+PCB_LAYER_ID BOARD_ITEM::GetFlippedLayer( PCB_LAYER_ID aLayer ) const
+{
+    if( const BOARD* board = GetBoard() )
+        return board->FlipLayer( aLayer );
+
+    return ::FlipLayer( aLayer );
+}
+
+
 BOARD* BOARD_ITEM::GetBoard()
 {
     if( Type() == PCB_T )
diff --git a/pcbnew/pad.cpp b/pcbnew/pad.cpp
index 5b71896d..23cd81d4 100644
--- a/pcbnew/pad.cpp
+++ b/pcbnew/pad.cpp
@@ -1530,7 +1530,7 @@ void PAD::Flip( const VECTOR2I& aCentre, FLIP_DIRECTION aFlipDirection )
     LSET flipped;
 
     for( PCB_LAYER_ID layer : m_padStack.LayerSet() )
-        flipped.set( GetBoard()->FlipLayer( layer ) );
+        flipped.set( GetFlippedLayer( layer ) );
 
     SetLayerSet( flipped );
 
diff --git a/pcbnew/padstack.cpp b/pcbnew/padstack.cpp
index d55ac6dc..94d6292a 100644
--- a/pcbnew/padstack.cpp
+++ b/pcbnew/padstack.cpp
@@ -1475,14 +1475,20 @@ double PADSTACK::Similarity( const PADSTACK& aOther ) const
 
 void PADSTACK::FlipLayers( BOARD* aBoard )
 {
+    // A footprint being saved to a library has no board: use the standard front/back pairs
+    auto flip = [aBoard]( PCB_LAYER_ID aLayer )
+                {
+                    return aBoard ? aBoard->FlipLayer( aLayer ) : ::FlipLayer( aLayer );
+                };
+
     if( m_mode == MODE::FRONT_INNER_BACK )
     {
         std::unordered_map<PCB_LAYER_ID, COPPER_LAYER_PROPS> oldCopperProps = m_copperProps;
         m_copperProps.clear();
 
-        m_copperProps[aBoard->FlipLayer( F_Cu )] = oldCopperProps[F_Cu];
+        m_copperProps[flip( F_Cu )] = oldCopperProps[F_Cu];
         m_copperProps[INNER_LAYERS] = oldCopperProps[INNER_LAYERS];
-        m_copperProps[aBoard->FlipLayer( B_Cu )] = oldCopperProps[B_Cu];
+        m_copperProps[flip( B_Cu )] = oldCopperProps[B_Cu];
     }
     else if( m_mode == MODE::CUSTOM )
     {
@@ -1490,19 +1496,19 @@ void PADSTACK::FlipLayers( BOARD* aBoard )
         m_copperProps.clear();
 
         for( const auto& [layer, props] : oldCopperProps )
-            m_copperProps[aBoard->FlipLayer( layer )] = props;
+            m_copperProps[flip( layer )] = props;
     }
 
     std::swap( m_frontMaskProps, m_backMaskProps );
 
-    m_drill.start = aBoard->FlipLayer( m_drill.start );
-    m_drill.end = aBoard->FlipLayer( m_drill.end );
+    m_drill.start = flip( m_drill.start );
+    m_drill.end = flip( m_drill.end );
 
-    m_secondaryDrill.start = aBoard->FlipLayer( m_secondaryDrill.start );
-    m_secondaryDrill.end = aBoard->FlipLayer( m_secondaryDrill.end );
+    m_secondaryDrill.start = flip( m_secondaryDrill.start );
+    m_secondaryDrill.end = flip( m_secondaryDrill.end );
 
-    m_tertiaryDrill.start = aBoard->FlipLayer( m_tertiaryDrill.start );
-    m_tertiaryDrill.end = aBoard->FlipLayer( m_tertiaryDrill.end );
+    m_tertiaryDrill.start = flip( m_tertiaryDrill.start );
+    m_tertiaryDrill.end = flip( m_tertiaryDrill.end );
 
     std::swap( m_frontPostMachining, m_backPostMachining );
 }
