diff --git a/common/settings/settings_manager.cpp b/common/settings/settings_manager.cpp
index 9fa4a4ef..8d470ff0 100644
--- a/common/settings/settings_manager.cpp
+++ b/common/settings/settings_manager.cpp
@@ -271,7 +271,7 @@ COLOR_SETTINGS* SETTINGS_MANAGER::GetColorSettings( const wxString& aName )
     // No match? See if we can load it
     if( !aName.empty() )
     {
-        COLOR_SETTINGS* ret = loadColorSettingsByName( aName );
+        COLOR_SETTINGS* ret = loadColorSettingsByPath( aName );
 
         if( !ret )
         {
@@ -303,20 +303,37 @@ std::vector<COLOR_SETTINGS*> SETTINGS_MANAGER::GetColorSettingsList()
 }
 
 
-COLOR_SETTINGS* SETTINGS_MANAGER::loadColorSettingsByName( const wxString& aName )
+COLOR_SETTINGS* SETTINGS_MANAGER::loadColorSettingsByPath( const wxString& aName )
 {
     wxLogTrace( traceSettings, wxT( "Attempting to load color theme %s" ), aName );
 
     wxFileName fn( GetColorSettingsPath(), aName, wxS( "json" ) );
+    bool       useAbsolutePath = false;
 
     if( !fn.IsOk() || !fn.Exists() )
     {
-        wxLogTrace( traceSettings, wxT( "Theme file %s.json not found, falling back to user" ),
-                    aName );
-        return nullptr;
+        wxLogTrace( traceSettings, wxT( "Theme file '%s' does not exist" ), fn.GetFullPath() );
+
+        fn = wxFileName( aName );
+
+        if( fn.GetExt().IsEmpty() )
+            fn.SetExt( wxS( "json" ) );
+
+        useAbsolutePath = true;
+
+        if( !fn.IsOk() || !fn.Exists() )
+        {
+            wxLogTrace( traceSettings, wxT( "Theme file '%s' does not exist, falling back to user" ),
+                        fn.GetFullPath() );
+            return nullptr;
+        }
     }
 
-    COLOR_SETTINGS* settings = RegisterSettings( new COLOR_SETTINGS( aName ) );
+    COLOR_SETTINGS* settings = RegisterSettings( new COLOR_SETTINGS( aName, useAbsolutePath ) );
+
+    // do not modify user-provided theme file, as KiCad does not own it
+    if( useAbsolutePath )
+        settings->SetReadOnly( true );
 
     if( settings->GetFilename() != aName.ToStdString() )
     {
diff --git a/include/settings/settings_manager.h b/include/settings/settings_manager.h
index 1b96897f..15ab5617 100644
--- a/include/settings/settings_manager.h
+++ b/include/settings/settings_manager.h
@@ -497,12 +497,15 @@ private:
                                 int* aMinor = nullptr );
 
     /**
-     * Attempt to load a color theme by name (the color theme directory and .json ext are assumed).
+     * Attempt to load a color theme by its file name (the color theme
+     * directory and .json ext are assumed) or from the given argument
+     * interpreted as a path.
      *
-     * @param aName is the filename of the color theme (without the extension or path).
+     * @param aName is the filename of the color theme (without the extension
+     * or path) or an existing path to a color theme file.
      * @return the loaded settings, or nullptr if load failed.
      */
-    COLOR_SETTINGS* loadColorSettingsByName( const wxString& aName );
+    COLOR_SETTINGS* loadColorSettingsByPath( const wxString& aName );
 
     COLOR_SETTINGS* registerColorSettings( const wxString& aFilename, bool aAbsolutePath = false );
 
