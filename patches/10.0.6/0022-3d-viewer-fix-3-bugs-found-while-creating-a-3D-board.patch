From 153b12f9f17373239034a0f360be261f5bfef9fa Mon Sep 17 00:00:00 2001
From: Francois Belanger <francois.belanger@solution-ice.com>
Date: Tue, 29 Sep 2026 08:38:14 +0900
Subject: [PATCH 22/30] 3d-viewer: fix 3 bugs found while creating a 3D board
 editor

From KiCad MR !2752 (https://gitlab.com/kicad/code/kicad/-/merge_requests/2752), ported to 10.0.6 (declaration re-wrapped).
---
 3d-viewer/3d_canvas/board_adapter.h               |  7 ++++++-
 .../3d_canvas/create_3Dgraphic_brd_items.cpp      | 15 ++++++++++-----
 3d-viewer/3d_canvas/eda_3d_canvas.cpp             |  5 +++++
 3d-viewer/3d_rendering/opengl/create_scene.cpp    |  3 +++
 .../3d_rendering/raytracing/create_scene.cpp      |  5 +++--
 5 files changed, 27 insertions(+), 8 deletions(-)

diff --git a/3d-viewer/3d_canvas/board_adapter.h b/3d-viewer/3d_canvas/board_adapter.h
index 675967f3..cc93d052 100644
--- a/3d-viewer/3d_canvas/board_adapter.h
+++ b/3d-viewer/3d_canvas/board_adapter.h
@@ -456,8 +456,13 @@ private:
     void destroyLayers();
 
     // Helper functions to create the board
+    /**
+     * @param aOwner is the item the 2D objects are attributed to when \a aTrack is created on
+     *               the stack and its pointer would no longer be valid.
+     */
     void createTrackWithMargin( const PCB_TRACK* aTrack, CONTAINER_2D_BASE* aDstContainer,
-                                PCB_LAYER_ID aLayer, int aMargin = 0 );
+                                PCB_LAYER_ID aLayer, int aMargin = 0,
+                                const BOARD_ITEM* aOwner = nullptr );
 
     // Generate the pad shape on board layers. The pad hole is not generated by createPadWithMargin
     void createPadWithMargin( const PAD *aPad, CONTAINER_2D_BASE* aDstContainer,
diff --git a/3d-viewer/3d_canvas/create_3Dgraphic_brd_items.cpp b/3d-viewer/3d_canvas/create_3Dgraphic_brd_items.cpp
index 78d6949b..28e2c90f 100644
--- a/3d-viewer/3d_canvas/create_3Dgraphic_brd_items.cpp
+++ b/3d-viewer/3d_canvas/create_3Dgraphic_brd_items.cpp
@@ -308,8 +308,12 @@ void BOARD_ADAPTER::addFootprintShapes( const FOOTPRINT* aFootprint, CONTAINER_2
 
 
 void BOARD_ADAPTER::createTrackWithMargin( const PCB_TRACK* aTrack, CONTAINER_2D_BASE* aDstContainer,
-                                           PCB_LAYER_ID aLayer, int aMargin )
+                                           PCB_LAYER_ID aLayer, int aMargin, const BOARD_ITEM* aOwner )
 {
+    // aTrack can be an object created on the stack; the 2D objects keep a pointer to the
+    // owner passed here.
+    const BOARD_ITEM& owner = aOwner ? *aOwner : *aTrack;
+
     SFVEC2F start3DU = TO_SFVEC2F( aTrack->GetStart() );
     SFVEC2F end3DU = TO_SFVEC2F( aTrack->GetEnd() );
 
@@ -320,7 +324,7 @@ void BOARD_ADAPTER::createTrackWithMargin( const PCB_TRACK* aTrack, CONTAINER_2D
         const PCB_VIA* via = static_cast<const PCB_VIA*>( aTrack );
         float          width3DU = TO_3DU( via->GetWidth( aLayer ) + aMargin * 2 );
 
-        addFILLED_CIRCLE_2D( aDstContainer, start3DU, width3DU / 2.0, *aTrack );
+        addFILLED_CIRCLE_2D( aDstContainer, start3DU, width3DU / 2.0, owner );
         break;
     }
 
@@ -330,14 +334,15 @@ void BOARD_ADAPTER::createTrackWithMargin( const PCB_TRACK* aTrack, CONTAINER_2D
 
         if( arc->IsDegenerated() )
         {
-            // Draw this very small arc like a track segment (a PCB_TRACE_T)
+            // Draw this very small arc like a track segment (a PCB_TRACE_T).  The stand-in
+            // track is created on the stack, so attribute the geometry to the arc itself.
             PCB_TRACK track( arc->GetParent() );
             track.SetStart( arc->GetStart() );
             track.SetEnd( arc->GetEnd() );
             track.SetWidth( arc->GetWidth() );
             track.SetLayer( arc->GetLayer() );
 
-            createTrackWithMargin( &track, aDstContainer, aLayer, aMargin );
+            createTrackWithMargin( &track, aDstContainer, aLayer, aMargin, arc );
             return;
         }
 
@@ -371,7 +376,7 @@ void BOARD_ADAPTER::createTrackWithMargin( const PCB_TRACK* aTrack, CONTAINER_2D
     case PCB_TRACE_T:    // Track is a usual straight segment
     {
         float width3DU = TO_3DU( aTrack->GetWidth() + aMargin * 2 );
-        addROUND_SEGMENT_2D( aDstContainer, start3DU, end3DU, width3DU, *aTrack );
+        addROUND_SEGMENT_2D( aDstContainer, start3DU, end3DU, width3DU, owner );
         break;
     }
 
diff --git a/3d-viewer/3d_canvas/eda_3d_canvas.cpp b/3d-viewer/3d_canvas/eda_3d_canvas.cpp
index c425da79..eb317cfc 100644
--- a/3d-viewer/3d_canvas/eda_3d_canvas.cpp
+++ b/3d-viewer/3d_canvas/eda_3d_canvas.cpp
@@ -328,6 +328,11 @@ void EDA_3D_CANVAS::ReloadRequest( BOARD* aBoard , S3D_CACHE* aCachePointer )
 
     m_boardAdapter.ReloadColorSettings();
 
+    m_currentRollOverItem = nullptr;
+
+    if( m_3d_render_opengl )
+        m_3d_render_opengl->SetCurrentRollOverItem( nullptr );
+
     if( m_3d_render )
         m_3d_render->ReloadRequest();
 }
diff --git a/3d-viewer/3d_rendering/opengl/create_scene.cpp b/3d-viewer/3d_rendering/opengl/create_scene.cpp
index 9691be7a..fe762d52 100644
--- a/3d-viewer/3d_rendering/opengl/create_scene.cpp
+++ b/3d-viewer/3d_rendering/opengl/create_scene.cpp
@@ -687,6 +687,9 @@ void RENDER_3D_OPENGL::backfillPostMachine()
 
 void RENDER_3D_OPENGL::reload( REPORTER* aStatusReporter, REPORTER* aWarningReporter )
 {
+    // Reset the rollover pointer, it would no longer be valid
+    m_currentRollOverItem = nullptr;
+
     m_reloadRequested = false;
 
     freeAllLists();
diff --git a/3d-viewer/3d_rendering/raytracing/create_scene.cpp b/3d-viewer/3d_rendering/raytracing/create_scene.cpp
index 699f4a5c..1b103818 100644
--- a/3d-viewer/3d_rendering/raytracing/create_scene.cpp
+++ b/3d-viewer/3d_rendering/raytracing/create_scene.cpp
@@ -755,8 +755,9 @@ void RENDER_3D_RAYTRACE_BASE::Reload( REPORTER* aStatusReporter, REPORTER* aWarn
         createItemsFromContainer( container2d, layer_id, materialLayer, layerColor, 0.0f );
     } // for each layer on map
 
-    // Create plated copper
-    if( m_boardAdapter.m_Cfg->m_Render.differentiate_plated_copper )
+    // Create plated copper.  Skip it in the picking scene: the overlay goes nowhere and
+    // blocks cross-probe on the pads under it.
+    if( m_boardAdapter.m_Cfg->m_Render.differentiate_plated_copper && !aOnlyLoadCopperAndShapes )
     {
         createItemsFromContainer( m_boardAdapter.GetPlatedPadsFront(), F_Cu, &m_materials.m_Copper,
                                   m_boardAdapter.m_CopperColor,
