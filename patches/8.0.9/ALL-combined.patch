+
+static bool doCheck( CTX& c, bool aAll )
+{
+    {
+        ZONE_FILLER        filler( c.board, nullptr );
+        std::vector<ZONE*> zones( c.board->Zones().begin(), c.board->Zones().end() );
+        filler.Fill( zones );
+    }
+
+    c.board->BuildConnectivity();
+    c.dirty = true;
+
+    BOARD_DESIGN_SETTINGS& bds = c.board->GetDesignSettings();
+    std::map<wxString, std::vector<wxString>> found;
+    int hidden = 0;
+
+    // ライブラリとの照合は、このツールではライブラリ表を読まないため見かけの警告になる。check では止める
+    std::map<int, SEVERITY> savedSev = bds.m_DRCSeverities;
+
+    if( !aAll )
+    {
+        bds.m_DRCSeverities[DRCE_LIB_FOOTPRINT_ISSUES] = RPT_SEVERITY_IGNORE;
+        bds.m_DRCSeverities[DRCE_LIB_FOOTPRINT_MISMATCH] = RPT_SEVERITY_IGNORE;
+    }
+
+    c.drc->SetViolationHandler(
+            [&]( const std::shared_ptr<DRC_ITEM>& aItem, VECTOR2I aPos, int aLayer )
+            {
+                if( bds.GetSeverity( aItem->GetErrorCode() ) == RPT_SEVERITY_IGNORE )
+                    return;
+
+                wxString key = aItem->GetSettingsKey();
+
+                if( !aAll && ( key.StartsWith( wxS( "lib_footprint" ) ) || key.StartsWith( wxS( "silk" ) ) ) )
+                {
+                    hidden++;
+                    return;
+                }
+
+                BOARD_ITEM* a = c.board->GetItem( aItem->GetMainItemID() );
+                BOARD_ITEM* b = c.board->GetItem( aItem->GetAuxItemID() );
+                wxString    what = fmtXY( aPos );
+
+                if( a && a->Type() != NOT_USED )
+                    what += wxS( " " ) + describe( a, a->GetPosition() );
+
+                if( b && b->Type() != NOT_USED )
+                    what += wxS( " ⇔ " ) + describe( b, b->GetPosition() );
+
+                found[key].push_back( what );
+            } );
+
+    c.drc->RunTests( EDA_UNITS::MILLIMETRES, false, false );
+    c.drc->ClearViolationHandler();
+    bds.m_DRCSeverities = savedSev;
+
+    int total = 0, unconn = 0;
+
+    for( auto& [k, v] : found )
+        ( k == wxS( "unconnected_items" ) ? unconn : total ) += v.size();
+
+    printf( "  %d行: DRC 違反 %d 件 / 未配線 %d 件%s\n", g_line, total, unconn,
+            hidden ? (const char*) wxString::Format( "(シルクの警告 %d 件は非表示。check all で表示)", hidden ).utf8_str()
+                   : "" );
+
+    if( found.count( wxS( "lib_footprint_issues" ) ) )
+        printf( "    (lib_footprint_issues はこのツールがライブラリ表を読まないために出る。"
+                "正しい照合は kicad-local drc で)\n" );
+
+    for( auto& [k, v] : found )
+    {
+        printf( "    [%s] %zu 件\n", (const char*) k.utf8_str(), v.size() );
+
+        for( size_t i = 0; i < v.size() && i < 10; i++ )
+            printf( "      %s\n", (const char*) v[i].utf8_str() );
+
+        if( v.size() > 10 )
+            printf( "      ...ほか %zu 件\n", v.size() - 10 );
+    }
+
+    fflush( stdout );
+    return true;
+}
