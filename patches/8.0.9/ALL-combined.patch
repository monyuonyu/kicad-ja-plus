+
+typedef std::vector<std::pair<VECTOR2I, int>> ROUTE_PTS;   // (点, この点でビアを打つ時の次の層 / -1)
+
+struct ROUTE_RESULT
+{
+    bool     ok = false;
+    double   lengthMm = 0;
+    int      vias = 0;
+};
+
+
+static void measure( CTX& c, ROUTE_RESULT& r )
+{
+    const PNS::ITEM_SET traces = c.router->Placer()->Traces();   // 一時オブジェクトのまま回さない
+
+    for( const PNS::ITEM* it : traces.CItems() )
+    {
+        if( it->Kind() == PNS::ITEM::LINE_T )
+        {
+            const PNS::LINE* l = static_cast<const PNS::LINE*>( it );
+            r.lengthMm += mm( l->CLine().Length() );
+
+            if( l->EndsWithVia() )
+                r.vias++;
+        }
+        else if( it->Kind() == PNS::ITEM::VIA_T )
+        {
+            r.vias++;
+        }
+    }
+}
+
+
+// aCommit=false なら試すだけで基板は変えない(長さを測る)
+static ROUTE_RESULT runRoute( CTX& c, int aLayer, const ROUTE_PTS& aPts, bool aCommit )
+{
+    ROUTE_RESULT res;
+    c.Sync();
+
+    const VECTOR2I& p0 = aPts.front().first;
+    PNS::ITEM*      start = pickItem( c.router, p0, aLayer );
+
+    if( !start )
+    {
+        msg( "  %d行: NG 始点 %s のこの層に配線できる部品・配線がない\n", fmtPt( p0 ) );
+        return res;
+    }
+
+    PNS::SIZES_SETTINGS sizes( c.router->Sizes() );
+    c.iface->ImportSizes( sizes, start, start->Net(), p0 );
+
+    if( c.width > 0 )
+    {
+        sizes.SetTrackWidth( c.width );
+        sizes.SetTrackWidthIsExplicit( true );
+    }
+
+    sizes.ClearLayerPairs();
+    sizes.AddLayerPair( F_Cu, B_Cu );
+    c.router->UpdateSizes( sizes );
+    c.router->SetMode( PNS::PNS_MODE_ROUTE_SINGLE );
+
+    if( !c.router->StartRouting( p0, start, aLayer ) )
+    {
+        msg( "  %d行: NG 配線を開始できない: %s\n", c.router->FailureReason() );
+        return res;
+    }
+
+    for( size_t i = 1; i < aPts.size(); i++ )
+    {
+        const VECTOR2I& p = aPts[i].first;
+        bool            last = ( i == aPts.size() - 1 );
+        PNS::ITEM*      end = last ? pickItem( c.router, p, c.router->GetCurrentLayer() ) : nullptr;
+
+        if( aPts[i].second >= 0 && !c.router->IsPlacingVia() )   // この点でビアを打つ
+            c.router->ToggleViaPlacement();
+
+        c.router->Move( p, end );
+        bool     placingVia = c.router->IsPlacingVia();
+        VECTOR2I reached = c.router->Placer()->CurrentEnd();
+
+        if( ( reached - p ).EuclideanNorm() > pcbIUScale.mmToIU( 0.01 ) )
+        {
+            msg( last ? "  %d行: NG 終点まで届かない。%s で止まった(経由点やビアを足すと通る可能性あり)\n"
+                      : "  %d行: NG 経由点まで届かない。%s で止まった\n",
+                 fmtPt( reached ) );
+            c.router->StopRouting();
+            return res;
+        }
+
+        measure( c, res );
+        bool finished = c.router->FixRoute( p, end, false, false );
+
+        if( finished != last )
+        {
+            msg( last ? "  %d行: NG 終点 %s で確定できない\n" : "  %d行: NG 経由点 %s で配線が終わってしまった\n",
+                 fmtPt( p ) );
+            c.router->StopRouting();
+            return res;
+        }
+
+        if( last )
+            break;
+
+        if( placingVia )   // 画面版と同じく、ビアを打ったら相手側の層へ
+        {
+            c.router->SwitchLayer( aPts[i].second );
+            PNS::SIZES_SETTINGS sz( c.router->Sizes() );
+            c.router->UpdateSizes( sz );
+        }
+    }
+
+    if( aCommit )
+    {
+        c.router->CommitRouting();   // ここで初めて基板に書き込まれる
+        c.dirty = true;
+    }
+    else
+    {
+        c.router->StopRouting();
+    }
+
+    res.ok = true;
+    return res;
+}
+
+
+static bool doAutoroute( CTX& c, const VECTOR2I& aA, const VECTOR2I& aB, bool aAllowShove )
+{
+    const double viaCostMm = 5.0;
+    const int    layers[2] = { F_Cu, B_Cu };
+    PNS::PNS_MODE savedMode = c.settings->Mode();
+    std::vector<PNS::PNS_MODE> modes = { PNS::RM_Walkaround };
+
+    if( aAllowShove )
+        modes.push_back( PNS::RM_Shove );
+
+    // ビア候補: 両端を含む範囲(+6mm)を 1mm 刻み。直線距離の下限が小さい順に試す
+    BOX2I box( aA, VECTOR2I( 0, 0 ) );
+    box.Merge( aB );
+    box.Inflate( pcbIUScale.mmToIU( 6 ) );
+    std::vector<std::pair<double, VECTOR2I>> cands;
+
+    for( int x = box.GetLeft(); x <= box.GetRight(); x += pcbIUScale.mmToIU( 1 ) )
+    {
+        for( int y = box.GetTop(); y <= box.GetBottom(); y += pcbIUScale.mmToIU( 1 ) )
+        {
+            VECTOR2I v( x, y );
+            cands.emplace_back( mm( ( v - aA ).EuclideanNorm() ) + mm( ( aB - v ).EuclideanNorm() ), v );
+        }
+    }
+
+    std::sort( cands.begin(), cands.end(),
+               []( const auto& a, const auto& b ) { return a.first < b.first; } );
+
+    for( PNS::PNS_MODE mode : modes )
+    {
+        c.settings->SetMode( mode );
+        double    bestCost = 1e18;
+        int       bestLayer = -1;
+        ROUTE_PTS bestPts;
+        int       tries = 0;
+
+        g_quiet = true;
+
+        for( int L : layers )
+        {
+            ROUTE_PTS    pts = { { aA, -1 }, { aB, -1 } };
+            ROUTE_RESULT r = runRoute( c, L, pts, false );
+            tries++;
+
+            if( r.ok && r.lengthMm < bestCost )
+            {
+                bestCost = r.lengthMm;
+                bestLayer = L;
+                bestPts = pts;
+            }
+        }
+
+        for( const auto& [lower, v] : cands )
+        {
+            if( lower + viaCostMm >= bestCost )
+                break;   // これ以上は短くならない
+
+            for( int k = 0; k < 2; k++ )
+            {
+                ROUTE_PTS    pts = { { aA, -1 }, { v, layers[1 - k] }, { aB, -1 } };
+                ROUTE_RESULT r = runRoute( c, layers[k], pts, false );
+                tries++;
+                double cost = r.lengthMm + viaCostMm * r.vias;
+
+                if( r.ok && cost < bestCost )
+                {
+                    bestCost = cost;
+                    bestLayer = layers[k];
+                    bestPts = pts;
+                }
+            }
+        }
+
+        g_quiet = false;
+
+        if( bestLayer >= 0 )
+        {
+            ROUTE_RESULT r = runRoute( c, bestLayer, bestPts, true );
+            c.settings->SetMode( savedMode );
+
+            if( !r.ok )
+                return false;
+
+            wxString how = wxString::Format( "%s %.1fmm", LSET::Name( ToLAYER_ID( bestLayer ) ), r.lengthMm );
+
+            if( bestPts.size() == 3 )
+                how += wxS( "、ビア " ) + fmtPt( bestPts[1].first ) + wxS( " で " )
+                       + LSET::Name( ToLAYER_ID( bestPts[1].second ) ) + wxS( " へ" );
+
+            how += wxString::Format( "(%s、%d通り試行)",
+                                     mode == PNS::RM_Shove ? wxS( "押しのけ" ) : wxS( "既存配線は動かさず" ),
+                                     tries );
+            msg( "  %d行: 経路 %s\n", how );
+            return true;
+        }
+    }
+
+    c.settings->SetMode( savedMode );
+    msg( "  %d行: NG 自動で経路が見つからない(ビア1個まで)。route で経由点を指示してください%s\n",
+         wxString() );
+    return false;
+}
+
+
+static bool doUnroute( CTX& c, const std::string& aTok )
+{
+    NETINFO_ITEM* net = nullptr;
+
+    if( PAD* pad = findPad( c.board, aTok ) )
+        net = pad->GetNet();
+    else
+        net = c.board->FindNet( wxString::FromUTF8( aTok ) );
+
+    if( !net || net->GetNetCode() <= 0 )
+    {
+        msg( "  %d行: NG ネットが見つからない: %s\n", wxString::FromUTF8( aTok ) );
+        return false;
+    }
+
+    std::vector<PCB_TRACK*> del;
+
+    for( PCB_TRACK* t : c.board->Tracks() )
+        if( t->GetNetCode() == net->GetNetCode() )
+            del.push_back( t );
+
+    for( PCB_TRACK* t : del )
+    {
+        c.board->Remove( t );
+        c.iface->m_trash.push_back( t );
+    }
+
+    c.iface->m_removed += del.size();
+    c.dirty = true;
+    msg( "  %d行: %s\n", wxString::Format( "ネット %s の配線・ビア %zu 個を削除", net->GetNetname(), del.size() ) );
+    return true;
+}
