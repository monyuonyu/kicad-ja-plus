+        hasOutline( false ),
+        boardWidth( 0 ),
+        boardHeight( 0 ),
+        boardArea( 0.0 ),
+        frontCopperArea( 0.0 ),
+        backCopperArea( 0.0 ),
+        minClearanceTrackToTrack( std::numeric_limits<int>::max() ),
