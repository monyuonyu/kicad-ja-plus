+static FOOTPRINT* findFp( BOARD* aBoard, const wxString& aRef )
+{
+    for( FOOTPRINT* f : aBoard->Footprints() )
+        if( f->GetReference() == aRef )
+            return f;
+
+    return nullptr;
+}
