+// KiCad 9 の CAMERA::ViewCommand_T1(f6f0b9a66) と同じ視点切り替え。8.0.9 では共通ライブラリを変えずに済むよう
+// ここに置く(ローカル修正)
+static void viewCommandT1( CAMERA& aCamera, VIEW3D_TYPE aView )
+{
+    switch( aView )
+    {
+    case VIEW3D_TYPE::VIEW3D_RIGHT:
+        aCamera.SetT0_and_T1_current_T();
+        aCamera.Reset_T1();
+        aCamera.RotateZ_T1( glm::radians( -90.0f ) );
+        aCamera.RotateX_T1( glm::radians( -90.0f ) );
+        break;
+    case VIEW3D_TYPE::VIEW3D_LEFT:
+        aCamera.Reset_T1();
+        aCamera.RotateZ_T1( glm::radians( 90.0f ) );
+        aCamera.RotateX_T1( glm::radians( -90.0f ) );
+        break;
+    case VIEW3D_TYPE::VIEW3D_FRONT:
+        aCamera.Reset_T1();
+        aCamera.RotateX_T1( glm::radians( -90.0f ) );
+        break;
+    case VIEW3D_TYPE::VIEW3D_BACK:
+        aCamera.Reset_T1();
+        aCamera.RotateX_T1( glm::radians( -90.0f ) );
+        aCamera.RotateZ_T1( glm::radians( 179.999f ) );
+        break;
+    case VIEW3D_TYPE::VIEW3D_BOTTOM:
+        aCamera.Reset_T1();
+        aCamera.RotateY_T1( glm::radians( 179.999f ) );
+        break;
+    case VIEW3D_TYPE::VIEW3D_TOP:
+    default:
+        aCamera.Reset_T1();
+        break;
+    }
+}
