index 0000000..c031e39
--- /dev/null
+++ b/qa/tools/pns/kicad_route_main.cpp
@@ -0,0 +1,2333 @@
+/*
+ * kicad_route: KiCad 8 の押しのけ配線ルーター(PNS)を画面なしで動かすコマンド
+ *
+ *   kicad_route <入力.kicad_pcb> <出力.kicad_pcb | -> <手順ファイル>
+ *   (出力に - を指定すると保存しない。findspace で調べるだけの時など)
+ *
+ * 手順ファイル(1行1操作、# 以降はコメント、座標は mm)。点は「x,y」か「部品番号.端子番号」(例 R29.2):
+ *   mode shove | walkaround | mark      配線モード(既定 shove)
+ *   width <mm> | width auto             線幅(既定 auto = ネットクラス)
+ *   route <層> 点 点 ... [via:<層>] ... 点
+ *        最初の点の部品/配線から、経由点を順にたどって最後の点の部品/配線まで配線する。
+ *        via:<層> はその直前の点でビアを打ち、以降を指定の層で配線する。
+ *   autoroute 点 点 [shove]
+ *        両面・ビア1個までの経路を自動で探し、最短(ビア1個は5mm換算)のものを引く。
+ *        既定は既存の配線を動かさない walkaround。shove を付けると押しのけも試す。
+ *   unroute <部品番号.端子番号 | ネット名>   そのネットの配線とビアをすべて消す
+ *   optimize <部品番号.端子番号 | ネット名 | all>
+ *        引き終えた配線を、ルーターの最適化で単純化・角の整理をする(KiCad 11 の Optimize Route
+ *        を移植)。ロックされた配線と円弧を含む配線には触らない。ぶつかる結果は採用しない
+ *   drag <部品番号> dx,dy                部品を dx,dy 動かし、ぶつかる配線は押しのける
+ *   place <部品番号> x,y [角度]          部品を絶対座標へ(配線は追従)。角度を変える場合は
+ *                                        配線がつながっていないこと
+ *   findspace <部品番号> [刻みmm] [x0,y0,x1,y1]
+ *        部品を置ける場所(外形枠が重ならず、銅箔がクリアランスを満たす)を探し、
+ *        つながる端子までの距離が短い順に place 命令の形で表示する(基板は変えない)
+ *
+ * 最後に、まだつながっていない端子の組を一覧表示する。
+ * 結果は KiCad 8 の形式で保存する(ベタは保存前に再計算)。
+ */
+
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <memory>
+#include <set>
+#include <map>
