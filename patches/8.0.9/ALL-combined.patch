+struct CTX
+{
+    BOARD*                 board;
+    HEADLESS_IFACE*        iface;
+    PNS::ROUTER*           router;
+    PNS::ROUTING_SETTINGS* settings;
+    int                    width = 0;      // 0 = ネットクラス
+    bool                   dirty = true;   // 基板を書き換えたらルーターの世界を作り直す
+    std::shared_ptr<DRC_ENGINE> drc;
+
+    void Sync()
+    {
+        if( dirty )
+        {
+            router->SyncWorld();
+            dirty = false;
+        }
+    }
+};
