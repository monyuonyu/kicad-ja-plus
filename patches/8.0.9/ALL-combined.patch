+// 指定点・層にある、ネットを持つ配線対象を選ぶ(パッド > ビア > 配線)
+static PNS::ITEM* pickItem( PNS::ROUTER* aRouter, const VECTOR2I& aP, int aLayer )
+{
+    PNS::ITEM_SET items = aRouter->QueryHoverItems( aP );
+    PNS::ITEM*    best = nullptr;
+    int           bestRank = 99;
+
+    for( PNS::ITEM* item : items.Items() )
+    {
+        if( !item->Net() || !item->Layers().Overlaps( aLayer ) )
+            continue;
+
+        int rank = item->OfKind( PNS::ITEM::SOLID_T ) ? 0
+                   : item->OfKind( PNS::ITEM::VIA_T ) ? 1
+                   : item->OfKind( PNS::ITEM::SEGMENT_T | PNS::ITEM::ARC_T ) ? 2 : 99;
+
+        if( rank < bestRank )
+        {
+            best = item;
+            bestRank = rank;
+        }
+    }
+
+    return best;
+}
