+// KiCad MR !2188 から移植(8.0.9 の WALKAROUND::Route に合わせて調整)
+bool COMPONENT_DRAGGER::tryWalkaround( NODE* aNode, LINE& aOrig, LINE& aWalk )
+{
+    WALKAROUND walkaround( aNode, Router() );
+    walkaround.SetSolidsOnly( false );
+    walkaround.SetDebugDecorator( Dbg() );
+    walkaround.SetLogger( Logger() );
+    walkaround.SetIterationLimit( Settings().WalkaroundIterationLimit() );
+    walkaround.SetLengthLimit( true );
+
+    aWalk = aOrig;
+    return walkaround.Route( aOrig, aWalk, false ) == WALKAROUND::DONE;
+}
