diff --git a/gerbview/kicad_gerber_main.cpp b/gerbview/kicad_gerber_main.cpp
new file mode 100644
index 0000000..c860980
--- /dev/null
+++ b/gerbview/kicad_gerber_main.cpp
@@ -0,0 +1,569 @@
+/*
+ * kicad_gerber: ガーバー/ドリルの情報表示と差分(画面なし)。KiCad 11 の "kicad-cli gerber" を参考に、
+ * 8.0.9 の gerbview の読み込み部品で作ったローカルのコマンド。
+ *
+ *   kicad_gerber info <ファイル>
+ *   kicad_gerber diff <基準> <比較> [--png 出力.png] [--dpi N]
+ *   kicad_gerber dirdiff <基準フォルダ> <比較フォルダ> --out <出力フォルダ> [--dpi N]
+ *
+ * 差分画像: 灰=両方にある / 赤=基準にだけある(消えた) / 緑=比較にだけある(増えた)。
+ * 差のある場所は青い枠と番号で囲み、座標(mm、KiCad の基板座標)を一覧にする。
+ *
+ * 差分の計算と図形への変換は KiCad master の gerber_diff.cpp / gerber_to_polyset.cpp を移植したもの。
+ * PNG の描画は 8.0.9 に PNG プロッタが無いため Cairo で描く。
+ */
+
+#include <cstdio>
+#include <cstdlib>
+#include <cmath>
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+#include <algorithm>
+
+#include <cairo.h>
+
+#include <wx/app.h>
+#include <wx/dir.h>
+#include <wx/filename.h>
+#include <wx/ffile.h>
+
+#include <pgm_base.h>
+#include <kiway.h>
+#include <base_units.h>
+#include <geometry/shape_poly_set.h>
+
+#include "gerber_file_image.h"
+#include "excellon_image.h"
+#include "X2_gerber_attributes.h"
+#include "excellon_defaults.h"
+#include "gerber_to_polyset.h"
+#include "gerber_diff.h"
+
+
+struct HEADLESS_PGM : public PGM_BASE
+{
+    bool OnPgmInit() { return true; }
+    void OnPgmExit() { PGM_BASE::Destroy(); }
+    void MacOpenFile( const wxString& ) override {}
+};
+
+static HEADLESS_PGM g_pgm;
+
+struct HEADLESS_APP : public wxApp
+{
+    bool OnInit() override { return true; }
+};
+
+IMPLEMENT_APP_NO_MAIN( HEADLESS_APP );
+
+
+static double mm( double aIU )
+{
+    return aIU / GERB_IU_PER_MM;
+}
+
+
+static bool isExcellon( const wxString& aPath )
+{
+    wxString ext = wxFileName( aPath ).GetExt().Lower();
+
+    if( ext == wxS( "drl" ) || ext == wxS( "xln" ) || ext == wxS( "exc" ) || ext == wxS( "ncd" ) )
+        return true;
+
+    // 拡張子で分からなければ先頭を見る(Excellon は M48 で始まる)
+    wxFFile f( aPath, wxS( "r" ) );
+    char    buf[64] = { 0 };
+
+    if( f.IsOpened() )
+        f.Read( buf, sizeof( buf ) - 1 );
+
+    return std::string( buf ).find( "M48" ) != std::string::npos;
+}
+
+
+static std::unique_ptr<GERBER_FILE_IMAGE> loadImage( const wxString& aPath )
+{
+    if( isExcellon( aPath ) )
+    {
+        auto              img = std::make_unique<EXCELLON_IMAGE>( 0 );
+        EXCELLON_DEFAULTS defaults;   // gerbview の既定値(ファイル内の指定が優先される)
+
+        if( !img->LoadFile( aPath, &defaults ) )
+            return nullptr;
+
+        return img;
+    }
+
+    auto img = std::make_unique<GERBER_FILE_IMAGE>( 0 );
+
+    if( !img->LoadGerberFile( aPath ) )
+        return nullptr;
+
+    return img;
+}
+
+
+struct REGION
+{
+    BOX2I  box;
+    double addArea = 0;   // mm²
+    double remArea = 0;
+};
+
+
+// 追加・削除の図形を、近いもの(0.5mm 以内)どうしまとめて「差のある場所」にする
+static std::vector<REGION> findRegions( const SHAPE_POLY_SET& aAdd, const SHAPE_POLY_SET& aRem,
+                                        double aMinAreaMm2 )
+{
+    std::vector<REGION> regs;
+    const int           gap = (int) ( 0.5 * GERB_IU_PER_MM );
+
+    auto collect = [&]( const SHAPE_POLY_SET& aSet, bool aIsAdd )
+    {
+        for( int i = 0; i < aSet.OutlineCount(); i++ )
+        {
+            SHAPE_POLY_SET one;
+            one.AddOutline( aSet.COutline( i ) );
+
+            for( int h = 0; h < aSet.HoleCount( i ); h++ )
+                one.AddHole( aSet.CHole( i, h ) );
+
+            double area = one.Area() * 1e-10;
+
+            if( area < aMinAreaMm2 )
+                continue;
+
+            REGION r;
+            r.box = one.BBox();
+            ( aIsAdd ? r.addArea : r.remArea ) = area;
+            regs.push_back( r );
+        }
+    };
+
+    collect( aAdd, true );
+    collect( aRem, false );
+
+    // 近い箱を繰り返しまとめる
+    bool merged = true;
+
+    while( merged )
+    {
+        merged = false;
+
+        for( size_t i = 0; i < regs.size() && !merged; i++ )
+        {
+            BOX2I bi = regs[i].box;
+            bi.Inflate( gap );
+
+            for( size_t j = i + 1; j < regs.size(); j++ )
+            {
+                if( bi.Intersects( regs[j].box ) )
+                {
+                    regs[i].box.Merge( regs[j].box );
+                    regs[i].addArea += regs[j].addArea;
+                    regs[i].remArea += regs[j].remArea;
+                    regs.erase( regs.begin() + j );
+                    merged = true;
+                    break;
+                }
+            }
+        }
+    }
+
+    std::sort( regs.begin(), regs.end(), []( const REGION& a, const REGION& b )
+               { return a.addArea + a.remArea > b.addArea + b.remArea; } );
+    return regs;
+}
+
+
+static void pathPolySet( cairo_t* cr, const SHAPE_POLY_SET& aSet, const BOX2I& aView, double aScale,
+                         int aMargin )
+{
+    for( int i = 0; i < aSet.OutlineCount(); i++ )
+    {
+        auto addChain = [&]( const SHAPE_LINE_CHAIN& ch )
+        {
+            for( int k = 0; k < ch.PointCount(); k++ )
+            {
+                double x = aMargin + ( ch.CPoint( k ).x - aView.GetLeft() ) * aScale;
+                double y = aMargin + ( ch.CPoint( k ).y - aView.GetTop() ) * aScale;
+
+                if( k == 0 )
+                    cairo_move_to( cr, x, y );
+                else
+                    cairo_line_to( cr, x, y );
+            }
+
+            cairo_close_path( cr );
+        };
+
+        addChain( aSet.COutline( i ) );
+
+        for( int h = 0; h < aSet.HoleCount( i ); h++ )
+            addChain( aSet.CHole( i, h ) );
+    }
+}
+
+
+static bool renderDiffPng( const GERBER_DIFF_RESULT& aRes, const SHAPE_POLY_SET& aRef, const SHAPE_POLY_SET& aCmp,
+                           const std::vector<REGION>& aRegions, const wxString& aTitle, const wxString& aPath,
+                           int aDpi )
+{
+    BOX2I view = aRef.BBox();
+    view.Merge( aCmp.BBox() );
+
+    if( view.GetWidth() <= 0 || view.GetHeight() <= 0 )
+        return false;
+
+    const double scale = aDpi / 25.4 / GERB_IU_PER_MM;   // px / IU
+    const int    margin = 40;
+    const int    header = 70;
+    int          w = (int) ( view.GetWidth() * scale ) + 2 * margin;
+    int          h = (int) ( view.GetHeight() * scale ) + 2 * margin + header;
+
+    // 大きすぎる画像にしない(長辺 8000px まで)
+    double shrink = std::min( 1.0, 8000.0 / std::max( w, h ) );
+
+    cairo_surface_t* surf = cairo_image_surface_create( CAIRO_FORMAT_RGB24, (int) ( w * shrink ),
+                                                        (int) ( h * shrink ) );
+    cairo_t*         cr = cairo_create( surf );
+    cairo_scale( cr, shrink, shrink );
+    cairo_set_fill_rule( cr, CAIRO_FILL_RULE_EVEN_ODD );
+
+    cairo_set_source_rgb( cr, 1, 1, 1 );
+    cairo_paint( cr );
+
+    // 見出しと凡例
+    cairo_select_font_face( cr, "IPAexGothic", CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_NORMAL );
+    cairo_set_font_size( cr, 18 );
+    cairo_set_source_rgb( cr, 0, 0, 0 );
+    cairo_move_to( cr, 12, 26 );
+    cairo_show_text( cr, aTitle.utf8_str() );
+
+    struct LEG { double r, g, b; const char* t; } legs[] = {
+        { 0.62, 0.62, 0.62, "両方にある" }, { 0.85, 0.1, 0.1, "消えた(基準にだけある)" },
+        { 0.1, 0.65, 0.1, "増えた(比較にだけある)" }, { 0.1, 0.3, 0.95, "差のある場所" } };
+    double lx = 12;
+
+    cairo_set_font_size( cr, 15 );
+
+    for( const LEG& l : legs )
+    {
+        cairo_set_source_rgb( cr, l.r, l.g, l.b );
+        cairo_rectangle( cr, lx, 40, 18, 18 );
+        cairo_fill( cr );
+        cairo_set_source_rgb( cr, 0, 0, 0 );
+        cairo_move_to( cr, lx + 24, 54 );
+        cairo_show_text( cr, l.t );
+        cairo_text_extents_t ext;
+        cairo_text_extents( cr, l.t, &ext );
+        lx += 24 + ext.x_advance + 24;
+    }
+
+    cairo_translate( cr, 0, header );
+
+    auto fill = [&]( const SHAPE_POLY_SET& s, double r, double g, double b )
+    {
+        cairo_new_path( cr );
+        pathPolySet( cr, s, view, scale, margin );
+        cairo_set_source_rgb( cr, r, g, b );
+        cairo_fill( cr );
+    };
+
+    fill( aRes.overlap, 0.62, 0.62, 0.62 );
+    fill( aRes.removals, 0.85, 0.1, 0.1 );
+    fill( aRes.additions, 0.1, 0.65, 0.1 );
+
+    // 差のある場所を青枠と番号で囲む
+    cairo_set_line_width( cr, 2.5 );
+    cairo_set_font_size( cr, 16 );
+
+    for( size_t i = 0; i < aRegions.size() && i < 50; i++ )
+    {
+        BOX2I b = aRegions[i].box;
+        b.Inflate( (int) ( 0.4 * GERB_IU_PER_MM ) );
+        double x = margin + ( b.GetLeft() - view.GetLeft() ) * scale;
+        double y = margin + ( b.GetTop() - view.GetTop() ) * scale;
+        cairo_set_source_rgb( cr, 0.1, 0.3, 0.95 );
+        cairo_rectangle( cr, x, y, b.GetWidth() * scale, b.GetHeight() * scale );
+        cairo_stroke( cr );
+        cairo_move_to( cr, x, y - 4 );
+        cairo_show_text( cr, std::to_string( i + 1 ).c_str() );
+    }
+
+    cairo_destroy( cr );
+    cairo_status_t st = cairo_surface_write_to_png( surf, aPath.utf8_str() );
+    cairo_surface_destroy( surf );
+    return st == CAIRO_STATUS_SUCCESS;
+}
+
+
+struct DIFF_OUT
+{
+    bool                ok = false;
+    GERBER_DIFF_RESULT  res;
+    std::vector<REGION> regions;
+    wxString            error;
+};
+
+
+static DIFF_OUT diffFiles( const wxString& aRef, const wxString& aCmp, const wxString& aPng, int aDpi,
+                           const wxString& aTitle )
+{
+    DIFF_OUT out;
+    auto     ref = loadImage( aRef );
+    auto     cmp = loadImage( aCmp );
+
+    if( !ref || !cmp )
+    {
+        out.error = wxS( "読み込めない: " ) + ( ref ? aCmp : aRef );
+        return out;
+    }
+
+    SHAPE_POLY_SET pr = ConvertGerberToPolySet( ref.get() );
+    SHAPE_POLY_SET pc = ConvertGerberToPolySet( cmp.get() );
+
+    out.res = CalculateGerberDiff( pr, pc );
+    out.regions = findRegions( out.res.additions, out.res.removals, 0.0005 );
+    out.ok = true;
+
+    if( !aPng.IsEmpty() )
+        renderDiffPng( out.res, pr, pc, out.regions, aTitle, aPng, aDpi );
+
+    return out;
+}
+
+
+static wxString regionText( const REGION& r )
+{
+    // gerbview の内部座標は画面向き(Y 下向き)で、KiCad の基板座標と同じ向き・同じ原点になる
+    VECTOR2I c = r.box.Centre();
+    wxString what = r.addArea > 0 && r.remArea > 0 ? wxS( "形が変わった" )
+                    : r.addArea > 0                ? wxS( "増えた" )
+                                                   : wxS( "消えた" );
+    return wxString::Format( "中心 (%.2f, %.2f) 大きさ %.2f×%.2fmm  %s(+%.3f / -%.3f mm²)", mm( c.x ), mm( c.y ),
+                             mm( r.box.GetWidth() ), mm( r.box.GetHeight() ), what, r.addArea, r.remArea );
+}
+
+
+static int cmdInfo( const wxString& aPath )
+{
+    auto img = loadImage( aPath );
+
+    if( !img )
+    {
+        printf( "読み込めない: %s\n", (const char*) aPath.utf8_str() );
+        return 1;
+    }
+
+    SHAPE_POLY_SET p = ConvertGerberToPolySet( img.get() );
+    BOX2I          b = p.BBox();
+    int            flashes = 0, draws = 0;
+
+    for( GERBER_DRAW_ITEM* it : img->GetItems() )
+        ( it->m_Flashed ? flashes : draws )++;
+
+    printf( "%s\n", (const char*) aPath.utf8_str() );
+    printf( "  種類: %s\n", isExcellon( aPath ) ? "ドリル(Excellon)" : "ガーバー" );
+
+    if( img->m_FileFunction )
+        printf( "  用途(FileFunction): %s %s\n", (const char*) img->m_FileFunction->GetFileType().utf8_str(),
+                (const char*) img->m_FileFunction->GetBrdLayerId().utf8_str() );
+
+    printf( "  図形: %zu 個(フラッシュ %d / 線など %d)\n", img->GetItems().size(), flashes, draws );
+    printf( "  範囲: (%.2f, %.2f) - (%.2f, %.2f) mm、%.2f×%.2f mm\n", mm( b.GetLeft() ), mm( b.GetTop() ),
+            mm( b.GetRight() ), mm( b.GetBottom() ), mm( b.GetWidth() ), mm( b.GetHeight() ) );
+    printf( "  塗られている面積: %.2f mm²\n", p.Area() * 1e-10 );
+    return 0;
+}
+
+
+static void printDiff( const DIFF_OUT& d )
+{
+    printf( "  基準 %.2f mm² / 比較 %.2f mm² / 増えた %.3f mm² / 消えた %.3f mm²\n", d.res.referenceArea,
+            d.res.comparisonArea, d.res.additionsArea, d.res.removalsArea );
+
+    if( d.regions.empty() )
+    {
+        printf( "  差なし\n" );
+        return;
+    }
+
+    printf( "  差のある場所 %zu か所(面積の大きい順):\n", d.regions.size() );
+
+    for( size_t i = 0; i < d.regions.size() && i < 30; i++ )
+        printf( "    %2zu. %s\n", i + 1, (const char*) regionText( d.regions[i] ).utf8_str() );
+
+    if( d.regions.size() > 30 )
+        printf( "    ...ほか %zu か所\n", d.regions.size() - 30 );
+}
+
+
+static int cmdDirDiff( const wxString& aRefDir, const wxString& aCmpDir, const wxString& aOutDir, int aDpi )
+{
+    wxFileName::Mkdir( aOutDir, wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL );
+    wxDir                 dir( aRefDir );
+    wxString              name;
+    std::vector<wxString> names;
+
+    for( bool ok = dir.GetFirst( &name, wxEmptyString, wxDIR_FILES ); ok; ok = dir.GetNext( &name ) )
+        names.push_back( name );
+
+    std::sort( names.begin(), names.end() );
+
+    wxString md = wxS( "# 製造データの差分\n\n" );
+    md += wxS( "- 基準: `" ) + aRefDir + wxS( "`\n- 比較: `" ) + aCmpDir + wxS( "`\n" );
+    md += wxS( "- 画像: 灰=両方にある / 赤=消えた(基準にだけある) / 緑=増えた(比較にだけある) / 青枠=差のある場所\n" );
+    md += wxS( "- 座標は mm(KiCad の基板座標)\n\n" );
+    md += wxS( "| ファイル | 増えた mm² | 消えた mm² | 差のある場所 |\n|---|---:|---:|---:|\n" );
+    wxString details;
+    int      changed = 0;
+
+    for( const wxString& n : names )
+    {
+        wxString ext = wxFileName( n ).GetExt().Lower();
+
+        if( ext == wxS( "gbrjob" ) || ext == wxS( "md" ) || ext == wxS( "png" ) || ext == wxS( "json" ) )
+            continue;
+
+        wxFileName fr( aRefDir, n ), fc( aCmpDir, n );
+
+        if( !fc.FileExists() )
+        {
+            md += wxS( "| " ) + n + wxS( " | — | — | 比較側に無い |\n" );
+            continue;
+        }
+
+        wxString png = wxFileName( aOutDir, wxFileName( n ).GetName() + wxS( "_" ) + ext + wxS( "_diff.png" ) )
+                               .GetFullPath();
+        DIFF_OUT d = diffFiles( fr.GetFullPath(), fc.GetFullPath(), wxEmptyString, aDpi, n );
+
+        if( !d.ok )
+        {
+            md += wxS( "| " ) + n + wxS( " | — | — | " ) + d.error + wxS( " |\n" );
+            continue;
+        }
+
+        printf( "%s\n", (const char*) n.utf8_str() );
+        printDiff( d );
+
+        md += wxString::Format( "| %s | %.3f | %.3f | %zu |\n", n, d.res.additionsArea, d.res.removalsArea,
+                                d.regions.size() );
+
+        if( !d.regions.empty() )
+        {
+            changed++;
+            diffFiles( fr.GetFullPath(), fc.GetFullPath(), png, aDpi, n );   // 差がある層だけ画像にする
+            details += wxS( "\n## " ) + n + wxS( "\n\n![](" ) + wxFileName( png ).GetFullName() + wxS( ")\n\n" );
+
+            for( size_t i = 0; i < d.regions.size() && i < 30; i++ )
+                details += wxString::Format( "%zu. %s\n", i + 1, regionText( d.regions[i] ) );
+        }
+    }
+
+    // 比較側にだけあるファイル
+    wxDir dc( aCmpDir );
+
+    for( bool ok = dc.GetFirst( &name, wxEmptyString, wxDIR_FILES ); ok; ok = dc.GetNext( &name ) )
+        if( !wxFileName( aRefDir, name ).FileExists() && wxFileName( name ).GetExt().Lower() != wxS( "gbrjob" ) )
+            md += wxS( "| " ) + name + wxS( " | — | — | 基準側に無い |\n" );
+
+    md += wxString::Format( "\n差のあったファイル: %d\n", changed );
+    md += details;
+
+    wxFFile f( wxFileName( aOutDir, wxS( "差分まとめ.md" ) ).GetFullPath(), wxS( "w" ) );
+
+    if( f.IsOpened() )
+        f.Write( md, wxConvUTF8 );
+
+    printf( "\n差のあったファイル: %d(まとめ: %s/差分まとめ.md)\n", changed, (const char*) aOutDir.utf8_str() );
+    return 0;
+}
+
+
+static void usage()
+{
+    printf( "%s", R"(kicad-gerber: ガーバー/ドリルの情報と差分(KiCad 8.0.9 の gerbview の読み込み部品を使用)
+
+  kicad-gerber info <ファイル>
+  kicad-gerber diff <基準> <比較> [--png 出力.png] [--dpi N(既定 400)]
+  kicad-gerber dirdiff <基準フォルダ> <比較フォルダ> --out <出力フォルダ> [--dpi N]
+
+差分画像: 灰=両方にある / 赤=消えた(基準にだけある) / 緑=増えた(比較にだけある) / 青枠と番号=差のある場所
+基板ファイルどうしを比べるときは kicad-local fabdiff <基板A> <基板B> が便利(ガーバーとドリルを出して比べる)
+)" );
+}
+
+
+int main( int argc, char** argv )
+{
+    if( argc < 3 )
+    {
+        usage();
+        return argc < 2 ? 2 : 0;
+    }
+
+    wxInitialize( argc, argv );
+    int kifaceVersion = 0;
+    KIFACE_GETTER( &kifaceVersion, KIFACE_VERSION, &g_pgm );
+    g_pgm.InitPgm( true, true );
+
+    std::string              cmd = argv[1];
+    std::vector<std::string> pos;
+    wxString                 png, outDir;
+    int                      dpi = 400;
+
+    for( int i = 2; i < argc; i++ )
+    {
+        std::string a = argv[i];
+
+        if( a == "--png" && i + 1 < argc )
+            png = wxString::FromUTF8( argv[++i] );
+        else if( a == "--out" && i + 1 < argc )
+            outDir = wxString::FromUTF8( argv[++i] );
+        else if( a == "--dpi" && i + 1 < argc )
+            dpi = std::atoi( argv[++i] );
+        else
+            pos.push_back( a );
+    }
+
+    int rc = 2;
+
+    if( cmd == "info" && pos.size() == 1 )
+    {
+        rc = cmdInfo( wxString::FromUTF8( pos[0] ) );
+    }
+    else if( cmd == "diff" && pos.size() == 2 )
+    {
+        wxString a = wxString::FromUTF8( pos[0] ), b = wxString::FromUTF8( pos[1] );
+        DIFF_OUT d = diffFiles( a, b, png, dpi, wxFileName( a ).GetFullName() + wxS( " → " ) + wxFileName( b ).GetFullName() );
+
+        if( !d.ok )
+        {
+            printf( "%s\n", (const char*) d.error.utf8_str() );
+            rc = 1;
+        }
+        else
+        {
+            printDiff( d );
+
+            if( !png.IsEmpty() )
+                printf( "差分画像: %s\n", (const char*) png.utf8_str() );
+
+            rc = d.regions.empty() ? 0 : 1;   // 差があれば 1(スクリプトで判定しやすいように)
+        }
+    }
+    else if( cmd == "dirdiff" && pos.size() == 2 && !outDir.IsEmpty() )
+    {
+        rc = cmdDirDiff( wxString::FromUTF8( pos[0] ), wxString::FromUTF8( pos[1] ), outDir, dpi );
+    }
+    else
+    {
+        usage();
+    }
+
+    fflush( stdout );
+    std::_Exit( rc );
+}
