From aafd284b4eba990d9e9ca213e7bc9fc93e4a3050 Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Wed, 30 Sep 2026 17:10:03 +0900
Subject: [PATCH] AI chat (8.0.9): project settings (rules, net classes) are
 compared and restored on errors; the DRC copy gets the unsaved project
 settings; tell when the turn limit is hit (raised to 80); iso render zoomed
 out; keep the trim note

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../scripting/pcbnew_action_plugins.cpp       | 70 ++++++++++++++++++-
 scripting/kicad_ai/bridge.py                  | 26 ++++---
 2 files changed, 86 insertions(+), 10 deletions(-)

diff --git a/pcbnew/python/scripting/pcbnew_action_plugins.cpp b/pcbnew/python/scripting/pcbnew_action_plugins.cpp
index 7d5d79b..b4b4f0c 100644
--- a/pcbnew/python/scripting/pcbnew_action_plugins.cpp
+++ b/pcbnew/python/scripting/pcbnew_action_plugins.cpp
@@ -47,6 +47,10 @@
 #include <richio.h>
 #include <locale_io.h>
 #include <tool/actions.h>
+#include <project.h>
+#include <project/project_file.h>
+#include <project/net_settings.h>
+#include <settings/json_settings_internals.h>
 
 PYTHON_ACTION_PLUGIN::PYTHON_ACTION_PLUGIN( PyObject* aAction )
 {
@@ -679,6 +683,44 @@ static std::string formatBoardForCompare( BOARD* aBoard )
 }
 
 
+/// プロジェクトの設定（設計のルール・ネットクラスなど。.kicad_pro の中身）を文字にする
+static std::string formatProjectSettings( PROJECT& aProject )
+{
+    try
+    {
+        return aProject.GetProjectFile().FormatAsString();
+    }
+    catch( ... )
+    {
+        return std::string();
+    }
+}
+
+
+/// プロジェクトの設定を、formatProjectSettings で取った物に戻す（誤りの時の取り消し）
+static void restoreProjectSettings( PROJECT& aProject, BOARD* aBoard, const std::string& aJson )
+{
+    if( aJson.empty() )
+        return;
+
+    try
+    {
+        PROJECT_FILE& file = aProject.GetProjectFile();
+        *static_cast<nlohmann::json*>( file.Internals() ) = nlohmann::json::parse( aJson );
+        file.Load();
+        aBoard->GetDesignSettings().LoadFromFile();
+
+        if( file.NetSettings() )
+            file.NetSettings()->LoadFromFile();
+
+        aBoard->SynchronizeNetsAndNetClasses( true );
+    }
+    catch( ... )
+    {
+    }
+}
+
+
 static bool runAiCode( const std::string& aCode, wxString& aOutput )
 {
     PyLOCK lock;
@@ -754,6 +796,8 @@ wxString PCB_EDIT_FRAME::RunAiPython( const std::string& aCode, bool aWrite, con
     itemsList.ClearItemsList();
 
     const std::string before = formatBoardForCompare( pcb );
+    // 設計のルール・ネットクラスなどは基板のファイルでなくプロジェクトの側にあるので、別に控える
+    const std::string settingsBefore = formatProjectSettings( Prj() );
     BOARD_COMMIT      commit( this );
 
     ACTION_PLUGINS::SetActionRunning( true );
@@ -804,13 +848,31 @@ wxString PCB_EDIT_FRAME::RunAiPython( const std::string& aCode, bool aWrite, con
         addNew( zone );
 
     const bool changed = addedOrDeleted > 0 || formatBoardForCompare( pcb ) != before;
+    const bool settingsChanged = formatProjectSettings( Prj() ) != settingsBefore;
+
+    if( !aOk && settingsChanged )
+    {
+        // 誤りの時は、設計の設定も前に戻す
+        restoreProjectSettings( Prj(), pcb, settingsBefore );
+        output += wxString::FromUTF8( "（エラーのため、設計の設定の変更も取り消した）\n" );
+    }
+
+    const wxString settingsNote = wxString::FromUTF8(
+            "（設計の設定（ルール・ネットクラスなど）を変えた。これは「元に戻す」では戻らない"
+            "（KiCad の「基板の設定」と同じ）。基板を保存すると、プロジェクトのファイルに書かれる）\n" );
+
+    if( aOk && settingsChanged )
+        OnModify();
 
     if( !changed )
     {
-        // 変えなかった回は、空の「元に戻す」の段を作らない
+        // 基板を変えなかった回は、空の「元に戻す」の段を作らない
         ClearListAndDeleteItems( oldBuffer );
         delete oldBuffer;
-        output += wxString::FromUTF8( aOk ? "（基板は変えていない）\n" : "" );
+
+        if( aOk )
+            output += settingsChanged ? settingsNote : wxString::FromUTF8( "（基板は変えていない）\n" );
+
         return output;
     }
 
@@ -830,5 +892,9 @@ wxString PCB_EDIT_FRAME::RunAiPython( const std::string& aCode, bool aWrite, con
 
     output += wxString::FromUTF8( "（変更を基板へ反映した。「元に戻す」1 回で戻せる: " )
               + aDescription + wxS( "）\n" );
+
+    if( settingsChanged )
+        output += settingsNote;
+
     return output;
 }
