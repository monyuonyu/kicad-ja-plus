From 0b0fb9863346eb6cfefd88e682eeb0e1afc3669a Mon Sep 17 00:00:00 2001
From: shota <monyuonyu@gmail.com>
Date: Wed, 30 Sep 2026 15:42:54 +0900
Subject: [PATCH] MinGW: undo the Windows TRANSPARENT/OPAQUE macros for the
 render job; Python 3 names in the SWIG typemaps (newer SWIG has no
 PyInt/PyString aliases)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 common/jobs/job_pcb_render.h   |  7 +++++++
 common/swig/math.i             |  4 ++--
 common/swig/wx.i               | 20 ++++++++++----------
 pcbnew/pcbnew_jobs_handler.cpp |  3 +++
 4 files changed, 22 insertions(+), 12 deletions(-)

diff --git a/common/jobs/job_pcb_render.h b/common/jobs/job_pcb_render.h
index 7cf52b8..2561300 100644
--- a/common/jobs/job_pcb_render.h
+++ b/common/jobs/job_pcb_render.h
@@ -49,6 +49,13 @@ public:
         USER
     };
 
+    // Windows のヘッダー（wingdi.h）は TRANSPARENT・OPAQUE を定数にしていて、下の名前とぶつかる（MinGW で見つけた）
+#ifdef TRANSPARENT
+#undef TRANSPARENT
+#endif
+#ifdef OPAQUE
+#undef OPAQUE
+#endif
     enum class BG_STYLE
     {
         DEFAULT,
diff --git a/common/swig/math.i b/common/swig/math.i
index bc532b2..f99ed10 100644
--- a/common/swig/math.i
+++ b/common/swig/math.i
@@ -55,8 +55,8 @@
     PyObject* Get()
     {
         PyObject* tup = PyTuple_New(2);
-        PyTuple_SET_ITEM(tup, 0, PyInt_FromLong(self->x));
-        PyTuple_SET_ITEM(tup, 1, PyInt_FromLong(self->y));
+        PyTuple_SET_ITEM(tup, 0, PyLong_FromLong(self->x));
+        PyTuple_SET_ITEM(tup, 1, PyLong_FromLong(self->y));
         return tup;
     }
 
diff --git a/common/swig/wx.i b/common/swig/wx.i
index d846776..9a3ddff 100644
--- a/common/swig/wx.i
+++ b/common/swig/wx.i
@@ -79,10 +79,10 @@ public:
        PyObject* Get()
        {
             PyObject* res = PyTuple_New(4);
-            PyTuple_SET_ITEM(res, 0, PyInt_FromLong(self->x));
-            PyTuple_SET_ITEM(res, 1, PyInt_FromLong(self->y));
-            PyTuple_SET_ITEM(res, 2, PyInt_FromLong(self->width));
-            PyTuple_SET_ITEM(res, 3, PyInt_FromLong(self->height));
+            PyTuple_SET_ITEM(res, 0, PyLong_FromLong(self->x));
+            PyTuple_SET_ITEM(res, 1, PyLong_FromLong(self->y));
+            PyTuple_SET_ITEM(res, 2, PyLong_FromLong(self->width));
+            PyTuple_SET_ITEM(res, 3, PyLong_FromLong(self->height));
             return res;
         }
     }
@@ -122,8 +122,8 @@ public:
        PyObject* Get()
        {
             PyObject* res = PyTuple_New(2);
-            PyTuple_SET_ITEM(res, 0, PyInt_FromLong(self->x));
-            PyTuple_SET_ITEM(res, 1, PyInt_FromLong(self->y));
+            PyTuple_SET_ITEM(res, 0, PyLong_FromLong(self->x));
+            PyTuple_SET_ITEM(res, 1, PyLong_FromLong(self->y));
             return res;
         }
     }
@@ -174,8 +174,8 @@ public:
         PyObject* Get()
         {
             PyObject* tup = PyTuple_New(2);
-            PyTuple_SET_ITEM(tup, 0, PyInt_FromLong(self->x));
-            PyTuple_SET_ITEM(tup, 1, PyInt_FromLong(self->y));
+            PyTuple_SET_ITEM(tup, 0, PyLong_FromLong(self->x));
+            PyTuple_SET_ITEM(tup, 1, PyLong_FromLong(self->y));
             return tup;
         }
     }
@@ -255,7 +255,7 @@ public:
     %#if wxUSE_UNICODE
             return PyUnicode_FromWideChar( $self->c_str(), $self->Len() );
     %#else
-            return PyString_FromStringAndSize( $self->c_str(), $self->Len() );
+            return PyUnicode_FromStringAndSize( $self->c_str(), $self->Len() );
     %#endif
         }
     }
@@ -301,7 +301,7 @@ public:
 
 
 %typemap(typecheck, precedence=SWIG_TYPECHECK_POINTER) wxString& {
-    $1 = PyString_Check($input) || PyUnicode_Check($input);
+    $1 = PyBytes_Check($input) || PyUnicode_Check($input);
 }
 
 %apply wxString& { wxString* }
diff --git a/pcbnew/pcbnew_jobs_handler.cpp b/pcbnew/pcbnew_jobs_handler.cpp
index bc9cc09..5b18d91 100644
--- a/pcbnew/pcbnew_jobs_handler.cpp
+++ b/pcbnew/pcbnew_jobs_handler.cpp
@@ -1340,6 +1340,9 @@ int PCBNEW_JOBS_HANDLER::JobExportRender( JOB* aJob )
     if( aRenderJob == nullptr )
         return CLI::EXIT_CODES::ERR_UNKNOWN;
 
+#ifdef TRANSPARENT     // Windows のヘッダーの定数（job_pcb_render.h を参照）
+#undef TRANSPARENT
+#endif
     if( aRenderJob->m_bgStyle == JOB_PCB_RENDER::BG_STYLE::TRANSPARENT )
     {
         m_reporter->Report( _( "Transparent background is not supported in this build; "
-- 
2.43.0

