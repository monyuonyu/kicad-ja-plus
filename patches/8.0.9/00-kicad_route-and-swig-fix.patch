+
+// 部品の外形枠が他と重ならないか(aDelta だけ動かした場合)
+static FOOTPRINT* courtyardHit( CTX& c, FOOTPRINT* aFp, const VECTOR2I& aDelta )
+{
+    for( PCB_LAYER_ID side : { F_CrtYd, B_CrtYd } )
+    {
+        SHAPE_POLY_SET mine = aFp->GetCourtyard( side );
+
+        if( mine.OutlineCount() == 0 )
+            continue;
+
+        mine.Move( aDelta );
+        BOX2I mbox = mine.BBox();
+
+        for( FOOTPRINT* other : c.board->Footprints() )
+        {
+            if( other == aFp )
+                continue;
+
+            const SHAPE_POLY_SET& theirs = other->GetCourtyard( side );
+
+            if( theirs.OutlineCount() == 0 || !mbox.Intersects( theirs.BBox() ) )
+                continue;
+
+            SHAPE_POLY_SET inter = mine;
+            inter.BooleanIntersection( theirs, SHAPE_POLY_SET::PM_FAST );
+
+            if( inter.OutlineCount() > 0 && inter.Area() > 0 )
+                return other;
+        }
+    }
+
+    return nullptr;
+}
+
+
+
+// ---- シルク: 動かした部品の部品番号の文字を、重ならない近くへ移す ----
+
+// 文字の外形(回転込み)。EDA_TEXT::GetTextBox() は回転を考慮しないので使わない
+static BOX2I textBox( const BOARD_ITEM* aText )
+{
+    return aText->GetBoundingBox();
+}
+
+
+struct SILK_OBST
+{
+    enum { K_BOX, K_SEG, K_CIRCLE } kind;
+    BOX2I    box;
+    SEG      seg;         // SEG
+    VECTOR2I center;      // CIRCLE
+    int      radius = 0;  // CIRCLE
+    int      halfWidth = 0;
+    bool     soft = false;   // 外形枠の内側: 移し先を探すときだけ避ける(重なりの判定には使わない)
+};
+
+
+static void addSilkShape( std::vector<SILK_OBST>& aObs, BOARD_ITEM* aItem )
+{
+    if( aItem->Type() == PCB_SHAPE_T )
+    {
+        PCB_SHAPE* sh = static_cast<PCB_SHAPE*>( aItem );
+
+        if( sh->GetShape() == SHAPE_T::SEGMENT )
+        {
+            SILK_OBST o{ SILK_OBST::K_SEG, sh->GetBoundingBox(), SEG( sh->GetStart(), sh->GetEnd() ) };
+            o.halfWidth = sh->GetWidth() / 2;
+            aObs.push_back( o );
+            return;
+        }
+
+        if( sh->GetShape() == SHAPE_T::CIRCLE && !sh->IsFilled() )
+        {
+            SILK_OBST o{ SILK_OBST::K_CIRCLE, sh->GetBoundingBox() };
+            o.center = sh->GetCenter();
+            o.radius = sh->GetRadius();
+            o.halfWidth = sh->GetWidth() / 2;
+            aObs.push_back( o );
+            return;
+        }
+    }
+
+    BOX2I b = aItem->GetBoundingBox();   // 文字は回転込みの外形
+    aObs.push_back( SILK_OBST{ SILK_OBST::K_BOX, b } );
+}
+
+
+// 箱 aBox(余白 aClr 込み)が障害物にかかるか。線と円は形そのもので判定する
+static bool silkHit( const SILK_OBST& o, const BOX2I& aBox, int aClr )
+{
+    BOX2I b = aBox;
+    b.Inflate( aClr );
+
+    if( !b.Intersects( o.box ) )
+        return false;
+
+    if( o.kind == SILK_OBST::K_BOX )
+        return true;
+
+    SHAPE_RECT rect( b.GetPosition(), b.GetWidth(), b.GetHeight() );
+
+    if( o.kind == SILK_OBST::K_SEG )
+        return rect.Collide( o.seg, o.halfWidth );
+
+    // 円(輪): 箱の中心からの最近・最遠距離の間に半径が入れば交わる
+    VECTOR2I c = o.center;
+    double   dx = std::max( { (double) b.GetLeft() - c.x, 0.0, (double) c.x - b.GetRight() } );
+    double   dy = std::max( { (double) b.GetTop() - c.y, 0.0, (double) c.y - b.GetBottom() } );
+    double   dmin = std::hypot( dx, dy );
+    double   dmax = 0;
+
+    for( int x : { b.GetLeft(), b.GetRight() } )
+        for( int y : { b.GetTop(), b.GetBottom() } )
+            dmax = std::max( dmax, std::hypot( (double) x - c.x, (double) y - c.y ) );
+
+    return dmin - o.halfWidth <= o.radius && o.radius <= dmax + o.halfWidth;
+}
+
+
+static std::vector<SILK_OBST> silkObstacles( BOARD* aBoard, FOOTPRINT* aSelf, PCB_LAYER_ID aSilk,
+                                             PCB_LAYER_ID aMask )
+{
+    std::vector<SILK_OBST> obs;
+
+    for( FOOTPRINT* fp : aBoard->Footprints() )
+    {
+        for( PAD* pad : fp->Pads() )   // 自分のパッドも含む(文字がパッドにかからないように)
+            if( pad->IsOnLayer( aMask ) )
+                obs.push_back( SILK_OBST{ SILK_OBST::K_BOX, pad->GetBoundingBox() } );
+
+        for( BOARD_ITEM* g : fp->GraphicalItems() )
+            if( g->GetLayer() == aSilk && !( fp == aSelf && g->Type() == PCB_TEXT_T ) )
+                addSilkShape( obs, g );
+
+        // 部品の本体(外形枠の内側)には文字を置かない: 外形線に触れなくても実物の本体に隠れる
+        // (自分の本体も同じ。部品番号は本体の外側の近くに置く)
+        const SHAPE_POLY_SET& crt = fp->GetCourtyard( IsBackLayer( aSilk ) ? B_CrtYd : F_CrtYd );
+
+        if( crt.OutlineCount() )
+        {
+            SILK_OBST o{ SILK_OBST::K_BOX, crt.BBox() };
+            o.soft = true;
+            obs.push_back( o );
+        }
+
+        if( fp == aSelf )
+            continue;
+
+        for( PCB_FIELD* f : fp->Fields() )
+            if( f->IsVisible() && f->GetLayer() == aSilk )
+                obs.push_back( SILK_OBST{ SILK_OBST::K_BOX, f->GetBoundingBox() } );
+
+    }
+
+    for( BOARD_ITEM* d : aBoard->Drawings() )
+        if( d->GetLayer() == aSilk )
+            addSilkShape( obs, d );
+
+    return obs;
+}
+
+
+// 部品 aFp の部品番号の文字が、何か(パッド・シルク・他の文字・基板外)に重なっていれば、
+// 部品本体の近くの空きへ移す。移したら説明を返す。置けなければ aFailed に説明を入れる
+static wxString relocateRef( CTX& c, FOOTPRINT* aFp, wxString* aFailed )
+{
+    PCB_FIELD& ref = aFp->Reference();
+
+    if( !ref.IsVisible() )
+        return wxString();
+
+    PCB_LAYER_ID           silk = ref.GetLayer();
+    PCB_LAYER_ID           mask = IsBackLayer( silk ) ? B_Mask : F_Mask;
+    std::vector<SILK_OBST> obs = silkObstacles( c.board, aFp, silk, mask );
+    BOX2I                  edge = c.board->GetBoardEdgesBoundingBox();
+    edge.Inflate( -pcbIUScale.mmToIU( 0.3 ) );
+    const int clr = pcbIUScale.mmToIU( 0.15 );
+
+    auto fits = [&]( const BOX2I& aBox, bool aAvoidSoft )
+    {
+        if( !edge.Contains( aBox ) )
+            return false;
+
+        for( const SILK_OBST& o : obs )
+            if( ( aAvoidSoft || !o.soft ) && silkHit( o, aBox, clr ) )
+                return false;
+
+        return true;
+    };
+
+    VECTOR2I  p0 = ref.GetTextPos();
+    EDA_ANGLE a0 = ref.GetTextAngle();
+
+    if( fits( textBox( &ref ), false ) )   // 本当の重なりが無ければ動かさない
+        return wxString();
+
+    // 部品本体の中心から近い順に(0.25mm 刻みで 6mm まで)、元の向き・90° 回した向きの両方で探す
+    VECTOR2I center = aFp->GetBoundingBox( false, false ).Centre();
+
+    for( int r = 1; r <= 24; r++ )
+    {
+        double rad = r * 0.25;
+        int    n = 8 * r;
+
+        for( EDA_ANGLE ang : { a0, a0 + ANGLE_90 } )
+        {
+            ref.SetTextAngle( ang );
+
+            for( int k = 0; k < n; k++ )
+            {
+                double   a = 2 * M_PI * k / n;
+                VECTOR2I p = center + VECTOR2I( pcbIUScale.mmToIU( rad * cos( a ) ),
+                                                pcbIUScale.mmToIU( rad * sin( a ) ) );
+                ref.SetTextPos( p );
+
+                if( fits( textBox( &ref ), true ) )
+                    return wxString::Format( "部品番号 %s の文字を %s → %s%s へ移動", aFp->GetReference(),
+                                             fmtPt( p0 ), fmtPt( p ),
+                                             ang == a0 ? wxString() : wxString( wxS( "(90°回転)" ) ) );
+            }
+        }
+    }
+
+    ref.SetTextAngle( a0 );
+    ref.SetTextPos( p0 );
+
+    if( aFailed )
+        *aFailed = wxS( "部品番号 " ) + aFp->GetReference() + wxS( " の文字の置き場所が近くに無い(手で調整)" );
+
+    return wxString();
+}
+
+
+// 部品の文字が今どこかに重なっているか
+static bool refOverlaps( CTX& c, FOOTPRINT* aFp )
+{
+    PCB_FIELD& ref = aFp->Reference();
+
+    if( !ref.IsVisible() )
+        return false;
+
+    PCB_LAYER_ID silk = ref.GetLayer();
+    PCB_LAYER_ID mask = IsBackLayer( silk ) ? B_Mask : F_Mask;
+
+    for( const SILK_OBST& o : silkObstacles( c.board, aFp, silk, mask ) )
+        if( !o.soft && silkHit( o, textBox( &ref ), 0 ) )
+            return true;
+
+    return false;
+}
+
+
+// 部品を動かしたあとのシルクの手当て(押しのけ配線と同じ考え方):
+//  1) 動かした部品の文字が重なっていれば近くの空きへ移す
+//  2) 動かした部品のまわりで、移動のせいで重なりができた他の部品の文字も、その部品の近くの空きへ移す
+//     (移動前から重なっていたものには触らない)
+static wxString fixReferenceSilk( CTX& c, FOOTPRINT* aFp, const std::set<FOOTPRINT*>& aOverlappedBefore = {} )
+{
+    wxString notes, failed;
+    wxString m = relocateRef( c, aFp, &failed );
+
+    if( !m.IsEmpty() )
+        notes += wxS( " / " ) + m;
+
+    if( !failed.IsEmpty() )
+        notes += wxS( " / " ) + failed;
+
+    BOX2I area = aFp->GetBoundingBox( true, false );
+    area.Inflate( pcbIUScale.mmToIU( 2.0 ) );
+
+    for( FOOTPRINT* fp : c.board->Footprints() )
+    {
+        if( fp == aFp || aOverlappedBefore.count( fp ) || !fp->Reference().IsVisible() )
+            continue;
+
+        if( !area.Intersects( textBox( &fp->Reference() ) ) || !refOverlaps( c, fp ) )
+            continue;
+
+        failed.clear();
+        m = relocateRef( c, fp, &failed );
+
+        if( !m.IsEmpty() )
+            notes += wxS( " / " ) + m + wxS( "(押し出し)" );
+
+        if( !failed.IsEmpty() )
+            notes += wxS( " / " ) + failed;
+    }
+
+    return notes;
+}
+
+
+// 移動前から文字が重なっていた部品(これらは押し出しの対象にしない)
+static std::set<FOOTPRINT*> overlappedRefs( CTX& c )
+{
+    std::set<FOOTPRINT*> out;
+
+    for( FOOTPRINT* fp : c.board->Footprints() )
+        if( refOverlaps( c, fp ) )
+            out.insert( fp );
+
+    return out;
+}
+
+
+static bool doDrag( CTX& c, const wxString& aRef, const VECTOR2I& aDelta )
+{
+    FOOTPRINT* fp = findFp( c.board, aRef );
+
+    if( !fp )
+    {
+        msg( "  %d行: NG 部品 %s がない\n", aRef );
+        return false;
+    }
+
+    // ルーターは銅箔しか見ないので、部品の外形枠(コートヤード)の重なりは先に自分で確かめる
+    if( FOOTPRINT* other = courtyardHit( c, fp, aDelta ) )
+    {
+        msg( "  %d行: NG %s\n", aRef + wxS( " を動かすと " ) + other->GetReference()
+                                 + wxS( " と部品の外形枠(コートヤード)が重なる" ) );
+        return false;
+    }
+
+    std::set<FOOTPRINT*> overlappedBefore = overlappedRefs( c );
+
+    c.Sync();
+    PNS::ITEM_SET set;
+
+    for( PAD* pad : fp->Pads() )
+    {
+        PNS::ITEM* it = c.router->GetWorld()->FindItemByParent( pad );
+
+        if( it )
+            set.Add( it );
+    }
+
+    if( set.Empty() )
+    {
+        msg( "  %d行: NG 部品 %s のパッドがルーターに登録されていない\n", aRef );
+        return false;
+    }
+
+    VECTOR2I p0 = fp->GetPosition();
+
+    if( !c.router->StartDragging( p0, set, PNS::DM_COMPONENT ) )
+    {
+        msg( "  %d行: NG %s をつかめない\n", aRef + wxS( " " ) + c.router->FailureReason() );
+        return false;
+    }
+
+    c.router->Move( p0 + aDelta, nullptr );
+
+    if( !c.router->FixRoute( p0 + aDelta, nullptr, false, false ) )
+    {
+        msg( "  %d行: NG %s を動かせない(つながった線を迂回・押しのけで引き直せない)\n", aRef );
+        c.router->StopRouting();
+        return false;
+    }
+
+    c.router->StopRouting();
+    fp->BuildCourtyardCaches();
+    c.dirty = true;
+
+    wxString silkNote = fixReferenceSilk( c, fp, overlappedBefore );
+
+    if( !silkNote.IsEmpty() )
+        msg( "  %d行: シルク%s\n", silkNote );
+
+    return true;
+}
+
+
+// ---- 置き場所の判定(findspace / place の回転) ----
+
+struct OBST
+{
+    std::shared_ptr<SHAPE> shape;
+    BOX2I                  bb;
+    int                    net;
+    PCB_LAYER_ID           layer;
+};
+
+struct FP_PAD_COPPER
+{
+    std::unique_ptr<SHAPE> shape;   // 部品原点 (0,0) 基準
+    int                    net;
+    PCB_LAYER_ID           layer;
+};
+
+struct FP_AT_ROT
+{
+    SHAPE_POLY_SET          crt[2];   // F_CrtYd, B_CrtYd (原点基準)
+    std::vector<FP_PAD_COPPER>  pads;
+    std::vector<std::pair<VECTOR2I, int>> padPos;   // (原点基準の位置, ネット)
+};
+
+
+static int clearanceOf( BOARD* aBoard )
+{
+    BOARD_DESIGN_SETTINGS& bds = aBoard->GetDesignSettings();
+    int                    cl = bds.m_MinClearance;
+
+    if( bds.m_NetSettings && bds.m_NetSettings->m_DefaultNetClass )
+        cl = std::max( cl, bds.m_NetSettings->m_DefaultNetClass->GetClearance() );
+
+    return cl;
+}
+
+
+static std::vector<OBST> collectObstacles( BOARD* aBoard, FOOTPRINT* aExclude )
+{
+    std::vector<OBST> obs;
+
+    for( FOOTPRINT* fp : aBoard->Footprints() )
+    {
+        if( fp == aExclude )
+            continue;
+
+        for( PAD* pad : fp->Pads() )
+        {
+            for( PCB_LAYER_ID L : { F_Cu, B_Cu } )
+            {
+                if( !pad->IsOnLayer( L ) || !pad->FlashLayer( L ) )
+                    continue;
+
+                std::shared_ptr<SHAPE> sh = pad->GetEffectiveShape( L );
+                obs.push_back( { sh, sh->BBox(), pad->GetNetCode(), L } );
+            }
+        }
+    }
+
+    for( PCB_TRACK* t : aBoard->Tracks() )
+    {
+        for( PCB_LAYER_ID L : { F_Cu, B_Cu } )
+        {
+            if( !t->IsOnLayer( L ) )
+                continue;
+
+            std::shared_ptr<SHAPE> sh = t->GetEffectiveShape( L );
+            obs.push_back( { sh, sh->BBox(), t->GetNetCode(), L } );
+        }
+    }
+
+    return obs;
+}
+
+
+static FP_AT_ROT shapesAtRotation( FOOTPRINT* aFp, const EDA_ANGLE& aRot )
+{
+    VECTOR2I  savedPos = aFp->GetPosition();
+    EDA_ANGLE savedRot = aFp->GetOrientation();
+    FP_AT_ROT r;
+
+    aFp->SetPosition( VECTOR2I( 0, 0 ) );
+    aFp->SetOrientation( aRot );
+    aFp->BuildCourtyardCaches();
+    r.crt[0] = aFp->GetCourtyard( F_CrtYd );
+    r.crt[1] = aFp->GetCourtyard( B_CrtYd );
+
+    for( PAD* pad : aFp->Pads() )
+    {
+        r.padPos.emplace_back( pad->GetPosition(), pad->GetNetCode() );
+
+        for( PCB_LAYER_ID L : { F_Cu, B_Cu } )
+            if( pad->IsOnLayer( L ) && pad->FlashLayer( L ) )
+                r.pads.push_back( { std::unique_ptr<SHAPE>( pad->GetEffectiveShape( L )->Clone() ),
+                                    pad->GetNetCode(), L } );
+    }
+
+    aFp->SetOrientation( savedRot );
+    aFp->SetPosition( savedPos );
+    aFp->BuildCourtyardCaches();
+    return r;
+}
+
+
+static bool fitsAt( CTX& c, FOOTPRINT* aFp, FP_AT_ROT& aShapes, const VECTOR2I& aPos,
+                    const std::vector<OBST>& aObs, int aClearance, const BOX2I& aEdge, wxString* aWhy )
+{
+    for( int s = 0; s < 2; s++ )
+    {
+        if( aShapes.crt[s].OutlineCount() == 0 )
+            continue;
+
+        SHAPE_POLY_SET mine = aShapes.crt[s];
+        mine.Move( aPos );
+        BOX2I mb = mine.BBox();
+
+        if( !aEdge.Contains( mb ) )
+        {
+            if( aWhy ) *aWhy = wxS( "基板の外にはみ出す" );
+            return false;
+        }
+
+        for( FOOTPRINT* other : c.board->Footprints() )
+        {
+            if( other == aFp )
+                continue;
+
+            const SHAPE_POLY_SET& theirs = other->GetCourtyard( s == 0 ? F_CrtYd : B_CrtYd );
+
+            if( theirs.OutlineCount() == 0 || !mb.Intersects( theirs.BBox() ) )
+                continue;
+
+            SHAPE_POLY_SET inter = mine;
+            inter.BooleanIntersection( theirs, SHAPE_POLY_SET::PM_FAST );
+
+            if( inter.OutlineCount() > 0 && inter.Area() > 0 )
+            {
+                if( aWhy ) *aWhy = other->GetReference() + wxS( " と外形枠が重なる" );
+                return false;
+            }
+        }
+    }
+
+    for( FP_PAD_COPPER& ps : aShapes.pads )
+    {
+        ps.shape->Move( aPos );
+        BOX2I pb = ps.shape->BBox();
+        pb.Inflate( aClearance );
+        bool bad = false;
+
+        for( const OBST& o : aObs )
+        {
+            if( o.layer != ps.layer || ( ps.net > 0 && o.net == ps.net ) || !pb.Intersects( o.bb ) )
+                continue;
+
+            if( ps.shape->Collide( o.shape.get(), aClearance ) )
+            {
+                if( aWhy ) *aWhy = wxS( "端子が既存の銅箔(配線・パッド)にクリアランス不足" );
+                bad = true;
+                break;
+            }
+        }
+
+        ps.shape->Move( VECTOR2I( -aPos.x, -aPos.y ) );
+
+        if( bad )
+            return false;
+    }
+
+    return true;
+}
+
+
+static double ratsnestMm( CTX& c, FOOTPRINT* aFp, const FP_AT_ROT& aShapes, const VECTOR2I& aPos )
+{
+    double total = 0;
+
+    for( const auto& [rel, net] : aShapes.padPos )
+    {
+        if( net <= 0 )
+            continue;
+
+        double best = 1e18;
+
+        for( FOOTPRINT* fp : c.board->Footprints() )
+        {
+            if( fp == aFp )
+                continue;
+
+            for( PAD* pad : fp->Pads() )
+                if( pad->GetNetCode() == net )
+                    best = std::min( best, mm( ( pad->GetPosition() - ( rel + aPos ) ).EuclideanNorm() ) );
+        }
+
+        if( best < 1e17 )
+            total += best;
+    }
+
+    return total;
+}
+
+
+static bool doFindspace( CTX& c, const wxString& aRef, double aStepMm, const BOX2I* aArea )
+{
+    FOOTPRINT* fp = findFp( c.board, aRef );
+
+    if( !fp )
+    {
+        msg( "  %d行: NG 部品 %s がない\n", aRef );
+        return false;
+    }
+
+    BOX2I edge = c.board->GetBoardEdgesBoundingBox();
+    edge.Inflate( -pcbIUScale.mmToIU( 0.3 ) );
+    BOX2I area = aArea ? *aArea : edge;
+    int   step = pcbIUScale.mmToIU( aStepMm );
+    int   cl = clearanceOf( c.board );
+    std::vector<OBST> obs = collectObstacles( c.board, fp );
+
+    struct CAND { double cost; VECTOR2I pos; int rot; };
+    std::vector<CAND> found;
+    long checked = 0;
+
+    for( int rot : { 0, 90, 180, 270 } )
+    {
+        FP_AT_ROT shapes = shapesAtRotation( fp, EDA_ANGLE( (double) rot, DEGREES_T ) );
+
+        for( int x = area.GetLeft(); x <= area.GetRight(); x += step )
+        {
+            for( int y = area.GetTop(); y <= area.GetBottom(); y += step )
+            {
+                VECTOR2I p( x, y );
+                checked++;
+
+                if( fitsAt( c, fp, shapes, p, obs, cl, edge, nullptr ) )
+                    found.push_back( { ratsnestMm( c, fp, shapes, p ), p, rot } );
+            }
+        }
+    }
+
+    std::sort( found.begin(), found.end(), []( const CAND& a, const CAND& b ) { return a.cost < b.cost; } );
+
+    msg( "  %d行: %s\n", wxString::Format( "%s の置き場所: %zu か所が候補(%ld 通り調べた、クリアランス %.2fmm)。つながる端子までの距離が短い順:",
+                                            aRef, found.size(), checked, mm( cl ) ) );
+
+    std::vector<CAND> shown;
+
+    for( const CAND& cd : found )
+    {
+        bool near = false;
+
+        for( const CAND& s : shown )
+            if( ( s.pos - cd.pos ).EuclideanNorm() < pcbIUScale.mmToIU( 1.5 ) )
+                near = true;
+
+        if( near )
+            continue;
+
+        shown.push_back( cd );
+        printf( "      place %s %.2f,%.2f %d    # 端子までの距離 計 %.1fmm\n",
+                (const char*) aRef.utf8_str(), mm( cd.pos.x ), mm( cd.pos.y ), cd.rot, cd.cost );
+
+        if( shown.size() >= 8 )
+            break;
+    }
+
+    fflush( stdout );
+    return true;
+}
+
+
+static bool padsHaveTracks( CTX& c, FOOTPRINT* aFp )
+{
+    for( PAD* pad : aFp->Pads() )
+    {
+        if( pad->GetNetCode() <= 0 )
+            continue;
+
+        for( PCB_TRACK* t : c.board->Tracks() )
+        {
+            if( t->GetNetCode() != pad->GetNetCode() )
+                continue;
+
+            if( pad->HitTest( t->GetStart() ) || pad->HitTest( t->GetEnd() ) )
+                return true;
+        }
+    }
+
+    return false;
+}
+
+
+static bool doPlace( CTX& c, const wxString& aRef, const VECTOR2I& aPos, std::optional<double> aRot )
+{
+    FOOTPRINT* fp = findFp( c.board, aRef );
+
+    if( !fp )
+    {
+        msg( "  %d行: NG 部品 %s がない\n", aRef );
+        return false;
+    }
+
+    if( !aRot || std::abs( fp->GetOrientation().AsDegrees() - *aRot ) < 0.01
+        || std::abs( std::abs( fp->GetOrientation().AsDegrees() - *aRot ) - 360 ) < 0.01 )
+    {
+        return doDrag( c, aRef, aPos - fp->GetPosition() );
+    }
+
+    if( padsHaveTracks( c, fp ) )
+    {
+        msg( "  %d行: NG %s は配線がつながっているので回転できない(先に unroute するか、角度はそのままで)\n", aRef );
+        return false;
+    }
+
+    BOX2I edge = c.board->GetBoardEdgesBoundingBox();
+    edge.Inflate( -pcbIUScale.mmToIU( 0.3 ) );
+    FP_AT_ROT shapes = shapesAtRotation( fp, EDA_ANGLE( *aRot, DEGREES_T ) );
+    wxString  why;
+
+    if( !fitsAt( c, fp, shapes, aPos, collectObstacles( c.board, fp ), clearanceOf( c.board ), edge, &why ) )
+    {
+        msg( "  %d行: NG %s\n", aRef + wxS( " をそこに置けない: " ) + why );
+        return false;
+    }
+
+    std::set<FOOTPRINT*> overlappedBefore = overlappedRefs( c );
+
+    fp->SetOrientation( EDA_ANGLE( *aRot, DEGREES_T ) );
+    fp->SetPosition( aPos );
+    fp->BuildCourtyardCaches();
+    c.dirty = true;
+
+    wxString silkNote = fixReferenceSilk( c, fp, overlappedBefore );
+
+    if( !silkNote.IsEmpty() )
+        msg( "  %d行: シルク%s\n", silkNote );
+
+    return true;
+}
+
+
+static void listUnconnected( BOARD* aBoard )
+{
+    std::set<wxString> lines;
+
+    aBoard->GetConnectivity()->RunOnUnconnectedEdges(
+            [&]( CN_EDGE& aEdge )
+            {
+                auto a = aEdge.GetSourceNode();
+                auto b = aEdge.GetTargetNode();
+                wxString sa = describe( a->Parent(), a->Pos() );
+                wxString sb = describe( b->Parent(), b->Pos() );
+
+                if( sb < sa )
+                    std::swap( sa, sb );
+
+                lines.insert( sa + wxS( " ― " ) + sb + wxS( "  [" ) + a->Parent()->GetNetname()
+                              + wxS( "]" ) );
+                return true;
+            } );
+
+    if( lines.empty() )
+    {
+        printf( "未配線: なし\n" );
+        return;
+    }
+
+    printf( "未配線 %zu か所:\n", lines.size() );
+
+    for( const wxString& l : lines )
+        printf( "    %s\n", (const char*) l.utf8_str() );
+}
