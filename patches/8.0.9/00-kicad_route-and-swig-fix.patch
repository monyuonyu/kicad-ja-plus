+
+static wxString fmtPt( const VECTOR2I& p )
+{
+    return wxString::Format( "(%.2f, %.2f)", pcbIUScale.IUTomm( p.x ), pcbIUScale.IUTomm( p.y ) );
+}
+
+
+static double mm( int aIU )
+{
+    return pcbIUScale.IUTomm( aIU );
+}
+
+
+static FOOTPRINT* findFp( BOARD* aBoard, const wxString& aRef )
+{
+    for( FOOTPRINT* f : aBoard->Footprints() )
+        if( f->GetReference() == aRef )
+            return f;
+
+    return nullptr;
+}
+
+
+// 「部品番号.端子番号」→ パッド
+static PAD* findPad( BOARD* aBoard, const std::string& aTok )
+{
+    size_t dot = aTok.rfind( '.' );
+
+    if( dot == std::string::npos || dot == 0 )
+        return nullptr;
+
+    FOOTPRINT* fp = findFp( aBoard, wxString::FromUTF8( aTok.substr( 0, dot ) ) );
+
+    if( !fp )
+        return nullptr;
+
+    wxString num = wxString::FromUTF8( aTok.substr( dot + 1 ) );
+
+    for( PAD* pad : fp->Pads() )
+        if( pad->GetNumber() == num )
+            return pad;
+
+    return nullptr;
+}
+
+
+// 「x,y」または「部品番号.端子番号」を座標にする
+static bool parsePt( BOARD* aBoard, const std::string& aTok, VECTOR2I& aOut )
+{
+    double x, y;
+    char   comma;
+    std::istringstream is( aTok );
+
+    if( ( is >> x >> comma >> y ) && comma == ',' )
+    {
+        aOut = VECTOR2I( pcbIUScale.mmToIU( x ), pcbIUScale.mmToIU( y ) );
+        return true;
+    }
+
+    if( PAD* pad = findPad( aBoard, aTok ) )
+    {
+        aOut = pad->GetPosition();
+        return true;
+    }
+
+    return false;
+}
+
+
+static wxString describe( const BOARD_ITEM* aItem, const VECTOR2I& aPos )
+{
+    if( aItem && aItem->Type() == PCB_PAD_T )
+    {
+        const PAD* pad = static_cast<const PAD*>( aItem );
+        return pad->GetParentFootprint()->GetReference() + wxS( "." ) + pad->GetNumber();
+    }
+
+    wxString kind = !aItem                           ? wxS( "?" )
+                    : aItem->Type() == PCB_VIA_T     ? wxS( "ビア" )
+                    : aItem->Type() == PCB_ZONE_T    ? wxS( "ベタ" )
+                                                     : wxS( "配線" );
+    wxString extra;
+
+    if( aItem && aItem->IsConnected() )
+    {
+        const BOARD_CONNECTED_ITEM* ci = static_cast<const BOARD_CONNECTED_ITEM*>( aItem );
+        extra = wxS( "[" ) + ci->GetNetname()
+                + ( aItem->Type() == PCB_VIA_T ? wxString() : wxS( " " ) + aItem->GetLayerName() )
+                + wxS( "]" );
+    }
+
+    return kind + fmtPt( aPos ) + extra;
+}
+
+
+// 指定点・層にある、ネットを持つ配線対象を選ぶ(パッド > ビア > 配線)
+static PNS::ITEM* pickItem( PNS::ROUTER* aRouter, const VECTOR2I& aP, int aLayer )
+{
+    PNS::ITEM_SET items = aRouter->QueryHoverItems( aP );
+    PNS::ITEM*    best = nullptr;
+    int           bestRank = 99;
+
+    for( PNS::ITEM* item : items.Items() )
+    {
+        if( !item->Net() || !item->Layers().Overlaps( aLayer ) )
+            continue;
+
+        int rank = item->OfKind( PNS::ITEM::SOLID_T ) ? 0
+                   : item->OfKind( PNS::ITEM::VIA_T ) ? 1
+                   : item->OfKind( PNS::ITEM::SEGMENT_T | PNS::ITEM::ARC_T ) ? 2 : 99;
+
+        if( rank < bestRank )
+        {
+            best = item;
+            bestRank = rank;
+        }
+    }
+
+    return best;
+}
