+
+static wxString fmtXY( const VECTOR2I& p )
+{
+    return wxString::Format( "(%.2f, %.2f)", mm( p.x ), mm( p.y ) );
+}
+
+
+// 追加した配線を、ネット・層ごとの折れ線とビアの一覧にする(指示書用)
+static wxString padLabelAt( BOARD* aBoard, const VECTOR2I& aP, int aNet )
+{
+    for( FOOTPRINT* fp : aBoard->Footprints() )
+        for( PAD* pad : fp->Pads() )
+            if( pad->GetNetCode() == aNet && pad->HitTest( aP ) )
+                return wxS( "[" ) + fp->GetReference() + wxS( "." ) + pad->GetNumber() + wxS( "]" );
+
+    return wxString();
+}
+
+
+static wxString describeTracks( BOARD* aBoard, const std::vector<BOARD_CONNECTED_ITEM*>& aItems,
+                                const std::optional<VECTOR2I>& aStart = std::nullopt )
+{
+    std::set<BOARD_ITEM*> alive;
+
+    for( PCB_TRACK* t : aBoard->Tracks() )
+        alive.insert( t );
+
+    std::map<std::pair<wxString, wxString>, std::vector<PCB_TRACK*>> groups;
+    std::vector<std::pair<wxString, wxString>>                    order;   // 引いた順
+    std::vector<PCB_VIA*>                                         vias;
+
+    for( BOARD_CONNECTED_ITEM* it : aItems )
+    {
+        if( !alive.count( it ) )
+            continue;
+
+        if( it->Type() == PCB_VIA_T )
+            vias.push_back( static_cast<PCB_VIA*>( it ) );
+        else if( it->Type() == PCB_TRACE_T || it->Type() == PCB_ARC_T )
+        {
+            std::pair<wxString, wxString> key{ it->GetNetname(), it->GetLayerName() };
+
+            if( !groups.count( key ) )
+                order.push_back( key );
+
+            groups[key].push_back( static_cast<PCB_TRACK*>( it ) );
+        }
+    }
+
+    // 引いた順は始点側からなので、始点に近いグループを先にする
+    if( aStart )
+    {
+        auto nearest = [&]( const std::pair<wxString, wxString>& k )
+        {
+            double best = 1e30;
+
+            for( PCB_TRACK* t : groups[k] )
+                best = std::min( best, std::min( (double) ( t->GetStart() - *aStart ).EuclideanNorm(),
+                                                 (double) ( t->GetEnd() - *aStart ).EuclideanNorm() ) );
+
+            return best;
+        };
+
+        std::stable_sort( order.begin(), order.end(),
+                          [&]( const auto& a, const auto& b ) { return nearest( a ) < nearest( b ); } );
+    }
+
+    wxString                out;
+    std::optional<VECTOR2I> from = aStart;   // 次の折れ線はここに近い端から書く
+
+    for( const auto& key : order )
+    {
+        std::vector<PCB_TRACK*>& segs = groups[key];
+        // 端点でつないで折れ線にする
+        std::vector<bool> used( segs.size(), false );
+        auto              deg = [&]( const VECTOR2I& p )
+        {
+            int n = 0;
+
+            for( PCB_TRACK* t : segs )
+                n += ( t->GetStart() == p ) + ( t->GetEnd() == p );
+
+            return n;
+        };
+
+        for( size_t k = 0; k < segs.size(); k++ )
+        {
+            // 未使用の中から、端(次数1)の点を持つ線分を優先して始点にする
+            size_t first = segs.size();
+
+            for( size_t i = 0; i < segs.size() && first == segs.size(); i++ )
+                if( !used[i] && ( deg( segs[i]->GetStart() ) == 1 || deg( segs[i]->GetEnd() ) == 1 ) )
+                    first = i;
+
+            for( size_t i = 0; i < segs.size() && first == segs.size(); i++ )
+                if( !used[i] )
+                    first = i;
+
+            if( first == segs.size() )
+                break;
+
+            used[first] = true;
+            VECTOR2I a = segs[first]->GetStart(), b = segs[first]->GetEnd();
+
+            if( deg( b ) == 1 && deg( a ) != 1 )
+                std::swap( a, b );
+
+            std::vector<VECTOR2I> pts = { a, b };
+            bool                  grew = true;
+
+            while( grew )
+            {
+                grew = false;
+
+                for( size_t i = 0; i < segs.size(); i++ )
+                {
+                    if( used[i] )
+                        continue;
+
+                    if( segs[i]->GetStart() == pts.back() )
+                        pts.push_back( segs[i]->GetEnd() );
+                    else if( segs[i]->GetEnd() == pts.back() )
+                        pts.push_back( segs[i]->GetStart() );
+                    else
+                        continue;
+
+                    used[i] = true;
+                    grew = true;
+                }
+            }
+
+            // 始点(または前の折れ線の終点)に近い端から書く
+            if( from && ( pts.back() - *from ).EuclideanNorm() < ( pts.front() - *from ).EuclideanNorm() )
+                std::reverse( pts.begin(), pts.end() );
+
+            from = pts.back();
+
+            int      net = segs[first]->GetNetCode();
+            wxString line = wxString::Format( "  - %s / %s 幅%.2fmm: ", key.first, key.second,
+                                              mm( segs[first]->GetWidth() ) );
+
+            for( size_t i = 0; i < pts.size(); i++ )
+            {
+                line += ( i ? wxS( " → " ) : wxString() ) + fmtXY( pts[i] );
+
+                if( i == 0 || i == pts.size() - 1 )
+                    line += padLabelAt( aBoard, pts[i], net );
+            }
+
+            out += line + wxS( "\n" );
+        }
+    }
+
+    for( PCB_VIA* v : vias )
+    {
+        out += wxString::Format( "  - ビア %s 径%.2f/穴%.2fmm (%s)\n", fmtXY( v->GetPosition() ),
+                                 mm( v->GetWidth() ), mm( v->GetDrillValue() ), v->GetNetname() );
+    }
+
+    return out;
+}
+
+
+static bool doInfo( CTX& c, const wxString& aRef )
+{
+    FOOTPRINT* fp = findFp( c.board, aRef );
+
+    if( !fp )
+    {
+        msg( "  %d行: NG 部品 %s がない\n", aRef );
+        return false;
+    }
+
+    c.board->BuildConnectivity();
+    printf( "  %s: 位置 %s 角度 %.1f° %s面  値 %s  フットプリント %s\n", (const char*) aRef.utf8_str(),
+            (const char*) fmtXY( fp->GetPosition() ).utf8_str(), fp->GetOrientation().AsDegrees(),
+            fp->IsFlipped() ? "裏" : "表", (const char*) fp->GetValue().utf8_str(),
+            (const char*) fp->GetFPID().GetLibItemName().wx_str().utf8_str() );
+
+    for( PAD* pad : fp->Pads() )
+    {
+        int tracks = 0;
+
+        for( PCB_TRACK* t : c.board->Tracks() )
+            if( t->GetNetCode() == pad->GetNetCode() && pad->GetNetCode() > 0
+                && ( pad->HitTest( t->GetStart() ) || pad->HitTest( t->GetEnd() )
+                     || ( t->Type() == PCB_VIA_T && pad->HitTest( t->GetPosition() ) ) ) )
+                tracks++;
+
+        printf( "    端子 %-3s %s  ネット %-24s 配線 %d 本\n", (const char*) pad->GetNumber().utf8_str(),
+                (const char*) fmtXY( pad->GetPosition() ).utf8_str(),
+                pad->GetNetCode() > 0 ? (const char*) pad->GetNetname().utf8_str() : "(なし)", tracks );
+    }
+
+    fflush( stdout );
+    return true;
+}
+
+
+static bool doCheck( CTX& c, bool aAll )
+{
+    {
+        ZONE_FILLER        filler( c.board, nullptr );
+        std::vector<ZONE*> zones( c.board->Zones().begin(), c.board->Zones().end() );
+        filler.Fill( zones );
+    }
+
+    c.board->BuildConnectivity();
+    c.dirty = true;
+
+    BOARD_DESIGN_SETTINGS& bds = c.board->GetDesignSettings();
+    std::map<wxString, std::vector<wxString>> found;
+    int hidden = 0;
+
+    // ライブラリとの照合は、このツールではライブラリ表を読まないため見かけの警告になる。check では止める
+    std::map<int, SEVERITY> savedSev = bds.m_DRCSeverities;
+
+    if( !aAll )
+    {
+        bds.m_DRCSeverities[DRCE_LIB_FOOTPRINT_ISSUES] = RPT_SEVERITY_IGNORE;
+        bds.m_DRCSeverities[DRCE_LIB_FOOTPRINT_MISMATCH] = RPT_SEVERITY_IGNORE;
+    }
+
+    c.drc->SetViolationHandler(
+            [&]( const std::shared_ptr<DRC_ITEM>& aItem, VECTOR2I aPos, int aLayer )
+            {
+                if( bds.GetSeverity( aItem->GetErrorCode() ) == RPT_SEVERITY_IGNORE )
+                    return;
+
+                wxString key = aItem->GetSettingsKey();
+
+                if( !aAll && ( key.StartsWith( wxS( "lib_footprint" ) ) || key.StartsWith( wxS( "silk" ) ) ) )
+                {
+                    hidden++;
+                    return;
+                }
+
+                BOARD_ITEM* a = c.board->GetItem( aItem->GetMainItemID() );
+                BOARD_ITEM* b = c.board->GetItem( aItem->GetAuxItemID() );
+                wxString    what = fmtXY( aPos );
+
+                if( a && a->Type() != NOT_USED )
+                    what += wxS( " " ) + describe( a, a->GetPosition() );
+
+                if( b && b->Type() != NOT_USED )
+                    what += wxS( " ⇔ " ) + describe( b, b->GetPosition() );
+
+                found[key].push_back( what );
+            } );
+
+    c.drc->RunTests( EDA_UNITS::MILLIMETRES, false, false );
+    c.drc->ClearViolationHandler();
+    bds.m_DRCSeverities = savedSev;
+
+    int total = 0, unconn = 0;
+
+    for( auto& [k, v] : found )
+        ( k == wxS( "unconnected_items" ) ? unconn : total ) += v.size();
+
+    printf( "  %d行: DRC 違反 %d 件 / 未配線 %d 件%s\n", g_line, total, unconn,
+            hidden ? (const char*) wxString::Format( "(シルクの警告 %d 件は非表示。check all で表示)", hidden ).utf8_str()
+                   : "" );
+
+    if( found.count( wxS( "lib_footprint_issues" ) ) )
+        printf( "    (lib_footprint_issues はこのツールがライブラリ表を読まないために出る。"
+                "正しい照合は kicad-local drc で)\n" );
+
+    for( auto& [k, v] : found )
+    {
+        printf( "    [%s] %zu 件\n", (const char*) k.utf8_str(), v.size() );
+
+        for( size_t i = 0; i < v.size() && i < 10; i++ )
+            printf( "      %s\n", (const char*) v[i].utf8_str() );
+
+        if( v.size() > 10 )
+            printf( "      ...ほか %zu 件\n", v.size() - 10 );
+    }
+
+    fflush( stdout );
+    return true;
+}
+
+
+struct OP_LOG
+{
+    int      line;
+    wxString command;
+    wxString detail;
+};
+
+int main( int argc, char** argv )
+{
+    std::vector<std::string> pos;
+    std::string              instructionsPath;
+
+    for( int i = 1; i < argc; i++ )
+    {
+        std::string a( argv[i] );
+
+        if( a == "-h" || a == "--help" || a == "help" )
+        {
+            printHelp();
+            return 0;
+        }
+        else if( a == "--instructions" && i + 1 < argc )
+        {
+            instructionsPath = argv[++i];
+        }
+        else
+        {
+            pos.push_back( a );
+        }
+    }
+
+    if( pos.size() != 3 )
+    {
+        fprintf( stderr, "使い方: kicad-route <入力.kicad_pcb> <出力.kicad_pcb | -> <手順ファイル | -> "
+                         "[--instructions 指示書.md]\n       命令の一覧は kicad-route --help\n" );
+        return 2;
+    }
+
+    wxInitialize( argc, argv );
+    int kifaceVersion = 0;
+    KIFACE_GETTER( &kifaceVersion, KIFACE_VERSION, &g_pgm );
+    g_pgm.InitPgm( true, true );
+
+    wxFileName fnIn( wxString::FromUTF8( pos[0] ) );
+    fnIn.MakeAbsolute();
+    wxFileName fnPro( fnIn );
+    fnPro.SetExt( wxS( "kicad_pro" ) );
+
+    SETTINGS_MANAGER mgr( true );
+    PROJECT*         project = nullptr;
+
+    if( fnPro.FileExists() )
+    {
+        mgr.LoadProject( fnPro.GetFullPath() );
+        project = mgr.GetProject( fnPro.GetFullPath() );
+    }
+    else
+    {
+        fprintf( stderr, "注意: %s がないため、設計ルールは既定値で動きます\n",
+                 (const char*) fnPro.GetFullName().utf8_str() );
+        mgr.LoadProject( "" );
+        project = &mgr.Prj();
+    }
+
+    std::unique_ptr<BOARD> board;
+
+    try
+    {
+        LOCALE_IO          dummy;
+        PCB_IO_KICAD_SEXPR io;
+        board.reset( io.LoadBoard( fnIn.GetFullPath(), nullptr, nullptr ) );
+    }
+    catch( const IO_ERROR& e )
+    {
+        fprintf( stderr, "読み込み失敗: %s\n", (const char*) e.What().utf8_str() );
+        return 1;
+    }
+
+    board->SetProject( project );
+    BOARD_DESIGN_SETTINGS& bds = board->GetDesignSettings();
+    auto                   drc = std::make_shared<DRC_ENGINE>( board.get(), &bds );
+    bds.m_DRCEngine = drc;
+    board->SynchronizeNetsAndNetClasses( true );
+    board->BuildConnectivity();
+
+    for( FOOTPRINT* fp : board->Footprints() )
+        fp->BuildCourtyardCaches();
+
+    wxFileName rules( fnPro );
+    rules.SetExt( wxS( "kicad_dru" ) );
+    drc->InitEngine( rules );
+
+    int unconnBefore = board->GetConnectivity()->GetUnconnectedCount( false );
+
+    auto iface = std::make_unique<HEADLESS_IFACE>();
+    auto router = std::make_unique<PNS::ROUTER>();
+    auto settings = new PNS::ROUTING_SETTINGS( nullptr, "" );
+    iface->SetBoard( board.get() );
+    router->SetInterface( iface.get() );
+    router->ClearWorld();
+    router->LoadSettings( settings );
+    settings->SetMode( PNS::RM_Shove );
+
+    CTX c{ board.get(), iface.get(), router.get(), settings };
+    c.drc = drc;
+
+    std::ifstream fin;
+    std::istream* inp = &std::cin;
+
+    if( pos[2] != "-" )
+    {
+        fin.open( pos[2] );
+
+        if( !fin )
+        {
+            fprintf( stderr, "手順ファイルが開けない: %s\n", pos[2].c_str() );
+            return 2;
+        }
+
+        inp = &fin;
+    }
+
+    std::istream&       in = *inp;
+    std::vector<OP_LOG> oplog;
+    std::vector<wxString> failed;
+
+    std::string line;
+    int         ok = 0, ng = 0;
+
+    while( std::getline( in, line ) )
+    {
+        g_line++;
+        line = line.substr( 0, line.find( '#' ) );
+        std::istringstream is( line );
+        std::string        cmd;
+
+        if( !( is >> cmd ) )
+            continue;
+
+        bool     r = false;
+        wxString wline = wxString::FromUTF8( line ).Trim();
+        size_t   newMark = iface->m_newItems.size();
+        g_opMsgs.clear();
+        std::string refArg;
+        {
+            std::istringstream peek( line );
+            std::string        c0;
+            peek >> c0 >> refArg;
+        }
+        FOOTPRINT* movedFp = ( cmd == "drag" || cmd == "place" )
+                                     ? findFp( board.get(), wxString::FromUTF8( refArg ) ) : nullptr;
+        VECTOR2I   fpPos0 = movedFp ? movedFp->GetPosition() : VECTOR2I();
+        double     fpRot0 = movedFp ? movedFp->GetOrientation().AsDegrees() : 0.0;
+        bool       logThis = true;
+
+        if( cmd == "mode" )
+        {
+            std::string m;
+            is >> m;
+            settings->SetMode( m == "walkaround" ? PNS::RM_Walkaround
+                               : m == "mark"     ? PNS::RM_MarkObstacles
+                                                 : PNS::RM_Shove );
+            continue;
+        }
+        else if( cmd == "width" )
+        {
+            std::string w;
+            is >> w;
+            c.width = ( w == "auto" ) ? 0 : pcbIUScale.mmToIU( std::stod( w ) );
+            continue;
+        }
+        else if( cmd == "route" )
+        {
+            std::string layerName, tok;
+            is >> layerName;
+            int       layer = board->GetLayerID( wxString::FromUTF8( layerName ) );
+            ROUTE_PTS pts;
+            bool      bad = false;
+
+            while( is >> tok )
+            {
+                if( tok.rfind( "via:", 0 ) == 0 && !pts.empty() )
+                {
+                    pts.back().second = board->GetLayerID( wxString::FromUTF8( tok.substr( 4 ) ) );
+                    continue;
+                }
+
+                VECTOR2I p;
+
+                if( !parsePt( board.get(), tok, p ) )
+                {
+                    msg( "  %d行: NG 点が読めない(x,y か 部品.端子): %s\n", wxString::FromUTF8( tok ) );
+                    bad = true;
+                    break;
+                }
+
+                pts.emplace_back( p, -1 );
+            }
+
+            if( bad )
+                ;
+            else if( layer < 0 || pts.size() < 2 )
+                msg( "  %d行: NG route の書式: %s\n", wline );
+            else
+                r = runRoute( c, layer, pts, true ).ok;
+        }
+        else if( cmd == "autoroute" )
+        {
+            std::string ta, tb, opt;
+            is >> ta >> tb >> opt;
+            VECTOR2I a, b;
+
+            if( parsePt( board.get(), ta, a ) && parsePt( board.get(), tb, b ) )
+                r = doAutoroute( c, a, b, opt == "shove" );
+            else
+                msg( "  %d行: NG autoroute の書式(点 点 [shove]): %s\n", wline );
+        }
+        else if( cmd == "unroute" )
+        {
+            std::string t;
+            is >> t;
+            r = doUnroute( c, t );
+        }
+        else if( cmd == "silk" )
+        {
+            FOOTPRINT* fp = findFp( board.get(), wxString::FromUTF8( refArg ) );
+
+            if( fp )
+            {
+                wxString note = fixReferenceSilk( c, fp );
+                msg( "  %d行: シルク%s\n", note.IsEmpty() ? wxString( wxS( ": 重なりなし" ) ) : note );
+                r = true;
+            }
+            else
+            {
+                msg( "  %d行: NG 部品 %s がない\n", wxString::FromUTF8( refArg ) );
+            }
+        }
+        else if( cmd == "info" )
+        {
+            r = doInfo( c, wxString::FromUTF8( refArg ) );
+            logThis = false;
+        }
+        else if( cmd == "check" )
+        {
+            r = doCheck( c, refArg == "all" );
+            logThis = false;
+        }
+        else if( cmd == "optimize" )
+        {
+            std::string t;
+            is >> t;
+            r = doOptimize( c, t );
+        }
+        else if( cmd == "drag" )
+        {
+            std::string ref, d;
+            VECTOR2I    delta;
+            is >> ref >> d;
+
+            if( parsePt( board.get(), d, delta ) )
+                r = doDrag( c, wxString::FromUTF8( ref ), delta );
+            else
+                msg( "  %d行: NG drag の書式(部品 dx,dy): %s\n", wline );
+        }
+        else if( cmd == "place" )
+        {
+            std::string ref, p;
+            double      rot;
+            VECTOR2I    pos;
+            is >> ref >> p;
+            std::optional<double> optRot;
+
+            if( is >> rot )
+                optRot = rot;
+
+            if( parsePt( board.get(), p, pos ) )
+                r = doPlace( c, wxString::FromUTF8( ref ), pos, optRot );
+            else
+                msg( "  %d行: NG place の書式(部品 x,y [角度]): %s\n", wline );
+        }
+        else if( cmd == "findspace" )
+        {
+            std::string ref, t;
+            double      step = 0.5;
+            BOX2I       area;
+            bool        hasArea = false;
+            is >> ref;
+
+            while( is >> t )
+            {
+                double x0, y0, x1, y1;
+                char   c1, c2, c3;
+                std::istringstream ts( t );
+
+                if( ( ts >> x0 >> c1 >> y0 >> c2 >> x1 >> c3 >> y1 ) && c1 == ',' )
+                {
+                    area = BOX2I( VECTOR2I( pcbIUScale.mmToIU( x0 ), pcbIUScale.mmToIU( y0 ) ),
+                                  VECTOR2I( pcbIUScale.mmToIU( x1 - x0 ), pcbIUScale.mmToIU( y1 - y0 ) ) );
+                    hasArea = true;
+                }
+                else
+                {
+                    step = std::stod( t );
+                }
+            }
+
+            r = doFindspace( c, wxString::FromUTF8( ref ), step, hasArea ? &area : nullptr );
+            logThis = false;
+        }
+        else
+        {
+            msg( "  %d行: NG 不明な命令 %s\n", wxString::FromUTF8( cmd ) );
+        }
+
+        if( r )
+        {
+            ok++;
+            msg( "  %d行: OK %s\n", wline );
+
+            if( logThis )
+            {
+                OP_LOG op{ g_line, wline, wxString() };
+
+                for( const wxString& m : g_opMsgs )
+                    op.detail += wxS( "  - " ) + m + wxS( "\n" );
+
+                if( movedFp )
+                {
+                    op.detail += wxString::Format( "  - %s を %s %.1f° → %s %.1f° へ移動\n",
+                                                   movedFp->GetReference(), fmtXY( fpPos0 ), fpRot0,
+                                                   fmtXY( movedFp->GetPosition() ),
+                                                   movedFp->GetOrientation().AsDegrees() );
+                }
+
+                std::vector<BOARD_CONNECTED_ITEM*> added( iface->m_newItems.begin() + newMark,
+                                                          iface->m_newItems.end() );
+                std::optional<VECTOR2I> startPt;
+                VECTOR2I                sp;
+
+                if( ( cmd == "autoroute" ) && parsePt( board.get(), refArg, sp ) )
+                    startPt = sp;
+                else if( cmd == "route" )
+                {
+                    std::istringstream rs( line );
+                    std::string        c0, lay, p0;
+                    rs >> c0 >> lay >> p0;
+
+                    if( parsePt( board.get(), p0, sp ) )
+                        startPt = sp;
+                }
+
+                op.detail += describeTracks( board.get(), added, startPt );
+                oplog.push_back( op );
+            }
+        }
+        else
+        {
+            ng++;
+            wxString why = g_lastMsg;
+            why.Trim().Trim( false );
+            failed.push_back( wxString::Format( "`%s` — %s", wline, why ) );
+        }
+    }
+
+    board->BuildConnectivity();
+
+    {
+        ZONE_FILLER        filler( board.get(), nullptr );
+        std::vector<ZONE*> zones( board->Zones().begin(), board->Zones().end() );
+        filler.Fill( zones );
+    }
+
+    board->BuildConnectivity();
+    int unconnAfter = board->GetConnectivity()->GetUnconnectedCount( false );
+
+    if( pos[1] != "-" )
+    {
+        try
+        {
+            LOCALE_IO          dummy;
+            PCB_IO_KICAD_SEXPR io;
+            io.SaveBoard( wxString::FromUTF8( pos[1] ), board.get() );
+
+            wxFileName outPro( wxString::FromUTF8( pos[1] ) );
+            outPro.SetExt( wxS( "kicad_pro" ) );
+
+            if( fnPro.FileExists() && !outPro.FileExists() )
+                wxCopyFile( fnPro.GetFullPath(), outPro.GetFullPath() );
+        }
+        catch( const IO_ERROR& e )
+        {
+            fprintf( stderr, "保存失敗: %s\n", (const char*) e.What().utf8_str() );
+            return 1;
+        }
+    }
+
+    printf( "結果: 成功 %d / 失敗 %d、配線 追加 %d・削除 %d・変更 %d、未配線 %d → %d%s\n", ok, ng,
+            iface->m_added, iface->m_removed, iface->m_modified, unconnBefore, unconnAfter,
+            pos[1] == "-" ? "(保存なし)" : "" );
+    listUnconnected( board.get() );
+
+    if( !instructionsPath.empty() )
+    {
+        wxString md;
+        md += wxS( "# 基板の修正手順\n\n" );
+        md += wxString::Format( "- 元の基板: `%s`\n", fnIn.GetFullName() );
+        md += wxString::Format( "- 結果: 操作 %d 件成功 / %d 件失敗、未配線 %d → %d\n", ok, ng, unconnBefore,
+                                unconnAfter );
+        md += wxS( "- 座標は mm(KiCad の基板座標。画面左下の X/Y 表示と同じ)。配線は折れ点を順に結ぶ。\n\n" );
+
+        int n = 0;
+
+        for( const OP_LOG& op : oplog )
+        {
+            md += wxString::Format( "## %d. %s\n\n", ++n, op.command );
+            md += op.detail.IsEmpty() ? wxS( "  - (変更なし)\n" ) : op.detail;
+            md += wxS( "\n" );
+        }
+
+        if( !failed.empty() )
+        {
+            md += wxS( "## できなかった操作\n\n" );
+
+            for( const wxString& f : failed )
+                md += wxS( "- " ) + f + wxS( "\n" );
+        }
+
+        wxFFile f( wxString::FromUTF8( instructionsPath ), wxS( "w" ) );
+
+        if( f.IsOpened() && f.Write( md, wxConvUTF8 ) )
+            printf( "指示書を書き出した: %s\n", instructionsPath.c_str() );
+        else
+            fprintf( stderr, "指示書を書き出せない: %s\n", instructionsPath.c_str() );
+    }
+
+    // 保存と結果表示が済んだら後片付けせずに終了する(KiCad 内部の静的オブジェクトの
+    // 破棄順で落ちるのを避ける。OS がメモリを回収する)
+    fflush( stdout );
+    fflush( stderr );
+    std::_Exit( ng ? 3 : 0 );
+}
diff --git a/tools/build/fix_swig_ownership_refcount.py b/tools/build/fix_swig_ownership_refcount.py
new file mode 100644
index 0000000..ba51a28
--- /dev/null
+++ b/tools/build/fix_swig_ownership_refcount.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""
+SWIG 4.x の Python ランタイムの不具合を、生成されたラッパーに対して直す。
+
+SwigPyObject_New() は所有権付き(SWIG_POINTER_OWN)で作ったオブジェクトについてだけ
+Swig_Capsule_global の参照数を増やし、SwigPyObject_dealloc() は所有権付きなら必ず減らす。
+ところが後から thisown=1 にする acquire() と thisown=0 にする disown() は参照数を変えない。
+KiCad の BOARD_ITEM_CONTAINER.Remove() は thisown=1 にするので、外した部品や配線を Python が
+解放するたびに参照数が1つ余計に減り、0 になった時点で型の対応表(clientdata)が破棄される。
+以後、あらゆる戻り値が生の SwigPyObject になり、GetFootprints() などが使えなくなる。
+
+acquire/disown でも参照数を増減させて辻褄を合わせる。
+"""
+import sys
+
+path = sys.argv[1]
+src = open(path, encoding="utf-8").read()
+
+acquire_old = """SwigPyObject_acquire(PyObject* v, PyObject *SWIGUNUSEDPARM(args))
+{
+  SwigPyObject *sobj = (SwigPyObject *)v;
+  sobj->own = SWIG_POINTER_OWN;"""
+acquire_new = """SwigPyObject_acquire(PyObject* v, PyObject *SWIGUNUSEDPARM(args))
+{
+  SwigPyObject *sobj = (SwigPyObject *)v;
+  if (sobj->own != SWIG_POINTER_OWN)
+    Py_XINCREF(Swig_Capsule_global);  /* KiCad: dealloc で減らす分を先に持つ */
+  sobj->own = SWIG_POINTER_OWN;"""
+
+disown_old = """SwigPyObject_disown(PyObject* v, PyObject *SWIGUNUSEDPARM(args))
+{
+  SwigPyObject *sobj = (SwigPyObject *)v;
+  sobj->own = 0;"""
+disown_new = """SwigPyObject_disown(PyObject* v, PyObject *SWIGUNUSEDPARM(args))
+{
+  SwigPyObject *sobj = (SwigPyObject *)v;
+  if (sobj->own == SWIG_POINTER_OWN)
+    Py_XDECREF(Swig_Capsule_global);  /* KiCad: 所有権を手放したら dealloc では減らさない */
+  sobj->own = 0;"""
+
