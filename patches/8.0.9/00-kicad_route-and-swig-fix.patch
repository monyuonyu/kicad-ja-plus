+// ボードへ直接書き込む PNS インターフェース(GUI の BOARD_COMMIT を使わない版)
+class HEADLESS_IFACE : public PNS_KICAD_IFACE_BASE
+{
+public:
+    int m_added = 0, m_removed = 0, m_modified = 0;
+    std::vector<BOARD_ITEM*> m_trash;
+    std::vector<BOARD_CONNECTED_ITEM*> m_newItems;   // 指示書用: 追加した配線・ビア(順番どおり)
+
+    struct OFFSET
+    {
+        VECTOR2I p_old, p_new;
+    };
+
+    std::map<PAD*, OFFSET> m_fpOffsets;
+
+    int GetNetCode( PNS::NET_HANDLE aNet ) const override
+    {
+        NETINFO_ITEM* n = static_cast<NETINFO_ITEM*>( aNet );
+        return n ? n->GetNetCode() : -1;
+    }
+
+    wxString GetNetName( PNS::NET_HANDLE aNet ) const override
+    {
+        NETINFO_ITEM* n = static_cast<NETINFO_ITEM*>( aNet );
+        return n ? n->GetNetname() : wxString();
+    }
+
+    void RemoveItem( PNS::ITEM* aItem ) override
+    {
+        BOARD_ITEM* parent = aItem->Parent();
+
+        if( aItem->OfKind( PNS::ITEM::SOLID_T ) )
+        {
+            PAD* pad = static_cast<PAD*>( parent );
+            m_fpOffsets[pad].p_old = static_cast<PNS::SOLID*>( aItem )->Pos();
+            return;
+        }
+
+        if( parent && parent->GetParent() == GetBoard() )
+        {
+            GetBoard()->Remove( parent );
+            m_trash.push_back( parent );
+            m_removed++;
+        }
+    }
+
+    void UpdateItem( PNS::ITEM* aItem ) override
+    {
+        BOARD_ITEM* bi = aItem->Parent();
+        m_modified++;
+
+        switch( aItem->Kind() )
+        {
+        case PNS::ITEM::ARC_T:
+        {
+            PNS::ARC*        arc = static_cast<PNS::ARC*>( aItem );
+            PCB_ARC*         a = static_cast<PCB_ARC*>( bi );
+            const SHAPE_ARC* s = static_cast<const SHAPE_ARC*>( arc->Shape() );
+            a->SetStart( s->GetP0() );
+            a->SetEnd( s->GetP1() );
+            a->SetMid( s->GetArcMid() );
+            a->SetWidth( arc->Width() );
+            break;
+        }
+        case PNS::ITEM::SEGMENT_T:
+        {
+            PNS::SEGMENT* seg = static_cast<PNS::SEGMENT*>( aItem );
+            PCB_TRACK*    t = static_cast<PCB_TRACK*>( bi );
+            t->SetStart( seg->Seg().A );
+            t->SetEnd( seg->Seg().B );
+            t->SetWidth( seg->Width() );
+            break;
+        }
+        case PNS::ITEM::VIA_T:
+        {
+            PNS::VIA* via = static_cast<PNS::VIA*>( aItem );
+            PCB_VIA*  v = static_cast<PCB_VIA*>( bi );
+            v->SetPosition( via->Pos() );
+            v->SetWidth( via->Diameter() );
+            v->SetDrill( via->Drill() );
+            break;
+        }
+        case PNS::ITEM::SOLID_T:
+        {
+            PAD* pad = static_cast<PAD*>( bi );
+            m_fpOffsets[pad].p_old = pad->GetPosition();
+            m_fpOffsets[pad].p_new = static_cast<PNS::SOLID*>( aItem )->Pos();
+            break;
+        }
+        default: break;
+        }
+    }
+
+    void AddItem( PNS::ITEM* aItem ) override
+    {
+        NETINFO_ITEM* net = static_cast<NETINFO_ITEM*>( aItem->Net() );
+
+        if( !net )
+            net = NETINFO_LIST::OrphanedItem();
+
+        BOARD_CONNECTED_ITEM* ni = nullptr;
+
+        switch( aItem->Kind() )
+        {
+        case PNS::ITEM::ARC_T:
+        {
+            PNS::ARC* arc = static_cast<PNS::ARC*>( aItem );
+            PCB_ARC*  a = new PCB_ARC( GetBoard(), static_cast<const SHAPE_ARC*>( arc->Shape() ) );
+            a->SetWidth( arc->Width() );
+            a->SetLayer( ToLAYER_ID( arc->Layers().Start() ) );
+            ni = a;
+            break;
+        }
+        case PNS::ITEM::SEGMENT_T:
+        {
+            PNS::SEGMENT* seg = static_cast<PNS::SEGMENT*>( aItem );
+            PCB_TRACK*    t = new PCB_TRACK( GetBoard() );
+            t->SetStart( seg->Seg().A );
+            t->SetEnd( seg->Seg().B );
+            t->SetWidth( seg->Width() );
+            t->SetLayer( ToLAYER_ID( seg->Layers().Start() ) );
+            ni = t;
+            break;
+        }
+        case PNS::ITEM::VIA_T:
+        {
+            PNS::VIA* via = static_cast<PNS::VIA*>( aItem );
+            PCB_VIA*  v = new PCB_VIA( GetBoard() );
+            v->SetPosition( via->Pos() );
+            v->SetWidth( via->Diameter() );
+            v->SetDrill( via->Drill() );
+            v->SetViaType( via->ViaType() );
+            v->SetLayerPair( ToLAYER_ID( via->Layers().Start() ), ToLAYER_ID( via->Layers().End() ) );
+            ni = v;
+            break;
+        }
+        case PNS::ITEM::SOLID_T:
+        {
+            PAD* pad = static_cast<PAD*>( aItem->Parent() );
+            m_fpOffsets[pad].p_new = static_cast<PNS::SOLID*>( aItem )->Pos();
+            return;
+        }
+        default: return;
+        }
+
+        ni->SetNet( net );
+        aItem->SetParent( ni );
+        GetBoard()->Add( ni );
+        m_newItems.push_back( ni );
+        m_added++;
+    }
+
+    void Commit() override
+    {
+        std::set<FOOTPRINT*> done;
+
+        for( const auto& [pad, off] : m_fpOffsets )
+        {
+            FOOTPRINT* fp = pad->GetParentFootprint();
+
+            if( done.count( fp ) )
+                continue;
+
+            done.insert( fp );
+            fp->SetPosition( fp->GetPosition() + ( off.p_new - off.p_old ) );
+        }
+
+        m_fpOffsets.clear();
+    }
+};
+
+
+static int g_line = 0;
+static bool g_quiet = false;
+static wxString g_lastMsg;   // 指示書の「できなかった操作」に理由を書くため
+static std::vector<wxString> g_opMsgs;   // 指示書用: 今の操作の途中で出たメッセージ
+
+static void msg( const char* aFmt, const wxString& aText )
+{
+    if( g_quiet )
+        return;
+
+    wxString m = wxString::Format( wxString::FromUTF8( aFmt ), g_line, aText );
+    g_lastMsg = m;
+
+    wxString body = m;
+    body.Trim().Trim( false );
+    body = body.AfterFirst( ':' ).Trim( false );   // 「N行: 」を外す
+
+    if( !body.StartsWith( wxS( "OK " ) ) )
+        g_opMsgs.push_back( body );
+    printf( "%s", (const char*) m.utf8_str() );
+    fflush( stdout );
+}
