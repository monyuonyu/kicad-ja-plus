+
+// KiCad 11 の ROUTER_TOOL::OptimizeSelected を画面なしに移植したもの
+static bool doOptimize( CTX& c, const std::string& aTok )
+{
+    std::set<int> nets;
+
+    if( aTok == "all" )
+    {
+        for( PCB_TRACK* t : c.board->Tracks() )
+            if( t->GetNetCode() > 0 )
+                nets.insert( t->GetNetCode() );
+    }
+    else if( PAD* pad = findPad( c.board, aTok ) )
+    {
+        nets.insert( pad->GetNetCode() );
+    }
+    else if( NETINFO_ITEM* net = c.board->FindNet( wxString::FromUTF8( aTok ) ) )
+    {
+        nets.insert( net->GetNetCode() );
+    }
+
+    nets.erase( 0 );
+
+    if( nets.empty() )
+    {
+        msg( "  %d行: NG ネットが見つからない: %s\n", wxString::FromUTF8( aTok ) );
+        return false;
+    }
+
+    std::vector<PCB_TRACK*> targets;
+
+    for( PCB_TRACK* t : c.board->Tracks() )
+        if( t->Type() == PCB_TRACE_T && nets.count( t->GetNetCode() ) )
+            targets.push_back( t );
+
+    int  changed = 0, lines = 0, skippedLocked = 0;
+    double before = 0, after = 0;
+    std::set<BOARD_ITEM*> seen;
+
+    for( PCB_TRACK* t : targets )
+    {
+        if( seen.count( t ) )
+            continue;
+
+        c.Sync();
+        PNS::NODE* world = c.router->GetWorld();
+        PNS::ITEM* it = world->FindItemByParent( t );
+
+        if( !it || !it->OfKind( PNS::ITEM::SEGMENT_T ) )
+            continue;
+
+        PNS::LINE orig = world->AssembleLine( static_cast<PNS::LINKED_ITEM*>( it ) );
+        bool      locked = false;
+
+        for( PNS::LINKED_ITEM* li : orig.Links() )
+        {
+            if( li->Parent() )
+                seen.insert( li->Parent() );
+
+            if( li->IsLocked() || ( li->Parent() && li->Parent()->IsLocked() ) )
+                locked = true;
+        }
+
+        lines++;
+
+        if( locked )
+        {
+            skippedLocked++;
+            continue;
+        }
+
+        if( orig.ArcCount() > 0 )
+            continue;
+
+        PNS::NODE* branch = world->Branch();
+        branch->Remove( orig );
+
+        PNS::LINE opt( orig );
+        opt.ClearLinks();
+
+        int effort = PNS::OPTIMIZER::MERGE_SEGMENTS | PNS::OPTIMIZER::MERGE_OBTUSE
+                     | PNS::OPTIMIZER::MERGE_COLINEAR | PNS::OPTIMIZER::SMART_PADS
+                     | PNS::OPTIMIZER::FANOUT_CLEANUP;
+
+        bool ok = PNS::OPTIMIZER::Optimize( &opt, effort, branch );
+
+        if( !ok || opt.CompareGeometry( orig ) || branch->CheckColliding( &opt ) )
+        {
+            delete branch;
+            continue;
+        }
+
+        before += mm( orig.CLine().Length() );
+        after += mm( opt.CLine().Length() );
+        branch->Add( opt );
+        c.router->CommitRouting( branch );
+        c.dirty = true;
+        changed++;
+    }
+
+    msg( "  %d行: %s\n", wxString::Format( "最適化: %d 本中 %d 本を整理(対象部分の長さ %.1f → %.1fmm)%s",
+                                            lines, changed, before, after,
+                                            skippedLocked ? wxString::Format( "、ロック済み %d 本は触らず", skippedLocked )
+                                                          : wxString() ) );
+    return true;
+}
