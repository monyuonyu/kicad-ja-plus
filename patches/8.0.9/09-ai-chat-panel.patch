+#ifndef PANEL_AI_CHAT_H
+#define PANEL_AI_CHAT_H
+
+#include <wx/panel.h>
+#include <set>
+#include <wx/timer.h>
+#include <string>
+
+class PCB_EDIT_FRAME;
+class wxProcess;
+class wxProcessEvent;
+class wxTextCtrl;
+class wxButton;
+class wxStaticText;
+
+/**
+ * 基板エディタの AI チャットの枠。
+ *
+ * AI とのやり取りは別プロセスの仲介役（scripting/kicad_ai/bridge.py、Claude Agent SDK）が行い、
+ * ここは会話の表示と、AI が基板を変えるコードの承認（毎回）だけを受け持つ。
+ * 仲介役は KiCad の IPC API で開いている基板を読み、直す（1 回の実行が「元に戻す」の 1 段）。
+ */
+class PANEL_AI_CHAT : public wxPanel
+{
+public:
+    PANEL_AI_CHAT( wxWindow* aParent, PCB_EDIT_FRAME* aFrame );
+    ~PANEL_AI_CHAT() override;
+
+    /// 枠が表示されたとき（まだなら仲介役を起動する）
+    void OnShowPanel();
+
+private:
+    enum class ROLE { USER, AI, TOOL, INFO, FAIL };  // ERROR は Windows のヘッダーで数の 0 に置き換わるので使わない
+
+    void append( ROLE aRole, const wxString& aText );
+    void appendMarkdown( const wxString& aText );
+    void setBusy( bool aBusy );
+
+    bool checkPrerequisites();
+    void startBridge();
+    void stopBridge();
+    void sendJson( const std::string& aLine );
+    void readOutput();
+    void handleLine( const std::string& aLine );
+    void askApproval( int aId, const wxString& aDescription, const wxString& aCode );
+    void askApiKey();
+    void runSetup();
+    void onSetupEnd( wxProcessEvent& aEvent );
+    wxString venvDir() const;
+
+    wxString pythonPath() const;
+    wxString bridgePath() const;
+
+    void onSend( wxCommandEvent& aEvent );
+    void onStop( wxCommandEvent& aEvent );
+    void onReset( wxCommandEvent& aEvent );
+    void onInputKey( wxKeyEvent& aEvent );
+    void onTimer( wxTimerEvent& aEvent );
+    void onProcessEnd( wxProcessEvent& aEvent );
+
+    PCB_EDIT_FRAME* m_frame;
+    wxTextCtrl*     m_log;
+    wxTextCtrl*     m_input;
+    wxButton*       m_sendButton;
+    wxButton*       m_stopButton;
+    wxButton*       m_resetButton;
+    wxStaticText*   m_status;
+
+    wxProcess*      m_process;
+    long            m_pid;
+    wxTimer         m_timer;
+    std::string     m_outBuf;
+    std::string     m_errBuf;
+    bool            m_ready;
+    bool            m_busy;
+    wxString        m_pending;      ///< 準備ができる前に送られた文
+    std::set<int>   m_approved;     ///< 利用者が承認した実行の番号（基板を変える実行は、これにあるものだけ）
+
+    wxProcess*      m_setupProcess; ///< 準備（setup_ai.py）が走っている間だけ
+    std::string     m_setupBuf;
+};
+
+#endif // PANEL_AI_CHAT_H
