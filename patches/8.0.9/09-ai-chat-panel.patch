+// ---- AI チャット（8.0.9 は IPC API が無いので、KiCad の中の Python で実行する） ----
+
+// AI のコードを動かす Python。print と誤りの出力を集め、最後が式ならその値も出す（対話の画面と同じ）
+static const char* AI_RUNNER = R"PY(
+def _kicad_ai_run(code):
+    import ast, io, sys, traceback
+    import pcbnew
+    out = io.StringIO()
+    saved = (sys.stdout, sys.stderr)
+    sys.stdout = sys.stderr = out
+    ok = True
+    try:
+        board = pcbnew.GetBoard()
+        env = {"__name__": "__kicad_ai__", "pcbnew": pcbnew, "board": board,
+               "FromMM": pcbnew.FromMM, "ToMM": pcbnew.ToMM, "from_mm": pcbnew.FromMM, "to_mm": pcbnew.ToMM,
+               "VECTOR2I": pcbnew.VECTOR2I}
+        tree = ast.parse(code, "<AI>", "exec")
+        last = None
+        if tree.body and isinstance(tree.body[-1], ast.Expr):
+            last = ast.Expression(tree.body.pop().value)
+        exec(compile(tree, "<AI>", "exec"), env)
+        if last is not None:
+            value = eval(compile(last, "<AI>", "eval"), env)
+            if value is not None:
+                print(repr(value))
+    except BaseException:
+        ok = False
+        traceback.print_exc()
+    finally:
+        sys.stdout, sys.stderr = saved
+    return ok, out.getvalue()
+)PY";
+
+
+/// 基板全体をファイルと同じ形の文字列にする（実行の前後で変わったかを見るため）
+static std::string formatBoardForCompare( BOARD* aBoard )
+{
+    STRING_FORMATTER   sf;
+    PCB_IO_KICAD_SEXPR io;
+
+    io.SetOutputFormatter( &sf );
+
+    try
+    {
+        io.Format( aBoard );
+    }
+    catch( ... )
+    {
+    }
+
+    return sf.GetString();
+}
+
+
+static bool runAiCode( const std::string& aCode, wxString& aOutput )
+{
+    PyLOCK lock;
+    bool   ok = false;
+
+    PyObject* globals = PyDict_New();
+    PyDict_SetItemString( globals, "__builtins__", PyEval_GetBuiltins() );
+    PyObject* r = PyRun_String( AI_RUNNER, Py_file_input, globals, globals );
+
+    if( !r )
+    {
+        PyErr_Clear();
+        aOutput = wxS( "AI runner could not be prepared" );
+        Py_DECREF( globals );
+        return false;
+    }
+
+    Py_DECREF( r );
+    PyObject* fn = PyDict_GetItemString( globals, "_kicad_ai_run" );   // 借りた参照
+    PyObject* res = fn ? PyObject_CallFunction( fn, "s", aCode.c_str() ) : nullptr;
+
+    if( res && PyTuple_Check( res ) && PyTuple_Size( res ) == 2 )
+    {
+        ok = PyObject_IsTrue( PyTuple_GetItem( res, 0 ) );
+        const char* txt = PyUnicode_AsUTF8( PyTuple_GetItem( res, 1 ) );
+        aOutput = txt ? wxString::FromUTF8( txt ) : wxString();
+    }
+    else
+    {
+        PyErr_Clear();
+        aOutput = wxS( "AI runner failed" );
+    }
+
+    Py_XDECREF( res );
+    Py_DECREF( globals );
+    return ok;
+}
+
+
+wxString PCB_EDIT_FRAME::RunAiPython( const std::string& aCode, bool aWrite, const wxString& aDescription,
+                                      bool& aOk )
+{
+    wxString output;
+
+    if( !aWrite )
+    {
+        aOk = runAiCode( aCode, output );
+        return output;
+    }
+
+    // 変える前の控え（RunActionPlugin と同じ）
+    BOARD*            pcb = GetBoard();
+    PICKED_ITEMS_LIST itemsList;
+    bool              fromEmpty = false;
+
+    for( PCB_TRACK* item : pcb->Tracks() )
+        itemsList.PushItem( ITEM_PICKER( nullptr, item, UNDO_REDO::CHANGED ) );
+
+    for( FOOTPRINT* item : pcb->Footprints() )
+        itemsList.PushItem( ITEM_PICKER( nullptr, item, UNDO_REDO::CHANGED ) );
+
+    for( BOARD_ITEM* item : pcb->Drawings() )
+        itemsList.PushItem( ITEM_PICKER( nullptr, item, UNDO_REDO::CHANGED ) );
+
+    for( ZONE* zone : pcb->Zones() )
+        itemsList.PushItem( ITEM_PICKER( nullptr, zone, UNDO_REDO::CHANGED ) );
+
+    if( itemsList.GetCount() > 0 )
+        SaveCopyInUndoList( itemsList, UNDO_REDO::CHANGED );
+    else
+        fromEmpty = true;
+
+    itemsList.ClearItemsList();
+
+    const std::string before = formatBoardForCompare( pcb );
+    BOARD_COMMIT      commit( this );
+
+    ACTION_PLUGINS::SetActionRunning( true );
+    aOk = runAiCode( aCode, output );
+    ACTION_PLUGINS::SetActionRunning( false );
+
+    PICKED_ITEMS_LIST* oldBuffer = fromEmpty ? new PICKED_ITEMS_LIST() : PopCommandFromUndoList();
+    const auto         currItemList = pcb->GetItemSet();
+    PICKED_ITEMS_LIST  deletedItemsList;
+    int                addedOrDeleted = 0;
+
+    for( unsigned int i = 0; i < oldBuffer->GetCount(); i++ )
+    {
+        BOARD_ITEM* item = (BOARD_ITEM*) oldBuffer->GetPickedItem( i );
+
+        if( currItemList.find( item ) == currItemList.end() )
+        {
+            deletedItemsList.PushItem( ITEM_PICKER( nullptr, item, UNDO_REDO::DELETED ) );
+            commit.Removed( item );
+            addedOrDeleted++;
+        }
+    }
+
+    for( unsigned int i = 0; i < deletedItemsList.GetCount(); i++ )
+        oldBuffer->PushItem( deletedItemsList.GetItemWrapper( i ) );
+
+    auto addNew =
+            [&]( BOARD_ITEM* item )
+            {
+                if( !oldBuffer->ContainsItem( item ) )
+                {
+                    oldBuffer->PushItem( ITEM_PICKER( nullptr, item, UNDO_REDO::NEWITEM ) );
+                    commit.Added( item );
+                    addedOrDeleted++;
+                }
+            };
+
+    for( FOOTPRINT* item : pcb->Footprints() )
+        addNew( item );
+
+    for( PCB_TRACK* item : pcb->Tracks() )
+        addNew( item );
+
+    for( BOARD_ITEM* item : pcb->Drawings() )
+        addNew( item );
+
+    for( ZONE* zone : pcb->Zones() )
+        addNew( zone );
+
+    const bool changed = addedOrDeleted > 0 || formatBoardForCompare( pcb ) != before;
+
+    if( !changed )
+    {
+        // 変えなかった回は、空の「元に戻す」の段を作らない
+        ClearListAndDeleteItems( oldBuffer );
+        delete oldBuffer;
+        output += wxString::FromUTF8( aOk ? "（基板は変えていない）\n" : "" );
+        return output;
+    }
+
+    OnModify();
+    PushCommandToUndoList( oldBuffer );
+    commit.Push( aDescription, SKIP_UNDO | SKIP_SET_DIRTY );
+    RebuildAndRefresh();
+
+    if( !aOk )
+    {
+        // 誤りの時は、その回の変更を取り消す（やり直しの一覧にも残さない）
+        m_toolManager->RunAction( ACTIONS::undo );
+        ClearUndoORRedoList( REDO_LIST );
+        output += wxString::FromUTF8( "（エラーのため、この回の変更は取り消した）\n" );
+        return output;
+    }
+
+    output += wxString::FromUTF8( "（変更を基板へ反映した。「元に戻す」1 回で戻せる: " )
+              + aDescription + wxS( "）\n" );
+    return output;
+}
