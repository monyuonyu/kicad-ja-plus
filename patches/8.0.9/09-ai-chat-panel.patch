+"""KiCad の AI チャットの準備: 専用の Python の環境（venv）を作り、要るものを入れる
+
+使い方: python3 setup_ai.py [--venv 場所]
+既定の場所: Linux ~/.local/share/kicad-ja-plus/ai-venv、Windows %LOCALAPPDATA%\\kicad-ja-plus\\ai-venv
+（KiCad の AI チャットは、ここを既定で探す。別の場所にしたら KICAD_AI_PYTHON でその python を指す）
+"""
+
+import argparse
+import os
+import subprocess
+import sys
+import venv
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def default_venv():
+    if sys.platform == "win32":
+        base = os.environ.get("LOCALAPPDATA", os.path.expanduser("~"))
+    else:
+        base = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
+    return os.path.join(base, "kicad-ja-plus", "ai-venv")
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--venv", default=default_venv())
+    a = ap.parse_args()
+    if sys.version_info < (3, 10):
+        sys.exit("Python 3.10 以降が要る（今は %d.%d）" % sys.version_info[:2])
+    print("環境を作る:", a.venv, flush=True)
+    venv.EnvBuilder(with_pip=True, upgrade=False).create(a.venv)
+    py = os.path.join(a.venv, "Scripts", "python.exe") if sys.platform == "win32" else os.path.join(a.venv, "bin", "python")
+    subprocess.check_call([py, "-m", "pip", "install", "--upgrade", "pip"])
+    subprocess.check_call([py, "-m", "pip", "install", "-r", os.path.join(HERE, "requirements.txt")])
+    subprocess.check_call([py, "-c", "import claude_agent_sdk, keyring"])
+    print("できた:", py)
+
+
+if __name__ == "__main__":
+    main()
