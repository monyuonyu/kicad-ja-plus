+// この枠の文言は日本語で書く（このフォークは日本語の利用者向け。本家の翻訳の仕組みは通さない）
+static wxString J( const char* aText )
+{
+    return wxString::FromUTF8( aText );
+}
+
+
+static wxString envOr( const wxString& aName, const wxString& aDefault = wxEmptyString )
+{
+    wxString value;
+
+    if( wxGetEnv( aName, &value ) && !value.IsEmpty() )
+        return value;
+
+    return aDefault;
+}
+
+
+/// 仲介役の Python の置き場の既定（scripting/kicad_ai/setup_ai.py が作る場所と同じ）
+static wxString defaultVenvPython()
+{
+    wxFileName fn;
+#ifdef __WINDOWS__
+    fn.AssignDir( envOr( wxS( "LOCALAPPDATA" ), wxGetHomeDir() ) );
+    fn.AppendDir( wxS( "kicad-ja-plus" ) );
+    fn.AppendDir( wxS( "ai-venv" ) );
+    fn.AppendDir( wxS( "Scripts" ) );
+    fn.SetFullName( wxS( "python.exe" ) );
+#else
+    fn.AssignDir( envOr( wxS( "XDG_DATA_HOME" ), wxGetHomeDir() + wxS( "/.local/share" ) ) );
+    fn.AppendDir( wxS( "kicad-ja-plus" ) );
+    fn.AppendDir( wxS( "ai-venv" ) );
+    fn.AppendDir( wxS( "bin" ) );
+    fn.SetFullName( wxS( "python" ) );
+#endif
+    return fn.GetFullPath();
+}
+
+
+/// インストーラーに同梱した AI 用の Python（<KiCad>/ai-runtime。準備なしで、オフラインでも入っている）
+static wxString bundledPython()
+{
+    wxFileName fn( wxStandardPaths::Get().GetExecutablePath() );
+    fn.RemoveLastDir();  // bin
+    fn.AppendDir( wxS( "ai-runtime" ) );
+#ifdef __WINDOWS__
+    fn.SetFullName( wxS( "python.exe" ) );
+#else
+    fn.AppendDir( wxS( "bin" ) );
+    fn.SetFullName( wxS( "python3" ) );
+#endif
+    return fn.GetFullPath();
+}
