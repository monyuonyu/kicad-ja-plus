+void PANEL_AI_CHAT::append( ROLE aRole, const wxString& aText )
+{
+    wxTextAttr attr;
+    wxString   prefix;
+
+    switch( aRole )
+    {
+    case ROLE::USER:
+        attr.SetTextColour( wxColour( 0x1f, 0x5f, 0xbf ) );
+        attr.SetFontWeight( wxFONTWEIGHT_BOLD );
+        prefix = J( "あなた: " );
+        break;
+    case ROLE::AI:
+        appendMarkdown( aText );
+        return;
+    case ROLE::TOOL:
+        attr.SetTextColour( wxColour( 0x80, 0x80, 0x80 ) );
+        prefix = wxS( "… " );
+        break;
+    case ROLE::INFO:
+        attr.SetTextColour( wxColour( 0x40, 0x80, 0x40 ) );
+        break;
+    case ROLE::FAIL:
+        attr.SetTextColour( wxColour( 0xc0, 0x30, 0x30 ) );
+        break;
+    }
+
+    m_log->SetDefaultStyle( attr );
+    m_log->AppendText( prefix + aText + wxS( "\n\n" ) );
+    m_log->ShowPosition( m_log->GetLastPosition() );
+}
+
+
+/**
+ * AI の返事（Markdown）を、読みやすい程度に整えて足す。
+ * HTML の窓は日本語を折り返さないので使わず、見出しと **太字** は太字、箇条書きは「・」にする。
+ * 下線（_）は強調として扱わない（lib_footprint_issues のような名前を崩さない）。
+ */
+void PANEL_AI_CHAT::appendMarkdown( const wxString& aText )
+{
+    wxTextAttr normal;
+    normal.SetTextColour( GetForegroundColour() );
+    normal.SetFontWeight( wxFONTWEIGHT_NORMAL );
+
+    wxTextAttr bold = normal;
+    bold.SetFontWeight( wxFONTWEIGHT_BOLD );
+
+    wxArrayString lines = wxSplit( aText, '\n', '\0' );
+    bool          inCode = false;
+
+    for( wxString line : lines )
+    {
+        wxString trimmed = wxString( line ).Trim( false );
+
+        if( trimmed.StartsWith( wxS( "```" ) ) )
+        {
+            inCode = !inCode;
+            continue;
+        }
+
+        bool heading = false;
+
+        if( !inCode )
+        {
+            if( trimmed == wxS( "---" ) || trimmed == wxS( "***" ) )
+                continue;
+
+            if( trimmed.StartsWith( wxS( "#" ) ) )
+            {
+                line = trimmed.AfterFirst( ' ' );
+                heading = true;
+            }
+            else if( trimmed.StartsWith( wxS( "- " ) ) || trimmed.StartsWith( wxS( "* " ) ) )
+            {
+                wxString indent = line.Left( line.length() - trimmed.length() );
+                line = indent + J( "・" ) + trimmed.Mid( 2 );
+            }
+
+            line.Replace( wxS( "`" ), wxEmptyString );
+        }
+
+        // **太字** の区切りで、普通と太字を交互に書く（見出しは全部太字）
+        wxString rest = line;
+        bool     isBold = heading;
+
+        auto write = [&]( const wxString& aPart )
+        {
+            m_log->SetDefaultStyle( isBold ? bold : normal );
+            m_log->AppendText( aPart );
+        };
+
+        for( int pos; !inCode && ( pos = rest.Find( wxS( "**" ) ) ) != wxNOT_FOUND; )
+        {
+            write( rest.Left( pos ) );
+            rest = rest.Mid( pos + 2 );
+            isBold = heading || !isBold;
+        }
+
+        write( rest );
+        m_log->AppendText( wxS( "\n" ) );
+    }
+
+    m_log->AppendText( wxS( "\n" ) );
+    m_log->ShowPosition( m_log->GetLastPosition() );
+}
