+
+bool PANEL_AI_CHAT::checkPrerequisites()
+{
+    // 8.0.9 は IPC API が無いので、基板は KiCad の中の Python で読み書きする（API サーバーは要らない）
+    if( !wxFileName::FileExists( bridgePath() ) )
+    {
+        append( ROLE::FAIL, wxString::Format( J( "AI の仲介役が見つかりません: %s" ), bridgePath() ) );
+        return false;
+    }
+
+    if( !wxFileName::FileExists( pythonPath() ) )
+    {
+        int answer = wxMessageBox( wxString::Format(
+                                           J( "AI チャットの準備ができていません。\n\n"
+                                              "専用の Python の環境を作り、要るもの（Claude Agent SDK）を"
+                                              "インターネットから入れます。数分かかります。\n\n"
+                                              "場所: %s\n\n準備しますか？" ),
+                                           venvDir() ),
+                                   J( "AI チャット" ), wxYES_NO | wxICON_QUESTION, m_frame );
+
+        if( answer == wxYES )
+            runSetup();
+        else
+            append( ROLE::FAIL, wxString::Format( J( "準備するには、次を実行してください:\n"
+                                                      "python3 \"%s\"" ),
+                                                   wxFileName( bridgePath() ).GetPathWithSep()
+                                                           + wxS( "setup_ai.py" ) ) );
+        return false;
+    }
+
+    return true;
+}
+
+
+wxString PANEL_AI_CHAT::pythonPath() const
+{
+    // 指定 → 同梱の AI 用の Python → 自分で準備した環境 の順
+    if( !envOr( wxS( "KICAD_AI_PYTHON" ) ).IsEmpty() )
+        return envOr( wxS( "KICAD_AI_PYTHON" ) );
+
+    if( wxFileName::FileExists( bundledPython() ) )
+        return bundledPython();
+
+    return defaultVenvPython();
+}
+
+
+wxString PANEL_AI_CHAT::venvDir() const
+{
+    wxFileName fn( pythonPath() );
+    fn.RemoveLastDir();  // bin（Windows は Scripts）
+    return fn.GetPath();
+}
+
+
+wxString PANEL_AI_CHAT::bridgePath() const
+{
+    // 8.0.9 の GetStockScriptingPath() は末尾に区切りが付かないので、wxFileName で組む
+    wxFileName fn;
+    fn.AssignDir( PATHS::GetStockScriptingPath() );
+    fn.AppendDir( wxS( "kicad_ai" ) );
+    fn.SetFullName( wxS( "bridge.py" ) );
+    return envOr( wxS( "KICAD_AI_BRIDGE" ), fn.GetFullPath() );
+}
+
+
+void PANEL_AI_CHAT::runSetup()
+{
+    // 準備は、システムの Python（3.10 以降）で setup_ai.py を動かす（出力はこの枠に流す）
+    wxString      setup = wxFileName( bridgePath() ).GetPathWithSep() + wxS( "setup_ai.py" );
+    wxArrayString candidates;
+
+    if( !envOr( wxS( "KICAD_AI_SETUP_PYTHON" ) ).IsEmpty() )
+        candidates.Add( wxString::Format( wxS( "\"%s\"" ), envOr( wxS( "KICAD_AI_SETUP_PYTHON" ) ) ) );
+
+#ifdef __WINDOWS__
+    candidates.Add( wxS( "py -3" ) );
+    candidates.Add( wxS( "python" ) );
+#else
+    candidates.Add( wxS( "python3" ) );
+#endif
+
+    wxString py;
+
+    for( const wxString& c : candidates )
+    {
+        wxArrayString out, err;
+        wxString      check = c + wxS( " -c \"import sys, venv; sys.exit(0 if sys.version_info >= (3, 10) else 1)\"" );
+
+        if( wxExecute( check, out, err, wxEXEC_SYNC | wxEXEC_HIDE_CONSOLE ) == 0 )
+        {
+            py = c;
+            break;
+        }
+    }
+
+    if( py.IsEmpty() )
+    {
+        append( ROLE::FAIL, J( "Python 3.10 以降が見つかりません。python.org から入れてから、"
+                                "もう一度この枠を開いてください。" ) );
+        return;
+    }
+
+    wxString cmd = wxString::Format( wxS( "%s \"%s\"" ), py, setup );
+
+    // 数分かかるので、裏で走らせて出力をこの枠に流す（画面は止めない）
+    append( ROLE::INFO, J( "準備しています（数分かかります）…" ) );
+    m_status->SetLabel( J( "準備しています…" ) );
+    m_sendButton->Enable( false );
+
+    wxExecuteEnv env;
+    wxGetEnvMap( &env.env );
+    env.env[wxS( "PYTHONUNBUFFERED" )] = wxS( "1" );
+    env.env[wxS( "PYTHONIOENCODING" )] = wxS( "utf-8" );
+
+    m_setupBuf.clear();
+    m_setupProcess = new wxProcess();  // 終わったら wx が消す
+    m_setupProcess->Redirect();
+    m_setupProcess->Bind( wxEVT_END_PROCESS, &PANEL_AI_CHAT::onSetupEnd, this );
+
+    if( wxExecute( cmd, wxEXEC_ASYNC | wxEXEC_HIDE_CONSOLE, m_setupProcess, &env ) <= 0 )
+    {
+        delete m_setupProcess;
+        m_setupProcess = nullptr;
+        m_sendButton->Enable( true );
+        append( ROLE::FAIL, wxString::Format( J( "準備を始められませんでした（%s）。" ), cmd ) );
+        return;
+    }
+
+    m_timer.Start( 200 );
+}
+
+
+void PANEL_AI_CHAT::onSetupEnd( wxProcessEvent& aEvent )
+{
+    readOutput();
+    m_setupProcess = nullptr;
+    aEvent.Skip();  // wxProcess は wx が消す
+
+    if( !m_process )
+        m_timer.Stop();
+
+    m_status->SetLabel( wxEmptyString );
+    m_sendButton->Enable( true );
+
+    if( aEvent.GetExitCode() != 0 || !wxFileName::FileExists( pythonPath() ) )
+    {
+        append( ROLE::FAIL, wxString::Format( J( "準備に失敗しました（終了コード %d）。上の出力を見てください。" ),
+                                               aEvent.GetExitCode() ) );
+        return;
+    }
+
+    append( ROLE::INFO, J( "準備ができました。" ) );
+    startBridge();
+}
+
+
+void PANEL_AI_CHAT::startBridge()
+{
+    if( m_process )
+        return;
+
+    wxExecuteEnv env;
+    wxGetEnvMap( &env.env );
+    // DRC と画像は、基板の写しに kicad-cli をかける。この KiCad と同じ場所の kicad-cli を使う
+    if( env.env.find( wxS( "KICAD_AI_CLI" ) ) == env.env.end() )
+    {
+        wxFileName cli( wxStandardPaths::Get().GetExecutablePath() );
+#ifdef __WINDOWS__
+        cli.SetFullName( wxS( "kicad-cli.exe" ) );
+#else
+        cli.SetFullName( wxS( "kicad-cli" ) );
+#endif
+        if( cli.FileExists() )
+            env.env[wxS( "KICAD_AI_CLI" )] = cli.GetFullPath();
+    }
+    env.env[wxS( "PYTHONIOENCODING" )] = wxS( "utf-8" );
+    env.env[wxS( "PYTHONUNBUFFERED" )] = wxS( "1" );
+
+    wxString cmd = wxString::Format( wxS( "\"%s\" \"%s\" --model %s" ), pythonPath(), bridgePath(),
+                                     envOr( wxS( "KICAD_AI_MODEL" ), wxS( "opus" ) ) );
+
+    // この PC の claude のログインを使う（本人が自分の PC で使うときだけ。配る版の既定は API キー）
+    if( envOr( wxS( "KICAD_AI_LOCAL_LOGIN" ) ) == wxS( "1" ) )
+        cmd << wxS( " --local-login" );
+
+    if( !envOr( wxS( "KICAD_AI_CLAUDE" ) ).IsEmpty() )
+        cmd << wxString::Format( wxS( " --claude \"%s\"" ), envOr( wxS( "KICAD_AI_CLAUDE" ) ) );
+
+    // 親は持たせない: 終わったときの通知はここで受け、後片付け（delete）は wx に任せる
+    m_process = new wxProcess();
+    m_process->Redirect();
+    m_process->Bind( wxEVT_END_PROCESS, &PANEL_AI_CHAT::onProcessEnd, this );
+
+    int flags = wxEXEC_ASYNC | wxEXEC_HIDE_CONSOLE;
+#ifndef __WINDOWS__
+    flags |= wxEXEC_MAKE_GROUP_LEADER;  // 止めるときに、仲介役が起動した claude も一緒に止める
+#endif
+    m_pid = wxExecute( cmd, flags, m_process, &env );
+
+    if( m_pid <= 0 )
+    {
+        append( ROLE::FAIL, wxString::Format( J( "AI の仲介役を起動できませんでした: %s" ), cmd ) );
+        delete m_process;
+        m_process = nullptr;
+        return;
+    }
+
+    m_ready = false;
+    m_outBuf.clear();
+    m_errBuf.clear();
+    m_status->SetLabel( J( "AI に接続しています…" ) );
+    m_timer.Start( 100 );
+}
+
+
+void PANEL_AI_CHAT::stopBridge()
+{
+    m_timer.Stop();
+
+    if( !m_process )
+        return;
+
+    // 標準入力を閉じると、仲介役は自分で終わる。残ったら止める
+    m_process->Unbind( wxEVT_END_PROCESS, &PANEL_AI_CHAT::onProcessEnd, this );
+    m_process->CloseOutput();
+
+    if( wxProcess::Exists( m_pid ) )
+        wxProcess::Kill( m_pid, wxSIGTERM, wxKILL_CHILDREN );
+
+    // 終わったら wx が消す（この枠はもう通知を受けない）
+    m_process = nullptr;
+    m_pid = 0;
+    m_ready = false;
+}
+
+
+void PANEL_AI_CHAT::sendJson( const std::string& aLine )
+{
+    if( !m_process || !m_process->GetOutputStream() )
+        return;
+
+    std::string line = aLine + "\n";
+    m_process->GetOutputStream()->Write( line.data(), line.size() );
+}
+
+
+void PANEL_AI_CHAT::onTimer( wxTimerEvent& aEvent )
+{
+    readOutput();
+}
+
+
+void PANEL_AI_CHAT::readOutput()
+{
+    if( m_setupProcess )
+    {
+        // 準備の出力（stdout と stderr）を行ごとに流す
+        for( wxInputStream* stream : { m_setupProcess->GetInputStream(), m_setupProcess->GetErrorStream() } )
+        {
+            char buf[4096];
+
+            while( stream && stream->CanRead() )
+            {
+                stream->Read( buf, sizeof( buf ) );
+
+                if( stream->LastRead() == 0 )
+                    break;
+
+                m_setupBuf.append( buf, stream->LastRead() );
+            }
+        }
+
+        size_t pos;
+
+        while( ( pos = m_setupBuf.find( '\n' ) ) != std::string::npos )
+        {
+            wxString line = wxString::FromUTF8( m_setupBuf.substr( 0, pos ) ).Trim();
+            m_setupBuf.erase( 0, pos + 1 );
+
+            // pip の細かい進み具合は出さない
+            if( !line.IsEmpty() && !line.StartsWith( wxS( "  " ) ) )
+                append( ROLE::TOOL, line );
+        }
+    }
+
+    if( !m_process )
+        return;
+
+    auto drain = []( wxInputStream* aStream, std::string& aBuf )
+    {
+        char buf[4096];
+
+        while( aStream && aStream->CanRead() )
+        {
+            aStream->Read( buf, sizeof( buf ) );
+            size_t n = aStream->LastRead();
+
+            if( n == 0 )
+                break;
+
+            aBuf.append( buf, n );
+        }
+    };
+
+    drain( m_process->GetInputStream(), m_outBuf );
+    drain( m_process->GetErrorStream(), m_errBuf );
+
+    // 仲介役の stderr は最後の方だけ残す（落ちたときの説明に使う）
+    if( m_errBuf.size() > 8000 )
+        m_errBuf.erase( 0, m_errBuf.size() - 8000 );
+
+    size_t pos;
+
+    while( m_process && ( pos = m_outBuf.find( '\n' ) ) != std::string::npos )
+    {
+        std::string line = m_outBuf.substr( 0, pos );
+        m_outBuf.erase( 0, pos + 1 );
+
+        if( !line.empty() )
+            handleLine( line );
+    }
+}
+
+
+void PANEL_AI_CHAT::handleLine( const std::string& aLine )
+{
+    nlohmann::json msg = nlohmann::json::parse( aLine, nullptr, false );
+
+    if( msg.is_discarded() || !msg.is_object() )
+        return;
+
+    std::string type = msg.value( "type", "" );
+    auto str = [&]( const char* aKey )
+    {
+        return wxString::FromUTF8( msg.value( aKey, std::string() ) );
+    };
+
+    if( type == "ready" )
+    {
+        m_ready = true;
+        m_status->SetLabel( wxEmptyString );
+
+        if( !m_pending.IsEmpty() )
+        {
+            wxString text = m_pending;
+            m_pending.Clear();
+            sendJson( nlohmann::json( { { "type", "user" }, { "text", text.ToStdString( wxConvUTF8 ) } } ).dump() );
+            setBusy( true );
+        }
+    }
+    else if( type == "text" )
+    {
+        append( ROLE::AI, str( "text" ) );
+    }
+    else if( type == "tool" )
+    {
+        append( ROLE::TOOL, str( "text" ) );
+    }
+    else if( type == "approve" )
+    {
+        askApproval( msg.value( "id", 0 ), str( "description" ), str( "code" ) );
+    }
+    else if( type == "py" )
+    {
+        // 仲介役からの依頼: KiCad の中の Python で実行する。基板を変える実行は、この画面で承認した番号だけ
+        int  id = msg.value( "id", 0 );
+        bool write = msg.value( "write", false );
+        bool ok = false;
+        wxString out;
+
+        if( write && !m_approved.count( id ) )
+        {
+            out = J( "承認されていない実行なので、実行しなかった" );
+        }
+        else
+        {
+            m_approved.erase( id );
+            m_timer.Stop();     // 実行の間に次の行を処理して入れ子にならないように
+            out = m_frame->RunAiPython( msg.value( "code", std::string() ), write, str( "description" ), ok );
+
+            if( m_process )
+                m_timer.Start( 100 );
+        }
+
+        sendJson( nlohmann::json( { { "type", "py_result" }, { "id", id }, { "ok", ok },
+                                    { "output", out.ToStdString( wxConvUTF8 ) } } ).dump() );
+    }
+    else if( type == "done" )
+    {
+        setBusy( false );
+
+        if( msg.contains( "error" ) && msg["error"].is_string() )
+            append( ROLE::FAIL, wxString::Format( J( "エラー: %s" ), str( "error" ) ) );
+    }
+    else if( type == "bad_key" )
+    {
+        append( ROLE::FAIL, J( "API キーが正しくありません。入れ直してください。" ) );
+        setBusy( false );
+        stopBridge();
+        askApiKey();
+    }
+    else if( type == "need_key" )
+    {
+        stopBridge();
+        askApiKey();
+    }
+    else if( type == "fatal" )
+    {
+        append( ROLE::FAIL, str( "text" ) );
+        setBusy( false );
+    }
+}
+
+
+void PANEL_AI_CHAT::askApproval( int aId, const wxString& aDescription, const wxString& aCode )
+{
+    // たずねている間は読むのを止める（ダイアログの中で次の行を処理して入れ子にならないように）
+    m_timer.Stop();
+
+    DIALOG_AI_APPROVE dlg( m_frame, aDescription, aCode );
+    bool              ok = dlg.ShowModal() == wxID_OK;
+
+    if( m_process )
+        m_timer.Start( 100 );
+
+    if( ok )
+        m_approved.insert( aId );
+    else
+        append( ROLE::TOOL, wxString::Format( J( "実行しませんでした: %s" ), aDescription ) );
+
+    sendJson( nlohmann::json( { { "type", "approval" }, { "id", aId }, { "ok", ok } } ).dump() );
+}
+
+
+void PANEL_AI_CHAT::askApiKey()
+{
+    wxPasswordEntryDialog dlg( m_frame,
+                               J( "AI には、あなたの Anthropic の API キーを使います。\n"
+                                  "キーは OS の鍵保管庫に保存され、この PC から外へは Anthropic にだけ送られます。\n"
+                                  "（キーは https://console.anthropic.com で作れます）" ),
+                               J( "AI チャット: API キー" ) );
+
+    if( dlg.ShowModal() != wxID_OK || dlg.GetValue().Trim().Trim( false ).IsEmpty() )
+    {
+        append( ROLE::FAIL, J( "API キーが無いので、AI を使えません。" ) );
+        return;
+    }
+
+    // キーはコマンドラインに載せず、環境変数で渡す（この子プロセスにだけ）
+    wxExecuteEnv env;
+    wxGetEnvMap( &env.env );
+    env.env[wxS( "KICAD_AI_KEY_IN" )] = dlg.GetValue().Trim().Trim( false );
+
+    wxString      cmd = wxString::Format( wxS( "\"%s\" \"%s\" --store-key" ), pythonPath(), bridgePath() );
+    wxArrayString out, err;
+    long          code;
+
+    {
+        wxBusyCursor busy;
+        code = wxExecute( cmd, out, err, wxEXEC_SYNC | wxEXEC_HIDE_CONSOLE, &env );
+    }
+
+    if( code != 0 )
+    {
+        append( ROLE::FAIL, wxString::Format( J( "API キーを保存できませんでした。\n%s" ),
+                                               wxJoin( err, '\n', '\0' ) ) );
+        return;
+    }
+
+    append( ROLE::INFO, J( "API キーを保存しました。" ) );
+    startBridge();
+}
+
+
+void PANEL_AI_CHAT::onSend( wxCommandEvent& aEvent )
+{
+    wxString text = m_input->GetValue().Trim().Trim( false );
+
+    if( text.IsEmpty() || m_busy )
+        return;
+
+    m_input->Clear();
+    append( ROLE::USER, text );
+
+    if( !m_process )
+    {
+        if( !checkPrerequisites() )
+            return;
+
+        startBridge();
+    }
+
+    if( !m_ready )
+    {
+        m_pending = text;
+        setBusy( true );
+        return;
+    }
+
+    sendJson( nlohmann::json( { { "type", "user" }, { "text", text.ToStdString( wxConvUTF8 ) } } ).dump() );
+    setBusy( true );
+}
+
+
+void PANEL_AI_CHAT::onStop( wxCommandEvent& aEvent )
+{
+    sendJson( R"({"type": "interrupt"})" );
+    m_status->SetLabel( J( "止めています…" ) );
+}
+
+
+void PANEL_AI_CHAT::onReset( wxCommandEvent& aEvent )
+{
+    m_log->Clear();
+    m_pending.Clear();
+
+    if( m_process )
+    {
+        sendJson( R"({"type": "reset"})" );
+        m_ready = false;
+        m_status->SetLabel( J( "新しい会話を始めています…" ) );
+    }
+
+    setBusy( false );
+}
+
+
+void PANEL_AI_CHAT::onInputKey( wxKeyEvent& aEvent )
+{
+    if( ( aEvent.GetKeyCode() == WXK_RETURN || aEvent.GetKeyCode() == WXK_NUMPAD_ENTER )
+        && !aEvent.ShiftDown() )
+    {
+        wxCommandEvent dummy;
+        onSend( dummy );
+        return;
+    }
+
+    aEvent.Skip();
+}
+
+
+void PANEL_AI_CHAT::onProcessEnd( wxProcessEvent& aEvent )
+{
+    // 残った出力を読んでから片付ける
+    readOutput();
+
+    m_timer.Stop();
+    int code = aEvent.GetExitCode();
+
+    // wxProcess は、この通知を Skip すると wx が消す
+    m_process = nullptr;
+    aEvent.Skip();
+
+    m_pid = 0;
+    m_ready = false;
+    setBusy( false );
+
+    if( code != 0 )
+    {
+        wxString err = wxString::FromUTF8( m_errBuf );
+
+        if( err.length() > 1500 )
+            err = wxS( "…" ) + err.Right( 1500 );
+
+        append( ROLE::FAIL, wxString::Format( J( "AI の仲介役が終了しました（%d）。\n%s" ), code, err ) );
+    }
+}
