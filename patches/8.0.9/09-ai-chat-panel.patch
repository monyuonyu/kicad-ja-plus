diff --git a/scripting/kicad_ai/bridge.py b/scripting/kicad_ai/bridge.py
new file mode 100644
index 0000000..e70773c
--- /dev/null
+++ b/scripting/kicad_ai/bridge.py
@@ -0,0 +1,489 @@
+"""KiCad の AI チャットの仲介役（KiCad 8.0.9 版。KiCad の外の Python で動く。claude-agent-sdk が要る）
+
+KiCad（PANEL_AI_CHAT）とは標準入出力の JSON 行でやり取りする。
+  KiCad → ここ: {"type": "user", "text"} / {"type": "approval", "id", "ok"} /
+                {"type": "py_result", "id", "ok", "output"} / {"type": "interrupt"} / {"type": "reset"}
+  ここ → KiCad: {"type": "ready"} / {"type": "text", "text"} / {"type": "tool", "text"} /
+                {"type": "approve", "id", "code", "description"} /
+                {"type": "py", "id", "code", "write", "description"} / {"type": "done", "error"} /
+                {"type": "need_key"} / {"type": "fatal", "text"}
+8.0.9 には IPC API が無いので、基板を読む・直すのは KiCad の中の Python（pcbnew）で行う
+（「py」で頼み、「py_result」で結果を受ける）。基板を変える実行（write）は、KiCad の画面で利用者が承認した
+番号のものだけを KiCad が受け付ける（毎回）。1 回の実行が「元に戻す」の 1 段になる。
+"""
+
+import argparse
+import asyncio
+import base64
+import collections
+import itertools
+import json
+import os
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+# API キーの置き場所: OS の鍵保管庫（Windows の資格情報マネージャー・macOS のキーチェーン・Linux の Secret Service）。
+# 使えない環境（鍵保管庫の無い Linux など）では、本人だけが読めるファイル
+KEY_SERVICE = "kicad-ja-plus"
+KEY_USER = "anthropic-api-key"
+
+# 本人用: この環境変数に Claude の長期トークン（claude setup-token で発行）があれば、API キーの代わりに使う。
+# 読んだらすぐ環境から消す（AI のコードや kicad-cli の子プロセスに渡さない）。FreeCAD の AI チャットと同じ名前
+TOKEN_ENV = "JA_CLAUDE_OAUTH_TOKEN"
+
+
+def _key_file(datadir):
+    return os.path.join(datadir, "ai-api-key")
+
+
+def store_key(key, datadir):
+    try:
+        import keyring
+        keyring.set_password(KEY_SERVICE, KEY_USER, key)
+        return "keyring"
+    except Exception:
+        path = _key_file(datadir)
+        os.makedirs(datadir, exist_ok=True)
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+        with os.fdopen(fd, "w") as f:
+            f.write(key)
+        return "file"
+
+
+def load_key(datadir):
+    try:
+        import keyring
+        k = keyring.get_password(KEY_SERVICE, KEY_USER)
+        if k:
+            return k
+    except Exception:
+        pass
+    try:
+        with open(_key_file(datadir)) as f:
+            return f.read().strip() or None
+    except OSError:
+        return None
+
+
+def delete_key(datadir):
+    try:
+        import keyring
+        keyring.delete_password(KEY_SERVICE, KEY_USER)
+    except Exception:
+        pass
+    try:
+        os.remove(_key_file(datadir))
+    except OSError:
+        pass
+
+
+SYSTEM = """あなたは KiCad の基板エディタに組み込まれた設計の助手です。利用者と同じ基板を見ながら、
+調べ、直します。答えは日本語で、短く具体的に。
+答えを出す枠は狭い文字の窓なので、表は使わず、見出し・箇条書き・**太字** だけで書く。
+
+道具（mcp__kicad__*）:
+- get_board: 開いている基板の概要（部品・ネット・配線・ベタ・層）と、今の選択
+- run_python: 開いている基板に Python を KiCad の中で実行する（KiCad 8 の pcbnew のスクリプトの API）。
+  実行の前に利用者が承認する。使える名前: pcbnew、board（開いている基板。pcbnew.GetBoard()）、
+  FromMM / ToMM（from_mm / to_mm も同じ）、VECTOR2I。
+  例: fp = board.FindFootprintByReference("R1"); fp.SetPosition(VECTOR2I(FromMM(10), FromMM(20)))、
+  線は t = pcbnew.PCB_TRACK(board); t.SetStart(...); t.SetEnd(...); t.SetWidth(FromMM(0.25));
+  t.SetLayer(pcbnew.F_Cu); t.SetNet(board.FindNet("GND")); board.Add(t)、消すのは board.Remove(item)。
+  1 回の実行が「元に戻す」の 1 段になり、エラーが起きたらその回の変更は取り消される。print の出力と、
+  最後の式の値が返る。変えたものは実行の中ですぐ読み直せる
+- check: 基板の写しを保存して DRC をかけ、違反と未配線の一覧を返す（開いている基板は変えない）
+- render: 基板の写しを画像にして見る（上・下・斜め）
+
+進め方:
+- 変える前に get_board で今の状態を見る。部品はリファレンス（R1 など）で指す
+- 長さは mm で考え、pcbnew には FromMM で渡す（内部の単位は nm）
+- 変えたら check と render で確かめてから「できた」と言う。確かめていないことは、確かめていないと言う
+- 利用者のファイルを保存・上書き・削除するのは、頼まれたときだけ
+- 何をしたかは、利用者が「元に戻す」で戻せることも含めて一言で伝える"""
+
+TOOLS = [
+    ("get_board", "開いている基板の概要（部品・ネット・配線・ベタ・層）と、今の選択を返す", {}, []),
+    ("run_python", "開いている基板に Python（KiCad 8 の pcbnew）を KiCad の中で実行する。利用者の承認の後に実行され、"
+                   "1 回が元に戻すの 1 段になる"
+                   "（エラーなら取り消す）。print の出力と、最後の式の値を返す",
+     {"code": {"type": "string", "description": "実行する Python"},
+      "description": {"type": "string", "description": "何をするか（承認の画面と元に戻すの一覧に出る。日本語で短く）"}},
+     ["code", "description"]),
+    ("check", "基板の写しに DRC をかけ、違反と未配線の一覧を返す",
+     {"refill_zones": {"type": "boolean", "description": "ベタを塗り直してから調べる（既定は true）"}}, []),
+    ("render", "基板の写しを画像にして返す",
+     {"side": {"type": "string", "enum": ["top", "bottom", "iso"], "description": "向き（既定は top）"}}, []),
+]
+
+
+def cli_env():
+    """kicad-cli を呼ぶときの環境。KiCad をビルドした場所から動かしているときの印は外す
+    （引き継ぐと、入れてある kicad-cli が自分の部品をビルドの場所で探して失敗する）"""
+    env = dict(os.environ)
+    env.pop("KICAD_RUN_FROM_BUILD_DIR", None)
+    return env
+
+
+def text(s, error=False):
+    return {"content": [{"type": "text", "text": s}], "is_error": error}
+
+
+# 基板の概要（KiCad の中で実行し、JSON を 1 行で出す）
+SUMMARY_CODE = r"""
+import json, collections
+b = board
+out = {"file": b.GetFileName(), "copper_layers": b.GetCopperLayerCount(), "footprints": 0, "nets": b.GetNetCount(),
+       "tracks": 0, "vias": 0, "zones": [], "parts": [], "selection": []}
+for t in b.GetTracks():
+    if t.Type() == pcbnew.PCB_VIA_T:
+        out["vias"] += 1
+    else:
+        out["tracks"] += 1
+for z in b.Zones():
+    out["zones"].append({"name": z.GetZoneName(), "net": z.GetNetname(),
+                         "layers": [b.GetLayerName(l) for l in z.GetLayerSet().Seq()]})
+fps = list(b.GetFootprints())
+out["footprints"] = len(fps)
+for fp in fps[:300]:
+    p = fp.GetPosition()
+    out["parts"].append({"ref": fp.GetReference(), "value": fp.GetValue(), "footprint": str(fp.GetFPID().Format()),
+                         "x_mm": round(ToMM(p.x), 3), "y_mm": round(ToMM(p.y), 3),
+                         "angle": round(fp.GetOrientationDegrees(), 1), "layer": b.GetLayerName(fp.GetLayer())})
+if len(fps) > 300:
+    out["parts_truncated"] = len(fps) - 300
+kinds = collections.Counter()
+for it in fps + list(b.GetTracks()) + list(b.GetDrawings()) + list(b.Zones()):
+    if not it.IsSelected():
+        continue
+    name = it.GetClass()
+    if name == "FOOTPRINT" and len(out["selection"]) < 50:
+        out["selection"].append({"type": name, "ref": it.GetReference()})
+    else:
+        kinds[name] += 1
+if kinds:
+    out["selection_counts"] = dict(kinds)
+print(json.dumps(out, ensure_ascii=False))
+"""
+
+# 基板の写しを保存する（開いている基板とそのファイルは変えない）。設計のルール（.kicad_pro / .kicad_dru）も写す
+SAVE_COPY_CODE = r"""
+import os, shutil
+dst = %r
+ok = pcbnew.SaveBoard(dst, board, True)
+src = board.GetFileName()
+if ok and src:
+    base, dbase = os.path.splitext(src)[0], os.path.splitext(dst)[0]
+    for ext in (".kicad_pro", ".kicad_dru"):
+        if os.path.exists(base + ext):
+            shutil.copyfile(base + ext, dbase + ext)
+print("SAVED" if ok else "FAILED")
+"""
+
+
+def kicad_cli():
+    return os.environ.get("KICAD_AI_CLI") or "kicad-cli"
+
+
+class Bridge:
+    def __init__(self, args):
+        self.args = args
+        self.ids = itertools.count(1)
+        self.pending = {}
+        self.inbox = asyncio.Queue()
+        self.client = None
+        self.busy = False
+        self.py_pending = {}
+
+    def send(self, **msg):
+        sys.stdout.write(json.dumps(msg, ensure_ascii=False) + "\n")
+        sys.stdout.flush()
+
+    async def py(self, code, write=False, description="", id_=None):
+        """KiCad の中で Python を実行してもらう。戻りは (ok, 出力)"""
+        n = id_ if id_ is not None else next(self.ids)
+        fut = asyncio.get_running_loop().create_future()
+        self.py_pending[n] = fut
+        self.send(type="py", id=n, code=code, write=write, description=description)
+        res = await fut
+        return bool(res.get("ok")), res.get("output", "")
+
+    async def save_copy(self):
+        os.makedirs(self.args.workdir, exist_ok=True)
+        d = tempfile.mkdtemp(prefix="copy_", dir=self.args.workdir)
+        name = "board.kicad_pcb"
+        ok, out = await self.py("import os\nprint(os.path.basename(board.GetFileName()) or 'board.kicad_pcb')")
+        if ok and out.strip():
+            name = out.strip().splitlines()[-1]
+        path = os.path.join(d, name)
+        ok, out = await self.py(SAVE_COPY_CODE % path)
+        if not ok or "SAVED" not in out:
+            raise RuntimeError(out.strip() or "保存できない")
+        return path
+
+    # --- 道具 ---
+
+    async def t_get_board(self, args):
+        self.send(type="tool", text="基板を見ています")
+        ok, out = await self.py(SUMMARY_CODE)
+        if not ok:
+            return text(out.strip() or "基板を読めない", True)
+        return text(out.strip().splitlines()[-1])
+
+    async def t_run_python(self, args):
+        code, desc = args.get("code", ""), args.get("description", "") or "AI の変更"
+        n = next(self.ids)
+        fut = asyncio.get_running_loop().create_future()
+        self.pending[n] = fut
+        self.send(type="approve", id=n, code=code, description=desc)
+        res = await fut
+        if not res.get("ok"):
+            return text("利用者が実行を承認しなかった" + (f"（{res['why']}）" if res.get("why") else ""), True)
+        self.send(type="tool", text=f"実行しています: {desc}")
+        # 承認した番号のまま頼む（KiCad は承認した番号の実行だけを受け付ける）
+        ok, out = await self.py(code, write=True, description=desc, id_=n)
+        return text(out.strip()[-20000:] or "(出力なし)", not ok)
+
+    async def t_check(self, args):
+        self.send(type="tool", text="DRC をかけています")
+        try:
+            path = await self.save_copy()
+        except Exception as e:
+            return text(f"基板の写しを保存できない: {e}", True)
+        rpt = path + ".drc.json"
+        cmd = [kicad_cli(), "pcb", "drc", "--format", "json", "--severity-error", "--severity-warning", "-o", rpt]
+        if args.get("refill_zones", True):
+            cmd.append("--refill-zones")
+        cmd.append(path)
+        p = await asyncio.to_thread(subprocess.run, cmd, capture_output=True, text=True, env=cli_env())
+        if not os.path.exists(rpt):
+            return text(f"DRC を実行できない: {p.stderr or p.stdout}", True)
+        with open(rpt, encoding="utf-8") as f:
+            d = json.load(f)
+        vs = d.get("violations", [])
+        un = d.get("unconnected_items", [])
+        lines = [f"違反 {len(vs)} 件、未配線 {len(un)} 件、回路図との食い違い {len(d.get('schematic_parity', []))} 件"]
+        for v in (vs + un)[:60]:
+            items = " / ".join(i.get("description", "") for i in v.get("items", [])[:2])
+            pos = v.get("pos") or (v.get("items") or [{}])[0].get("pos")
+            where = f" @({pos['x']:.2f}, {pos['y']:.2f})" if pos else ""
+            lines.append(f"- [{v.get('severity', '')}] {v.get('type', '')}: {v.get('description', '')}{where} — {items}")
+        if len(vs) + len(un) > 60:
+            lines.append(f"…ほか {len(vs) + len(un) - 60} 件")
+        return text("\n".join(lines))
+
+    async def t_render(self, args):
+        side = args.get("side") or "top"
+        self.send(type="tool", text="基板を画像にしています")
+        try:
+            path = await self.save_copy()
+        except Exception as e:
+            return text(f"基板の写しを保存できない: {e}", True)
+        png = path + f".{side}.png"
+        cmd = [kicad_cli(), "pcb", "render", "-o", png, "-w", "1200", "-h", "900", "--quality", "basic"]
+        if side == "iso":
+            cmd += ["--side", "top", "--rotate", "-45,0,45", "--perspective"]
+        else:
+            cmd += ["--side", side]
+        p = await asyncio.to_thread(subprocess.run, cmd + [path], capture_output=True, text=True, env=cli_env())
+        if not os.path.exists(png):
+            return text(f"画像にできない: {p.stderr or p.stdout}", True)
+        with open(png, "rb") as f:
+            data = base64.b64encode(f.read()).decode()
+        return {"content": [{"type": "image", "data": data, "mimeType": "image/png"}], "is_error": False}
+
+    def make_server(self):
+        def handler(name):
+            fn = getattr(self, "t_" + name)
+
+            async def run(args):
+                try:
+                    return await fn(args)
+                except Exception as e:  # KiCad が応えない・基板が開いていない など
+                    return text(f"{type(e).__name__}: {e}", True)
+            return run
+        tools = [tool(n, d, {"type": "object", "properties": p, "required": r, "additionalProperties": False})(handler(n))
+                 for n, d, p, r in TOOLS]
+        return create_sdk_mcp_server("kicad", tools=tools)
+
+    def options(self):
+        env = {"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1", "ENABLE_CLAUDEAI_MCP_SERVERS": "false"}
+        if self.oauth_token:
+            env["CLAUDE_CODE_OAUTH_TOKEN"] = self.oauth_token
+        elif self.api_key:
+            env["ANTHROPIC_API_KEY"] = self.api_key
+        os.makedirs(self.args.workdir, exist_ok=True)
+        return ClaudeAgentOptions(
+            model=self.args.model, system_prompt=SYSTEM,
+            cli_path=self.args.claude or None,
+            tools=[], allowed_tools=["mcp__kicad__*"], mcp_servers={"kicad": self.make_server()},
+            strict_mcp_config=True, setting_sources=[], cwd=self.args.workdir, max_turns=40, env=env)
+
+    # --- KiCad とのやり取り ---
+
+    def _stdin_thread(self, loop):
+        # Windows でも動くように、標準入力はスレッドで読む（asyncio のパイプは Windows で使えない）
+        for line in sys.stdin:
+            try:
+                msg = json.loads(line)
+            except ValueError:
+                continue
+            asyncio.run_coroutine_threadsafe(self.dispatch(msg), loop)
+        # KiCad が閉じた（落ちた）: 承認待ちも終わらせて、走っている回を止める
+        asyncio.run_coroutine_threadsafe(self.shutdown_pending("KiCad が終わった"), loop)
+        asyncio.run_coroutine_threadsafe(self.inbox.put(None), loop)
+
+    async def shutdown_pending(self, why):
+        for fut in list(self.pending.values()) + list(self.py_pending.values()):
+            if not fut.done():
+                fut.set_result({"ok": False, "why": why, "output": why})
+        self.pending.clear()
+        self.py_pending.clear()
+        if self.client is not None and self.busy:
+            try:
+                await self.client.interrupt()
+            except Exception:
+                pass
+
+    async def dispatch(self, msg):
+        if msg.get("type") == "py_result":
+            fut = self.py_pending.pop(msg.get("id"), None)
+            if fut and not fut.done():
+                fut.set_result(msg)
+        elif msg.get("type") == "approval":
+            fut = self.pending.pop(msg.get("id"), None)
+            if fut and not fut.done():
+                fut.set_result(msg)
+        elif msg.get("type") == "interrupt":
+            await self.shutdown_pending("止めた")
+        elif msg.get("type") == "reset":
+            await self.shutdown_pending("会話を始め直した")
+            await self.inbox.put(msg)
+        else:
+            await self.inbox.put(msg)
+
+    async def turn(self, s):
+        self.busy = True
+        error = None
+        said = []
+        try:
+            await self.client.query(s)
+            async for m in self.client.receive_response():
+                if isinstance(m, AssistantMessage):
+                    for b in m.content:
+                        if isinstance(b, TextBlock) and b.text.strip():
+                            said.append(b.text)
+                            self.send(type="text", text=b.text)
+                elif isinstance(m, ResultMessage) and m.is_error:
+                    # subtype は "success" のこともあるので、中身のある説明を選ぶ
+                    error = (getattr(m, "result", None) or "").strip() or \
+                        (m.subtype if m.subtype not in (None, "success") else "AI の回が失敗した")
+        except Exception as e:
+            error = "%s: %s" % (type(e).__name__, e)
+        finally:
+            self.busy = False
+        # 認証の失敗（401）: API キーなら KiCad に入れ直してもらう。長期トークンなら発行し直してもらう
+        if error is not None and any("401" in t or "authenticate" in t.lower() for t in said + [error]):
+            if self.oauth_token:
+                error = f"長期トークン（{TOKEN_ENV}）が正しくないか、期限が切れています。claude setup-token で発行し直してください"
+            else:
+                self.send(type="bad_key")
+                error = None
+        elif error is not None and error in said:
+            error = None  # 同じ説明はもう出した
+        self.send(type="done", error=error)
+
+    async def main(self):
+        # 認証: 利用者自身の API キー。本人用に、長期トークン（環境変数）か、この PC の claude のログイン（--local-login）も使える
+        self.oauth_token = os.environ.pop(TOKEN_ENV, "").strip() or None
+        if self.oauth_token or self.args.local_login:
+            # API キーがあると claude はそちらを使うので、環境からも外す
+            os.environ.pop("ANTHROPIC_API_KEY", None)
+            self.api_key = None
+        else:
+            self.api_key = load_key(self.args.datadir)
+        if not self.oauth_token and not self.args.local_login and not self.api_key:
+            self.send(type="need_key")
+            return
+        import threading
+        threading.Thread(target=self._stdin_thread, args=(asyncio.get_running_loop(),), daemon=True).start()
+        while True:
+            self.client = ClaudeSDKClient(options=self.options())
+            try:
+                await self.client.connect()
+            except Exception as e:
+                self.send(type="fatal", text="Claude に接続できない: %s" % e)
+                return
+            self.send(type="ready")
+            reset = False
+            while not reset:
+                msg = await self.inbox.get()
+                if msg is None:
+                    await self.client.disconnect()
+                    return
+                if msg.get("type") == "reset":
+                    reset = True
+                elif msg.get("type") == "user":
+                    await self.turn(msg["text"])
+            await self.client.disconnect()
+
+
+def default_datadir():
+    if sys.platform == "win32":
+        return os.path.join(os.environ.get("LOCALAPPDATA", os.path.expanduser("~")), "kicad-ja-plus")
+    return os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "kicad-ja-plus")
+
+
+def read_bundled_pth():
+    """同梱した部品（ai-runtime）の .pth を読む。pywin32（Windows で SDK が使う）は .pth で自分の場所を足すが、
+    PYTHONPATH で足した場所や、埋め込み用 Python の ._pth に書いた場所の .pth は、Python が読まない"""
+    import site
+    for p in list(sys.path):
+        if "ai-runtime" in p and os.path.isdir(p) and any(n.endswith(".pth") for n in os.listdir(p)):
+            site.addsitedir(p)
+
+
+def main():
+    # KiCad とのやり取りは UTF-8 の JSON 行（Windows のパイプは既定でロケールの符号 cp932 などになる）
+    for stream in (sys.stdin, sys.stdout, sys.stderr):
+        try:
+            stream.reconfigure(encoding="utf-8")
+        except Exception:
+            pass
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--datadir", default=default_datadir())
+    ap.add_argument("--local-login", action="store_true", help="API キーではなく、この PC の claude のログインを使う")
+    ap.add_argument("--store-key", action="store_true", help="標準入力の API キーを保管して終わる")
+    ap.add_argument("--delete-key", action="store_true", help="保管した API キーを消して終わる")
+    ap.add_argument("--model", default="opus")
+    ap.add_argument("--claude", default="", help="claude の実行ファイル（空なら SDK に同梱のもの）")
+    ap.add_argument("--workdir", default=os.path.join(tempfile.gettempdir(), "kicad-ai"))
+    ap.add_argument("--code-timeout", type=int, default=120)
+    args = ap.parse_args()
+    if args.store_key:
+        # キーは環境変数（KiCad から）か標準入力で受け取る。コマンドラインには載せない
+        key = (os.environ.pop("KICAD_AI_KEY_IN", "") or sys.stdin.read()).strip()
+        if not key:
+            sys.exit("キーが空")
+        print(store_key(key, args.datadir))
+        return
+    if args.delete_key:
+        delete_key(args.datadir)
+        return
+    read_bundled_pth()
+    global AssistantMessage, ClaudeAgentOptions, ClaudeSDKClient, ResultMessage, TextBlock
+    global create_sdk_mcp_server, tool
+    try:
+        from claude_agent_sdk import (AssistantMessage, ClaudeAgentOptions, ClaudeSDKClient, ResultMessage,
+                                      TextBlock, create_sdk_mcp_server, tool)
+    except ImportError as e:  # 準備ができていない
+        print(json.dumps({"type": "fatal", "text": "AI の準備ができていない（%s）。setup_ai.py を実行する" % e},
+                         ensure_ascii=False), flush=True)
+        sys.exit(2)
+    asyncio.run(Bridge(args).main())
+
+
+if __name__ == "__main__":
+    main()
