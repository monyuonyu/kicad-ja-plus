+// ローカル追加: 画面なしで描く(KiCad 9 の RENDER_3D_RAYTRACE_RAM::Redraw から OpenGL 部分を除いた流れ)
+void RENDER_3D_RAYTRACE::HeadlessPrepare( const wxSize& aSize, REPORTER* aStatusReporter,
+                                          REPORTER* aWarningReporter )
+{
+    m_windowSize = aSize;       // SetCurWindowSize は glViewport を呼ぶので使わない
+    m_oldWindowsSize = aSize;
+    m_is_opengl_initialized = true;
+    initializeBlockPositions();
+
+    Reload( aStatusReporter, aWarningReporter, false );
+    m_reloadRequested = false;
+}
+
+
+bool RENDER_3D_RAYTRACE::HeadlessRender( std::vector<unsigned char>& aRGBA, wxSize& aRealSize,
+                                         REPORTER* aStatusReporter )
+{
+    aRGBA.assign( (size_t) m_realBufferSize.x * m_realBufferSize.y * 4, 0 );
+    aRealSize = wxSize( m_realBufferSize.x, m_realBufferSize.y );
+
+    if( aRGBA.empty() )
+        return false;
+
+    m_camera.ParametersChanged();
+    m_renderState = RT_RENDER_STATE_MAX;    // 最初の render() で描画をやり直させる
+
+    if( m_cameraLight )
+        m_cameraLight->SetDirection( -m_camera.GetDir() );
+
+    // render() は呼ばれるたびに少しずつ進むので、仕上げまで呼び続ける
+    for( int guard = 0; guard < 100000; ++guard )
+    {
+        render( aRGBA.data(), aStatusReporter );
+
+        if( m_renderState == RT_RENDER_STATE_FINISH )
+            return true;
+    }
+
+    return false;
+}
